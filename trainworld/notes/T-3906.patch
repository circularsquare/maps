+
+/// T-3906 measurement: a trunk road's bus speed, at most 1.5x the plain bus's street speed at that place.
+fn trunk_bus_kmh(street_car: f64) -> f64 {
+    bus_kmh(CAR_TRUNK_KMH).min(1.5 * bus_kmh(street_car))
 }
 
