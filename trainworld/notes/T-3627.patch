+/// T-3627 (trial, not landed): the local car's money weighs the country's fare weight times this
+/// (A: 1); a negative value anchors it on the US instead (B: `FARE_MIN_PER_USD` x the fare weight
+/// over the US's, so the US car is unchanged); 0 keeps today's `FARE_MIN_PER_USD` everywhere.
+pub const CAR_FARE_RATIO: f32 = 1.0;
+/// app game/income.ts `FARE_W_REF`, `FARE_Y_REF`
+const FARE_W_REF: f32 = 4.4;
+const FARE_Y_REF: f32 = 90_000.0;
+/// `CAR_FARE_RATIO`, or natively `TW_CAR_RATIO` from the environment (the trial's measurements).
+fn car_fare_ratio() -> f32 {
+    #[cfg(not(target_arch = "wasm32"))]
+    if let Some(v) = std::env::var("TW_CAR_RATIO").ok().and_then(|s| s.parse().ok()) {
+        return v;
+    }
+    CAR_FARE_RATIO
+}
+/// game/income.ts `fareWeight` for a country of `gdp` US$ a head; None without a figure.
+pub fn fare_w_of(gdp: Option<f32>) -> Option<f32> {
+    gdp.filter(|&y| y > 0.0).map(|y| FARE_W_REF * (y / FARE_Y_REF).powf(-MONEY_E))
+}
+/// T-3627: perceived minutes a dollar of the car's ownership money where a fare dollar costs `fw`.
+pub fn car_w_of_fw(fw: f32) -> f32 {
+    let r = car_fare_ratio();
+    if !(fw > 0.0) || r == 0.0 {
+        return super::api::FARE_MIN_PER_USD;
+    }
+    if r > 0.0 {
+        return r * fw;
+    }
+    let us = fare_w_of(super::api::country_gdp_usd("US")).unwrap_or(FARE_W_REF);
+    super::api::FARE_MIN_PER_USD * fw / us
+}
+/// The same for a country of `gdp` US$ a head; today's `FARE_MIN_PER_USD` without a figure.
+pub fn car_w_of(gdp: Option<f32>) -> f32 {
+    fare_w_of(gdp).map_or(super::api::FARE_MIN_PER_USD, car_w_of_fw)
+}
