+/// T-4008 PROTOTYPE: rider-km on stretches two lines both run, one with no stop between two
+/// stations (express), the other with stops (local): JSON, the totals and by (express, local) line.
+fn stretches(rn_st: &[u32], rn_line: &[usize], seg: &[f64], line_n: &[u32], hop_km: &[f32]) -> String {
+    use std::collections::{BTreeMap, HashSet};
+    // per line and direction, its route nodes in order
+    let mut runs: Vec<(usize, Vec<usize>)> = vec![];
+    let mut base = 0usize;
+    for (l, &n) in line_n.iter().enumerate() {
+        let n = n as usize;
+        runs.push((l, (base..base + n).collect()));
+        runs.push((l, (base + n..base + 2 * n).collect()));
+        base += 2 * n;
+    }
+    assert_eq!(base, rn_line.len());
+    let at = |r: usize| seg.get(r).copied().unwrap_or(0.0) * hop_km.get(r).copied().unwrap_or(0.0) as f64;
+    let (mut ex_seen, mut lo_seen): (HashSet<usize>, HashSet<usize>) = (HashSet::new(), HashSet::new());
+    let (mut ex, mut lo) = (0f64, 0f64);
+    let mut by: BTreeMap<(usize, usize), [f64; 2]> = BTreeMap::new();
+    for (le, re) in &runs {
+        for w in re.windows(2) {
+            let (a, b) = (rn_st[w[0]], rn_st[w[1]]);
+            for (ll, rl) in &runs {
+                if ll == le {
+                    continue;
+                }
+                let Some(j) = rl.iter().position(|&r| rn_st[r] == a) else { continue };
+                let Some(j2) = rl[j + 1..].iter().position(|&r| rn_st[r] == b).map(|x| x + j + 1) else { continue };
+                if j2 - j < 2 {
+                    continue;
+                }
+                let e = at(w[0]);
+                let l: f64 = rl[j..j2].iter().map(|&r| at(r)).sum();
+                let entry = by.entry((*le, *ll)).or_insert([0.0; 2]);
+                entry[0] += e;
+                entry[1] += l;
+                if ex_seen.insert(w[0]) {
+                    ex += e;
+                }
+                for &r in &rl[j..j2] {
+                    if lo_seen.insert(r) {
+                        lo += at(r);
+                    }
+                }
+            }
+        }
+    }
+    let mut top: Vec<_> = by.into_iter().collect();
+    top.sort_by(|a, b| (b.1[0] + b.1[1]).total_cmp(&(a.1[0] + a.1[1])));
+    let tops: Vec<String> = top.iter().take(14).map(|((e, l), v)| format!("[{e},{l},{:.0},{:.0}]", v[0], v[1])).collect();
+    format!("{{\"express_pkm\":{ex:.0},\"local_pkm\":{lo:.0},\"express_share\":{:.4},\"by_pair\":[{}]}}", ex / (ex + lo).max(1e-9), tops.join(","))
+}
