+//! T-4008 PROTOTYPE, not for landing (notes/T-4008.md): time-value groups in route choice, and
+//! probes of the express/local split.
+//!
+//! - Groups: each group searches its own strategies, with its waits and rides times `k` (a richer
+//!   rider's minutes count more) and fares as today, and the station-pair trips today's mode choice
+//!   gives are assigned share by share on each group's strategies; the crowding rounds see every
+//!   group's riders. A strategy with every minute times `k` is the one with every fare over `k`
+//!   (each cost the search compares is minutes plus fare, and the comparisons are homogeneous), so
+//!   a group's graph is today's with its fares over `k` (`group_graph`). `wait` times a group's
+//!   waits alone (a spread in how riders weigh waiting against riding).
+//! - The probe: for station pairs two or more lines ride between without a change, at different
+//!   numbers of stops, the riders' first boarding on the line with the fewest stops (express) or
+//!   another (local), weighted by the pair's commute trips; and the same split by a
+//!   frequency-weighted logit on the lines' costs from boarding (`soft`).
+//!
+//! Off (no groups, no probe) every call site branches past it, so the figures are today's to the bit.
+
+use super::kernel::{assign, assign_with_transfers, departures, with_group_skims, Graph, Loads, NodeIds, Params, Skims, Strategy, XferIndex};
+use std::cell::RefCell;
+use std::collections::HashMap;
+use std::sync::RwLock;
+
+const NONE: u32 = u32::MAX;
+
+#[cfg(test)]
+#[path = "t4008_tests.rs"]
+mod tests;
+
+#[derive(Clone, Copy, Debug)]
+pub struct Group {
+    pub share: f32,
+    /// minutes (waits and rides) times this
+    pub k: f32,
+    /// waits alone times this, on top of `k`
+    pub wait: f32,
+}
+
+impl Group {
+    pub fn is_today(&self) -> bool {
+        self.k == 1.0 && self.wait == 1.0
+    }
+}
+
+#[derive(Default)]
+struct Cfg {
+    groups: Vec<Group>,
+    probe: bool,
+}
+
+static CFG: RwLock<Cfg> = RwLock::new(Cfg { groups: vec![], probe: false });
+
+/// `share:k[:wait],..`, e.g. `0.2:0.57,0.6:1,0.2:1.72`; empty for none.
+pub fn set_groups(spec: &str) -> Result<(), String> {
+    let mut gs = vec![];
+    for part in spec.split(',').filter(|s| !s.trim().is_empty()) {
+        let v: Vec<f32> = part.split(':').map(|x| x.trim().parse::<f32>().map_err(|e| format!("{part}: {e}"))).collect::<Result<_, _>>()?;
+        if v.len() < 2 {
+            return Err(format!("{part}: share:k[:wait]"));
+        }
+        gs.push(Group { share: v[0], k: v[1], wait: v.get(2).copied().unwrap_or(1.0) });
+    }
+    let sum: f32 = gs.iter().map(|g| g.share).sum();
+    if !gs.is_empty() && (sum - 1.0).abs() > 1e-3 {
+        return Err(format!("shares add up to {sum}"));
+    }
+    CFG.write().unwrap().groups = gs;
+    Ok(())
+}
+
+pub fn set_probe(on: bool) {
+    CFG.write().unwrap().probe = on;
+}
+
+/// The groups, or `None` when off.
+pub fn groups() -> Option<Vec<Group>> {
+    let c = CFG.read().unwrap();
+    if c.groups.is_empty() { None } else { Some(c.groups.clone()) }
+}
+
+pub fn probing() -> bool {
+    CFG.read().unwrap().probe
+}
+
+/// Tables `kernel::with_group_skims` keeps: one per group with its own strategies.
+pub fn keep() -> usize {
+    CFG.read().unwrap().groups.iter().filter(|g| !g.is_today()).count().max(1)
+}
+
+/// The graph a group searches: today's with every fare over `k` (the same strategies as every
+/// minute times `k`), and its waits times `wait`.
+pub fn group_graph(g: &Graph, p: &Params, gr: &Group) -> (Graph, Params) {
+    let mut h = clone_graph(g);
+    let mut q = p.clone();
+    if gr.k != 1.0 {
+        let k = gr.k;
+        for e in 0..h.adj_to.len() {
+            let seg = h.adj_seg[e];
+            if seg != NONE {
+                let r = seg as usize - h.n_st;
+                h.adj_cost[e] = g.adj_cost[e] - g.rn_fare[r] + g.rn_fare[r] / k;
+            }
+        }
+        for f in h.rn_fare.iter_mut() {
+            *f /= k;
+        }
+        h.xfer_fare /= k;
+        h.base_min /= k;
+        // (a change's fixed minutes and the walks stay, so they count times `k` against the fares)
+        q.xfer_fare /= k;
+    }
+    if gr.wait != 1.0 {
+        let w = gr.wait;
+        for v in 0..h.n_st {
+            let change = p.change_at(h.change_f(v));
+            for e in h.adj_off[v] as usize..h.adj_off[v + 1] as usize {
+                if h.adj_to[e] as usize >= h.n_st {
+                    h.adj_cost[e] = change + (g.adj_cost[e] - change) * w;
+                }
+            }
+        }
+        for x in h.st_wait.iter_mut() {
+            *x *= w;
+        }
+        for x in h.rn_left.iter_mut() {
+            *x *= w;
+        }
+    }
+    (h, q)
+}
+
+fn clone_graph(g: &Graph) -> Graph {
+    Graph {
+        n_st: g.n_st,
+        n: g.n,
+        rn_station: g.rn_station.clone(),
+        rn_line: g.rn_line.clone(),
+        rn_ride: g.rn_ride.clone(),
+        rn_fare: g.rn_fare.clone(),
+        rn_tph: g.rn_tph.clone(),
+        rn_left: g.rn_left.clone(),
+        rn_span: g.rn_span.clone(),
+        rn_in: g.rn_in.clone(),
+        rn_out: g.rn_out.clone(),
+        rn_dx: g.rn_dx.clone(),
+        rn_dy: g.rn_dy.clone(),
+        st_spread: g.st_spread.clone(),
+        st_wait: g.st_wait.clone(),
+        st_bld: g.st_bld.clone(),
+        st_walk_off: g.st_walk_off.clone(),
+        st_walk_to: g.st_walk_to.clone(),
+        st_walk_min: g.st_walk_min.clone(),
+        rev_off: g.rev_off.clone(),
+        rev_from: g.rev_from.clone(),
+        rev_edge: g.rev_edge.clone(),
+        adj_off: g.adj_off.clone(),
+        adj_to: g.adj_to.clone(),
+        adj_cost: g.adj_cost.clone(),
+        adj_seg: g.adj_seg.clone(),
+        rn_next: g.rn_next.clone(),
+        fare_curve: g.fare_curve.clone(),
+        rn_km: g.rn_km.clone(),
+        rn_fare_mul: g.rn_fare_mul.clone(),
+        rn_kmw: g.rn_kmw.clone(),
+        rn_base_mul: g.rn_base_mul.clone(),
+        base_min: g.base_min,
+        xfer_fare: g.xfer_fare,
+    }
+}
+
+/// `b` times `w` into `a`.
+pub fn add_loads_w(a: &mut Loads, b: &Loads, w: f32) {
+    for (x, y) in [
+        (&mut a.seg, &b.seg),
+        (&mut a.board, &b.board),
+        (&mut a.alight, &b.alight),
+        (&mut a.rn_board, &b.rn_board),
+        (&mut a.rn_alight, &b.rn_alight),
+        (&mut a.entry, &b.entry),
+        (&mut a.exit, &b.exit),
+        (&mut a.rn_fare_x, &b.rn_fare_x),
+        (&mut a.rn_base_x, &b.rn_base_x),
+    ] {
+        for (p, q) in x.iter_mut().zip(y) {
+            *p += w * q;
+        }
+    }
+    a.pax_min += w as f64 * b.pax_min;
+    a.dropped += w as f64 * b.dropped;
+}
+
+/// The commutes' assignment with groups: the station-pair trips `od` share by share on each group's
+/// strategies (today's on `sk`), the transfers counted into `xfer` the same way.
+#[allow(clippy::too_many_arguments)]
+pub fn assign_groups(g: &Graph, p: &Params, sk: &Skims, od: &[f32], want: &[bool], mut xfer: Option<(&XferIndex, &mut [f32])>, gs: &[Group], q: usize, st_x: &[f32], st_y: &[f32]) -> Loads {
+    let probe_on = probing();
+    let mut total = Loads::zero(g.n_st, g.n - g.n_st);
+    for gr in gs {
+        let odw: Vec<f32> = od.iter().map(|v| v * gr.share).collect();
+        let run = |h: &Graph, hp: &Params, s: &Skims, x: Option<(&XferIndex, &mut [f32])>| -> Loads {
+            if probe_on {
+                probe(h, hp, s, od, gr.share, q, st_x, st_y);
+            }
+            let t = super::clock::now_ms();
+            let l = match x {
+                Some((ix, x)) => assign_with_transfers(h, s, &odw, ix, x),
+                None => assign(h, s, &odw),
+            };
+            add_ms(T_GROUP_ASSIGN, super::clock::now_ms() - t);
+            l
+        };
+        let x = xfer.as_mut().map(|(ix, x)| (*ix, &mut **x));
+        let l = if gr.is_today() {
+            run(g, p, sk, x)
+        } else {
+            let (h, hp) = group_graph(g, p, gr);
+            let t = super::clock::now_ms();
+            with_group_skims(&h, &hp, want, keep(), |s| {
+                add_ms(T_GROUP_SEARCH, super::clock::now_ms() - t);
+                run(&h, &hp, s, x)
+            })
+        };
+        add_loads_w(&mut total, &l, 1.0);
+    }
+    total
+}
+
+// ---------------------------------------------------------------------------------------------
+// stage timers
+
+thread_local! {
+    static MS: RefCell<[f64; 8]> = const { RefCell::new([0.0; 8]) };
+}
+pub const T_GROUP_SEARCH: usize = 0;
+pub const T_GROUP_ASSIGN: usize = 1;
+pub const T_PROBE: usize = 2;
+
+pub fn add_ms(i: usize, ms: f64) {
+    MS.with(|m| m.borrow_mut()[i] += ms);
+}
+pub fn ms() -> [f64; 8] {
+    MS.with(|m| *m.borrow())
+}
+
+// ---------------------------------------------------------------------------------------------
+// the probe
+
+/// Per station pair (o, d): od trips, express, local, other (first boarding shares times trips),
+/// soft express, soft local.
+type PairAcc = HashMap<(u32, u32), [f64; 6]>;
+
+#[derive(Default)]
+struct ProbeState {
+    /// per period: passes seen, the free-flow pass's pairs, the last pass's pairs
+    passes: Vec<usize>,
+    free: Vec<PairAcc>,
+    last: Vec<PairAcc>,
+    /// per period, how many pairs' first boardings differ between groups (any line's share by over 1%)
+    diff: Vec<usize>,
+}
+
+thread_local! {
+    static PROBE: RefCell<ProbeState> = RefCell::new(ProbeState::default());
+}
+
+/// A commute pass of period `q` starts.
+pub fn begin_pass(q: usize) {
+    PROBE.with(|p| {
+        let mut p = p.borrow_mut();
+        if p.passes.len() <= q {
+            p.passes.resize(q + 1, 0);
+            p.free.resize_with(q + 1, HashMap::new);
+            p.last.resize_with(q + 1, HashMap::new);
+            p.diff.resize(q + 1, 0);
+        }
+        p.passes[q] += 1;
+        p.last[q].clear();
+        p.diff[q] = 0;
+    });
+}
+
+/// From route node r riding on: (station, stops ridden, cost from boarding) for each later stop,
+/// the ride's minutes as the graph costs them (crowding and fare included), nobody alighting.
+fn downstream(g: &Graph, r: usize) -> Vec<(u32, u16, f32)> {
+    let s = g.n_st;
+    let mut out = vec![];
+    let (mut x, mut c, mut k) = (r, 0f32, 0u16);
+    let start = r;
+    loop {
+        let nx = g.rn_next[x];
+        if nx == NONE {
+            break;
+        }
+        // the ride edge's cost
+        let e = (g.adj_off[s + x] as usize..g.adj_off[s + x + 1] as usize).find(|&e| g.adj_to[e] == nx).unwrap();
+        c += g.adj_cost[e];
+        k += 1;
+        x = nx as usize - s;
+        if x == start || k > 400 {
+            break;
+        }
+        out.push((g.rn_station[x], k, c));
+    }
+    out
+}
+
+/// One unit of riders from station `o` towards `d` on its strategy: the shares that ride straight to
+/// `d` on each first-boarding route node (the rest change, or walk first).
+fn first_boardings(g: &Graph, st: &Strategy, o: usize, d: usize, dep: &mut Vec<(u32, f32)>) -> Vec<(u32, f32, bool)> {
+    let s = g.n_st;
+    let mut from = o;
+    for &(a, b) in st.start.iter() {
+        if a as usize == o {
+            from = b as usize;
+        }
+    }
+    departures(g, st.board, st.change, from, dep);
+    let sum: f32 = dep.iter().map(|x| x.1).sum();
+    if sum == 0.0 {
+        return vec![];
+    }
+    let next = |v: usize| -> usize {
+        match st.next {
+            NodeIds::Short(n) => {
+                let x = n[v];
+                if x == u16::MAX { NONE as usize } else { x as usize }
+            }
+            NodeIds::Long(n) => n[v] as usize,
+        }
+    };
+    let mut out = vec![];
+    for &(e, a) in dep.iter() {
+        let r = g.adj_to[e as usize] as usize - s;
+        // a boarding rides at least one stop (T-1055)
+        let mut x = g.rn_next[r] as usize;
+        let mut direct = false;
+        for _ in 0..500 {
+            if x == NONE as usize || x < s {
+                break;
+            }
+            let nx = next(x);
+            if nx >= s && nx < g.n {
+                x = nx;
+                continue;
+            }
+            direct = nx == d && g.rn_station[x - s] as usize == d;
+            break;
+        }
+        out.push((r as u32, a / sum, direct));
+    }
+    out
+}
+
+/// Each station's boarding route nodes, each with the stations it rides direct to (`downstream`,
+/// by station).
+pub type Boards = Vec<Vec<(u32, Vec<(u32, u16, f32)>)>>;
+
+pub fn boards(g: &Graph) -> Boards {
+    let s = g.n_st;
+    let mut boards: Boards = vec![vec![]; s];
+    for (v, b) in boards.iter_mut().enumerate() {
+        for e in g.adj_off[v] as usize..g.adj_off[v + 1] as usize {
+            let to = g.adj_to[e] as usize;
+            if to >= s && to < g.n {
+                let r = to - s;
+                if g.rn_tph[r] > 0.0 && g.rn_next[r] != NONE {
+                    let mut ds = downstream(g, r);
+                    ds.sort_by_key(|x| x.0);
+                    ds.dedup_by_key(|x| x.0);
+                    b.push((r as u32, ds));
+                }
+            }
+        }
+    }
+    boards
+}
+
+/// For a pair two or more lines ride direct between at different numbers of stops: the shares of
+/// riders whose first boarding rides direct on a line with the fewest stops (express), on another
+/// (local), and the rest (other), then the direct riders split again by the soft rule (express,
+/// local); `None` for any other pair. `km` the pair's straight length.
+#[allow(clippy::too_many_arguments)]
+pub fn pair_split(g: &Graph, p: &Params, st: &Strategy, from_o: &[(u32, Vec<(u32, u16, f32)>)], o: usize, d: usize, km: f32, dep: &mut Vec<(u32, f32)>) -> Option<[f64; 5]> {
+    // the lines from o riding direct to d: (route node, stops, cost from boarding)
+    let mut direct: Vec<(u32, u16, f32)> = vec![];
+    for (r, ds) in from_o {
+        if let Ok(i) = ds.binary_search_by_key(&(d as u32), |x| x.0) {
+            direct.push((*r, ds[i].1, ds[i].2));
+        }
+    }
+    if direct.len() < 2 {
+        return None;
+    }
+    let fewest = direct.iter().map(|x| x.1).min().unwrap();
+    if direct.iter().all(|x| x.1 == fewest) {
+        return None;
+    }
+    let fb = first_boardings(g, st, o, d, dep);
+    let (mut ex, mut lo, mut other) = (0f64, 0f64, 0f64);
+    for &(r, sh, ok) in &fb {
+        match direct.iter().find(|x| x.0 == r) {
+            Some(x) if ok => {
+                if x.1 == fewest { ex += sh as f64 } else { lo += sh as f64 }
+            }
+            _ => other += sh as f64,
+        }
+    }
+    // the soft split among the direct lines: a rider on the platform takes a line's train if it costs
+    // from boarding no more than waiting for the best line alone (c*: its half headway and its cost
+    // from boarding), as today's rule has it for two lines, and past that with the chance
+    // exp(-theta x the excess), theta T-710's relative scale for the pair's straight length; each
+    // line's riders as its trains an hour times that chance
+    let len = (p.rel_t0 + p.rel_tkm * km).min(p.rel_tmax);
+    let theta = p.rel_gamma / len;
+    let wait = |r: u32| g.st_wait[o] * 30.0 / g.rn_tph[r as usize];
+    let cstar = direct.iter().map(|x| wait(x.0) + x.2).fold(f32::INFINITY, f32::min);
+    let (mut se, mut sl) = (0f64, 0f64);
+    for x in &direct {
+        let v = g.rn_tph[x.0 as usize] as f64 * (-(theta * (x.2 - cstar).max(0.0)) as f64).exp();
+        if x.1 == fewest { se += v } else { sl += v }
+    }
+    let dir = ex + lo;
+    let (se, sl) = if se + sl > 0.0 { (dir * se / (se + sl), dir * sl / (se + sl)) } else { (0.0, 0.0) };
+    Some([ex, lo, other, se, sl])
+}
+
+/// Adds the pairs of `od` (weighted `w`, a group's share) on the strategies of `sk` into period
+/// `q`'s figures; `st_x`, `st_y` the stations' positions (m), for the soft split's scale.
+#[allow(clippy::too_many_arguments)]
+pub fn probe(g: &Graph, p: &Params, sk: &Skims, od: &[f32], w: f32, q: usize, st_x: &[f32], st_y: &[f32]) {
+    let t0 = super::clock::now_ms();
+    let s = g.n_st;
+    let boards = boards(g);
+    let mut dep = vec![];
+    let mut acc: Vec<((u32, u32), [f64; 6])> = vec![];
+    for d in 0..s {
+        let slot = sk.slot[d];
+        if slot == NONE {
+            continue;
+        }
+        let st = sk.strategy(slot as usize);
+        for o in 0..s {
+            if o == d {
+                continue;
+            }
+            let t = od[o * s + d];
+            if t <= 0.0 {
+                continue;
+            }
+            let km = ((st_x[o] - st_x[d]).powi(2) + (st_y[o] - st_y[d]).powi(2)).sqrt() / 1000.0;
+            let Some([ex, lo, other, se, sl]) = pair_split(g, p, &st, &boards[o], o, d, km, &mut dep) else { continue };
+            let tw = (t * w) as f64;
+            acc.push(((o as u32, d as u32), [tw, tw * ex, tw * lo, tw * other, tw * se, tw * sl]));
+        }
+    }
+    PROBE.with(|ps| {
+        let mut ps = ps.borrow_mut();
+        let first = ps.passes.get(q).copied().unwrap_or(1) == 1;
+        let mut diff = 0;
+        {
+            let last = &mut ps.last[q];
+            for (k, v) in &acc {
+                let a = last.entry(*k).or_insert([0.0; 6]);
+                // a group after the first: does its split differ from the groups' so far?
+                if a[0] > 0.0 && v[0] > 0.0 {
+                    let (e0, e1) = (a[1] / a[0], v[1] / v[0]);
+                    if (e0 - e1).abs() > 0.01 {
+                        diff += 1;
+                    }
+                }
+                for i in 0..6 {
+                    a[i] += v[i];
+                }
+            }
+        }
+        ps.diff[q] += diff;
+        if first {
+            let l = ps.last[q].clone();
+            ps.free[q] = l;
+        }
+    });
+    add_ms(T_PROBE, super::clock::now_ms() - t0);
+}
+
+/// Totals over pairs: trips, express, local, other, soft express, soft local, trips on pairs going
+/// at least 99% one way (of their direct riders), pairs, pairs at least 99% one way.
+fn sums(acc: &PairAcc) -> [f64; 10] {
+    let mut t = [0f64; 10];
+    for v in acc.values() {
+        for i in 0..6 {
+            t[i] += v[i];
+        }
+        t[7] += 1.0;
+        let dir = v[1] + v[2];
+        if dir > 0.0 && (v[1] / dir >= 0.99 || v[2] / dir >= 0.99) {
+            t[6] += v[0];
+            t[8] += 1.0;
+        }
+        let sd = v[4] + v[5];
+        if sd > 0.0 && (v[4] / sd >= 0.99 || v[5] / sd >= 0.99) {
+            t[9] += v[0];
+        }
+    }
+    t
+}
+
+/// The probe's figures as JSON: per period free flow and last pass, and the day.
+pub fn report() -> String {
+    PROBE.with(|ps| {
+        let ps = ps.borrow();
+        let fmt = |t: [f64; 10]| {
+            let dir = t[1] + t[2];
+            let sdir = t[4] + t[5];
+            format!(
+                "{{\"trips\":{:.1},\"express\":{:.4},\"local\":{:.4},\"other\":{:.4},\"one_way_trips\":{:.4},\"pairs\":{},\"one_way_pairs\":{:.4},\"soft_express\":{:.4},\"soft_one_way_trips\":{:.4}}}",
+                t[0],
+                t[1] / dir.max(1e-9),
+                t[2] / dir.max(1e-9),
+                t[3] / t[0].max(1e-9),
+                t[6] / t[0].max(1e-9),
+                t[7],
+                t[8] / t[7].max(1e-9),
+                t[4] / sdir.max(1e-9),
+                t[9] / t[0].max(1e-9)
+            )
+        };
+        let add = |a: &mut [f64; 10], b: [f64; 10]| {
+            for i in 0..10 {
+                a[i] += b[i];
+            }
+        };
+        let (mut df, mut dl) = ([0f64; 10], [0f64; 10]);
+        let mut per = vec![];
+        for q in 0..ps.passes.len() {
+            let (f, l) = (sums(&ps.free[q]), sums(&ps.last[q]));
+            add(&mut df, f);
+            add(&mut dl, l);
+            per.push(format!("{{\"q\":{q},\"passes\":{},\"group_diff_pairs\":{},\"free\":{},\"last\":{}}}", ps.passes[q], ps.diff[q], fmt(f), fmt(l)));
+        }
+        format!("{{\"day_free\":{},\"day_last\":{},\"periods\":[{}]}}", fmt(df), fmt(dl), per.join(","))
+    })
+}
