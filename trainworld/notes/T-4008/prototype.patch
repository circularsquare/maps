+//! T-4008 PROTOTYPE: the passing-track test map's line (T-2228's: 180 km of high-speed track, A to G
+//! every 30 km, locals at all seven, expresses at A, D and G, passing tracks at B to F), its run
+//! times from the track model, and the strategies demand finds on it today, with time-value groups,
+//! with a fare premium on the express, and by the soft rule. Route choice only: no population.
+//!
+//!   cargo test --profile agent --features demand --lib t4008 -- --nocapture
+
+use super::*;
+use crate::demand::kernel::{build_graph, set_crowding, skims};
+use crate::demand::network::{Network, PERIODS};
+use crate::track::overtake::tests::{set_passing, shinkansen};
+use crate::track::world::Op;
+
+/// US starting fares: $0.20 a km above the base at 4.4 perceived minutes a dollar, times the
+/// high-speed multiplier 1.25 on both lines
+const PER_KM_MIN: f32 = 0.20 * 4.4 * 1.25;
+
+/// The line with locals every `local_s` and expresses every `express_s`, as demand's network;
+/// and each route node's fare km.
+fn passing_net(local_s: u32, express_s: u32) -> (Network, Vec<f32>, Vec<f32>) {
+    let (mut w, n, local, express) = shinkansen();
+    set_passing(&mut w, &n[1..6], true);
+    for (id, hw) in [(local, local_s), (express, express_s)] {
+        let trains = w.net.line_trains[id as usize];
+        w.apply(Op::AutoTrains { id, auto: Some([hw, hw, 0]), trains }).unwrap();
+    }
+    let lines: [(u32, Vec<u32>, u32); 2] = [(local, (0..7).collect(), local_s), (express, vec![0, 3, 6], express_s)];
+    let mut net = Network {
+        st_x: (0..7).map(|k| k as f32 * 30_000.0).collect(),
+        st_y: vec![0.0; 7],
+        line_name: vec!["Local".into(), "Express".into()],
+        line_off: vec![0],
+        line_stops: vec![],
+        hop_min: vec![],
+        hop_back: vec![],
+        line_speed_kmh: vec![0.0; 2],
+        line_headway_min: lines.iter().map(|l| [l.2 as f32 / 60.0; PERIODS]).collect(),
+        line_seats: vec![1000.0; 2],
+        line_rated: vec![],
+        line_crush: vec![2000.0; 2],
+        st_group: vec![], stop_x: vec![], stop_y: vec![], line_wrap: vec![], span: vec![], st_ups: vec![], st_passage: vec![], catches: vec![], st_bus: vec![], st_tram: vec![], back_stops: vec![], line_pier: vec![], stop_grade: vec![],
+    };
+    let (mut km, mut is_ex) = (vec![], vec![]);
+    for (li, (id, stops, _)) in lines.iter().enumerate() {
+        let ls = &w.svc.lines[*id as usize];
+        let k0 = net.line_stops.len();
+        let m = stops.len();
+        net.line_stops.extend_from_slice(stops);
+        net.line_off.push(net.line_stops.len() as u32);
+        net.hop_min.resize(k0 + m, 0.0);
+        net.hop_back.resize(k0 + m, 0.0);
+        for run in 0..2 {
+            let (arr, dep) = (ls.cumulative(run, 0), &ls.runs[run].prof[0].dep);
+            assert_eq!(arr.len(), m);
+            for j in 0..m - 1 {
+                let dwell = if j == 0 { 0.0 } else { dep[j] - arr[j] };
+                let v = ((arr[j + 1] - dep[j] + dwell) / 60.0) as f32;
+                if run == 0 { net.hop_min[k0 + j] = v } else { net.hop_back[k0 + m - 1 - j] = v }
+            }
+        }
+        // route nodes: forward then back, km to the next stop
+        let step = 30.0 * (stops[1] - stops[0]) as f32;
+        for _dir in 0..2 {
+            for i in 0..m {
+                km.push(if i + 1 < m { step } else { 0.0 });
+                is_ex.push(li == 1);
+            }
+        }
+        eprintln!("{}: every {} min, {:.1} min one way, {:.1} back", net.line_name[li], lines[li].2 / 60, net.hop_min[k0..k0 + m].iter().sum::<f32>(), net.hop_back[k0..k0 + m].iter().sum::<f32>());
+    }
+    let mul: Vec<f32> = is_ex.iter().map(|&e| if e { 1.0 } else { 0.0 }).collect();
+    (net, km, mul)
+}
+
+/// Express share of the direct riders, and the soft rule's, for A-D, D-G, A-G both ways; the share
+/// of B, C -> G and E, F -> A riders changing to the express at D.
+fn splits(net: &Network, km: &[f32], is_ex: &[f32], premium: f32, gr: Option<Group>) -> String {
+    let p = Params { xfer_walk_m: 0.0, train_in_min: 0.0, train_out_min: 0.0, ..Params::default() };
+    let mut g = build_graph(net, &p);
+    for r in 0..g.rn_fare.len() {
+        g.rn_fare[r] = km[r] * PER_KM_MIN * if is_ex[r] > 0.0 { premium } else { 1.0 };
+    }
+    let ones = vec![1.0; g.rn_fare.len()];
+    set_crowding(&mut g, &ones);
+    let (g, p) = match gr { Some(gr) => group_graph(&g, &p, &gr), None => (g, p) };
+    let sk = skims(&g, &p);
+    let b = boards(&g);
+    let mut dep = vec![];
+    let mut out = vec![];
+    for (o, d) in [(0, 3), (3, 6), (0, 6), (3, 0), (6, 3), (6, 0)] {
+        let st = sk.strategy(sk.slot[d] as usize);
+        let km = 30.0 * (o as f32 - d as f32).abs();
+        let x = pair_split(&g, &p, &st, &b[o], o, d, km, &mut dep).unwrap();
+        out.push(format!("{}{} {:.0}% (soft {:.0}%)", "ABCDEFG".as_bytes()[o] as char, "ABCDEFG".as_bytes()[d] as char, 100.0 * x[0] / (x[0] + x[1]), 100.0 * x[3] / (x[3] + x[4])));
+    }
+    let mut ch = vec![];
+    for (o, d) in [(1, 6), (2, 6), (5, 0), (4, 0)] {
+        let st = sk.strategy(sk.slot[d] as usize);
+        let fb = first_boardings(&g, &st, o, d, &mut dep);
+        let direct: f32 = fb.iter().filter(|x| x.2).map(|x| x.1).sum();
+        ch.push(format!("{}{} {:.0}%", "ABCDEFG".as_bytes()[o] as char, "ABCDEFG".as_bytes()[d] as char, 100.0 * (1.0 - direct)));
+    }
+    format!("express {} | change to the express at D: {}", out.join(", "), ch.join(", "))
+}
