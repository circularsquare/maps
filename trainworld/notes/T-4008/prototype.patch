+// T-4008 PROTOTYPE: the time-value groups' own strategies (`demand::t4008`), in a cache of their
+// own so a group's search can run while `SKIM_CACHE` lends today's; `keep` tables, oldest first out.
+thread_local! {
+    static GROUP_CACHE: std::cell::RefCell<Vec<(SkimKey, Skims)>> = const { std::cell::RefCell::new(Vec::new()) };
+}
+
+pub fn with_group_skims<R>(g: &Graph, p: &Params, want: &[bool], keep: usize, f: impl FnOnce(&Skims) -> R) -> R {
+    GROUP_CACHE.with(|c| {
+        let mut c = c.borrow_mut();
+        match c.iter().position(|(k, _)| k.same(g, p)) {
+            Some(i) => {
+                let e = c.remove(i);
+                c.push(e);
+            }
+            None => {
+                while c.len() >= keep.max(1) {
+                    c.remove(0);
+                }
+                c.push((SkimKey::of(g, p), Skims::empty(g)));
+            }
+        }
+        let sk = &mut c.last_mut().unwrap().1;
+        skims_extend(sk, g, p, want);
+        f(sk)
+    })
+}
+
+pub fn clear_group_skims() {
+    GROUP_CACHE.with(|c| c.borrow_mut().clear());
+}
