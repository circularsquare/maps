+/// T-2642 (scratch): a longer pair's trips spread by end station, each entry's adds in the order
+/// the spread by start station makes them, so the same to the bit.
+#[allow(clippy::too_many_arguments)]
+pub(super) fn spread_pair(terms: &[(u32, u32, f64)], b: &[(usize, f32)], r_all: f64, sum: f64, _ends: &mut Vec<usize>, lane: &mut Vec<(u32, u32, f32)>, ws: &[u32], odc: &mut [Box<[f32]>], st: &mut [f32], cur: &mut [u32], pat: &StPattern, ca: usize, cb: usize, nz: usize) {
+    let nb = b.len();
+    assert!(nb <= ACCESS_MAX && terms.len() <= ACCESS_MAX * ACCESS_MAX);
+    let mut jj = [0u8; ACCESS_MAX * ACCESS_MAX];
+    let mut off = [0usize; ACCESS_MAX + 1];
+    let mut jb = 0;
+    for (t, &(_, sb, _)) in terms.iter().enumerate() {
+        while b[jb].0 != sb as usize {
+            jb = (jb + 1) % nb;
+        }
+        jj[t] = jb as u8;
+        off[jb + 1] += 1;
+    }
+    for j in 0..nb {
+        off[j + 1] += off[j];
+    }
+    let mut fill = off;
+    lane.clear();
+    lane.resize(terms.len(), (0, 0, 0.));
+    let (mut last_sa, mut ia) = (u32::MAX, 0usize);
+    for (t, &(sa, _, v)) in terms.iter().enumerate() {
+        if sa != last_sa {
+            last_sa = sa;
+            let x = sa as usize;
+            ia = pat.at(x, cb, &mut cur[2 * x + (cb >= nz) as usize]);
+        }
+        let j = jj[t] as usize;
+        lane[fill[j]] = (sa, ia as u32, (r_all * v / sum) as f32);
+        fill[j] += 1;
+    }
+    for j in 0..nb {
+        if off[j] == off[j + 1] {
+            continue;
+        }
+        let sb = b[j].0;
+        let e = pat.at(sb, ca, &mut cur[2 * sb + (ca >= nz) as usize]);
+        let col = &mut odc[ws[sb] as usize];
+        for &(sa, ia, rr) in &lane[off[j]..off[j + 1]] {
+            col[sa as usize] += rr;
+            st[ia as usize] += rr;
+            st[e] += rr;
+        }
+    }
+}
