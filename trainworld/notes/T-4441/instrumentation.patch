diff --git a/trainworld/sim/src/track/ph.rs b/trainworld/sim/src/track/ph.rs
new file mode 100644
index 000000000..c4040804f
--- /dev/null
+++ b/trainworld/sim/src/track/ph.rs
@@ -0,0 +1,75 @@
+//! T-4441 measuring only (never lands): phase timers for the train work after a click, read through
+//! `TrackApi::take_phases`. Each name sums its time and counts its calls since the last take; a name met
+//! while the weekend settle runs (`set_weekend`) is kept apart, marked "we:".
+
+use std::cell::{Cell, RefCell};
+
+thread_local! {
+    static PH: RefCell<Vec<(&'static str, bool, f64, u32)>> = const { RefCell::new(Vec::new()) };
+    static WEEKEND: Cell<bool> = const { Cell::new(false) };
+}
+
+#[cfg(not(target_arch = "wasm32"))]
+pub fn now() -> f64 {
+    use std::sync::OnceLock;
+    use std::time::Instant;
+    static T0: OnceLock<Instant> = OnceLock::new();
+    T0.get_or_init(Instant::now).elapsed().as_secs_f64() * 1000.0
+}
+
+#[cfg(target_arch = "wasm32")]
+mod js {
+    use wasm_bindgen::prelude::*;
+    #[wasm_bindgen]
+    extern "C" {
+        #[wasm_bindgen(js_namespace = performance, js_name = now)]
+        pub fn ph_now() -> f64;
+    }
+}
+
+#[cfg(target_arch = "wasm32")]
+pub fn now() -> f64 {
+    js::ph_now()
+}
+
+/// Adds the time since `t0` to `name`.
+pub fn add(name: &'static str, t0: f64) {
+    put(name, now() - t0, 1);
+}
+
+/// Adds the time since `*tk` to `name` and restarts `*tk`.
+pub fn lap(name: &'static str, tk: &mut f64) {
+    let t = now();
+    put(name, t - *tk, 1);
+    *tk = now();
+}
+
+/// Adds `n` to `name`'s count with no time (a size: lines, rounds).
+pub fn count(name: &'static str, n: usize) {
+    put(name, 0.0, n as u32);
+}
+
+fn put(name: &'static str, d: f64, n: u32) {
+    let w = WEEKEND.with(|w| w.get());
+    PH.with(|p| {
+        let mut p = p.borrow_mut();
+        if let Some(e) = p.iter_mut().find(|e| e.0 == name && e.1 == w) {
+            e.2 += d;
+            e.3 += n;
+        } else {
+            p.push((name, w, d, n));
+        }
+    });
+}
+
+pub fn set_weekend(on: bool) {
+    WEEKEND.with(|w| w.set(on));
+}
+
+/// `name=ms*calls;...` since the last take, emptied.
+pub fn take() -> String {
+    PH.with(|p| {
+        let v = std::mem::take(&mut *p.borrow_mut());
+        v.iter().map(|(k, w, d, n)| format!("{}{k}={d:.3}*{n}", if *w { "we:" } else { "" })).collect::<Vec<_>>().join(";")
+    })
+}
