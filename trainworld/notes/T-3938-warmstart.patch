+    assert_eq!(figures(&api), free);
+    let run = |api: &mut DemandApi, rounds: usize| -> Vec<Vec<f32>> {
+        assert!(api.solve_warm(0, &loads, rounds));
+        let mut out = vec![api.seg(0)];
+        for r in 1..=3 {
+            assert!(api.crowd(0));
+            assert_eq!(api.summary(0)[0], r as f64);
+            out.push(api.seg(0));
+        }
+        out
+    };
+    let none = run(&mut api, 0);
+    assert!(none.iter().all(|s| *s == none[0]), "no round runs");
+    let one = run(&mut api, 1);
+    assert_eq!(one[0], none[0], "the warm pass is the same whatever the rounds");
+    assert_ne!(one[1], one[0], "the round given runs");
+    assert!(one[2] == one[1] && one[3] == one[1], "the rounds after it do not");
+    clear_skim_cache();
+}
