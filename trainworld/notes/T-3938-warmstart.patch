+/// T-3938: `DemandApi`'s `a_warm_solve_runs_only_its_rounds`, for the everyday layer.
+#[test]
+fn a_warm_solve_runs_only_its_rounds() {
+    let (h, b) = fixture(4000.0);
+    let mut a = EverydayApi::new(&h, &b).unwrap();
+    network(&mut a, 4000.0, [12.0; 3]);
+    let figures = |a: &EverydayApi| (a.summary(0)[1..4].to_vec(), a.seg(0), a.board(0), a.alight(0));
+    assert!(a.solve(0));
+    let free = figures(&a);
+    let zero = vec![0.0; a.seg(0).len()];
+    assert!(a.solve_warm(0, &zero, 3));
+    assert_eq!(figures(&a), free);
+    let crowded: Vec<f32> = a.seg(0).iter().map(|v| v * 100000.0).collect();
+    // each round priced on other loads than the one before, so none settles of itself
+    let run = |a: &mut EverydayApi, rounds: usize| -> Vec<f64> {
+        assert!(a.solve_warm(0, &crowded, rounds));
+        let mut out = vec![a.summary(0)[2]];
+        for (r, t) in [&zero, &crowded, &zero].into_iter().enumerate() {
+            assert!(a.crowd_with_external(0, t));
+            assert_eq!(a.summary(0)[0], (r + 1) as f64);
+            out.push(a.summary(0)[2]);
+        }
+        out
+    };
+    let none = run(&mut a, 0);
+    assert!(none.iter().all(|&x| x == none[0]), "no round runs: {none:?}");
+    let one = run(&mut a, 1);
+    assert!(one[1] > one[0], "the round given runs, uncrowded: {one:?}");
+    assert!(one[2] == one[1] && one[3] == one[1], "the rounds after it do not: {one:?}");
+    let three = run(&mut a, 3);
+    assert_ne!(three[2], three[1], "with more rounds given they run: {three:?}");
+}
