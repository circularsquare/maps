+fn a_warm_solve_runs_only_its_rounds() {
+    let (mut api, xy, n, stops, times, tph, cars) = small();
+    api.set_network(&xy, &n, &stops, &times, &tph, &cars).unwrap();
+    let figures = |api: &DemandApi| {
+        let mut s = api.summary(0);
+        s[4] = 0.0; // ms
+        (s, api.seg(0), api.board(0), api.alight(0), api.sub_sums())
