+/// T-4504: on a real save, every plan's `best` at each level's rates (as `outcome` reads them) against the one it
+/// replaced, to the bit, so every figure that reads a plan is unchanged. On request, on the save's track bytes
+/// (gunzipped, after its JSON header): `T4504_TRACK=<file> cargo test --profile agent best_on_a_real_save -- --ignored --nocapture`.
+#[test]
+#[ignore]
+fn best_on_a_real_save() {
+    use super::super::{save, world::TrackWorld};
+    let w = TrackWorld::new(save::decode(&std::fs::read(std::env::var("T4504_TRACK").unwrap()).unwrap()).unwrap());
+    let cap = &w.svc.cap;
+    let (mut plans, mut calls, mut waits) = (0, 0, 0);
+    for r in 0..cap.res.len() {
+        for plan in cap.plans_of(r) {
+            plans += 1;
+            for lev in w.net.slots().collect::<Vec<_>>() {
+                let (tf, ts) = (pattern_tph(&w.net, plan.fast.0, lev) as f64, pattern_tph(&w.net, plan.slow.0, lev) as f64);
+                let hc = plan.headway_cap(&w.net);
+                assert!(same_best(plan, tf, ts, hc), "line {} behind {} at level {lev}", plan.fast.0, plan.slow.0);
+                waits += plan.best(tf, ts, hc).waits.iter().any(|&x| x > 0.0) as usize;
+                calls += 1;
+            }
+        }
+    }
+    eprintln!("lines {}, resources {}, plans {plans}, {calls} level outcomes the same to the bit, {waits} with a slower train waiting", w.net.line_count(), cap.res.len());
+}
