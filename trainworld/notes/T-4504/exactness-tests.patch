+/// A stretch of random shape: `n` points, either run stopping or passing at each, the slower one stepping
+/// aside at some of its stops, the faster run sometimes slower over a hop.
+fn random_plan(r: &mut impl FnMut() -> f64, n: usize) -> Plan {
+    let (mut s, mut f) = (0.0f64, 0.0f64);
+    let mut points = vec![];
+    for k in 0..n {
+        let hop = 60.0 + 600.0 * r();
+        s += hop * (1.05 + 0.6 * r());
+        f += hop * (0.6 + 0.6 * r());
+        let last = k + 1 == n;
+        let (ss, fs) = if last { (false, false) } else { (r() < 0.8, r() < 0.3) };
+        let slow = [s, if ss { s + 20.0 + 60.0 * r() } else { s }];
+        let fast = [f, if fs { f + 20.0 + 40.0 * r() } else { f }];
+        (s, f) = (slow[1], fast[1]);
+        points.push(Point { slow, fast, passing: ss && r() < 0.5, stop: if ss { k as i32 } else { -1 }, node: k as u32, at: s, fat: f });
+    }
+    if !points[..n - 1].iter().any(|p| p.passing) {
+        points[0].passing = true;
+    }
+    let next = (0..n).map(|p| (p + 1..n).find(|&q| points[q].passing).unwrap_or(n - 1)).collect();
+    let spacing = 40.0 + 200.0 * r();
+    Plan { fast: (0, 0), slow: (1, 0), start: [60.0 * r(), if r() < 0.5 { 0.0 } else { 40.0 * r() }], at: [0.0, 0.0], points, next, spacing, memo: Mutex::new(vec![]) }
+}
