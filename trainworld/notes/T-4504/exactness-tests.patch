+/// T-4504: `Plan::best` as it was before its sweep kept its trains in flat lists, kept to check the new one against.
+fn sweep_before(plan: &Plan, hs: f64, hf: f64, x: f64, c: f64) -> (Outcome, Vec<Vec<f64>>) {
+    struct Train {
+        slow: bool,
+        t0: f64,
+        arr: f64,
+        dep: f64,
+        measured: bool,
+        wait: Vec<f64>,
+    }
+    {
+        let n = plan.points.len();
+        let warm = plan.points[n - 1].slow[0] + 2.0 * hs.max(hf);
+        let mut tr: Vec<Train> = vec![];
+        for (slow, h, x0, stand) in [(true, hs, 0.0, plan.start[0]), (false, hf, x, plan.start[1])] {
+            let first = ((-warm - x0) / h).floor() as i64;
+            let last = ((c + warm - x0) / h).ceil() as i64;
+            for i in first..last {
+                let t0 = x0 + i as f64 * h;
+                tr.push(Train { slow, t0, arr: t0, dep: t0 + stand, measured: i >= 0 && (i as f64) * h < c - 1e-6, wait: if slow { vec![0.0; n] } else { vec![] } });
+            }
+        }
+        let mut order: Vec<usize> = (0..tr.len()).collect();
+        let mut fast: Vec<f64> = vec![];
+        let (mut prev_s, mut prev_f) = (plan.start[0], plan.start[1]);
+        for p in 0..n {
+            let pt = plan.points[p];
+            order.sort_by(|&a, &b| tr[a].dep.total_cmp(&tr[b].dep).then(tr[b].slow.cmp(&tr[a].slow)).then(tr[a].t0.total_cmp(&tr[b].t0)));
+            let mut ahead: Option<(f64, bool)> = None;
+            for &i in &order {
+                let t = &mut tr[i];
+                let (free, stand) = if t.slow { (t.dep + pt.slow[0] - prev_s, pt.slow[1] - pt.slow[0]) } else { (t.dep + pt.fast[0] - prev_f, pt.fast[1] - pt.fast[0]) };
+                let arr = match ahead {
+                    Some((a, slow)) => free.max(a + if slow && !t.slow && pt.passing { PASS_CLEAR_S } else { plan.spacing }),
+                    None => free,
+                };
+                t.arr = arr;
+                t.dep = arr + stand;
+                ahead = Some((arr, t.slow));
+            }
+            if pt.passing {
+                let (b, q) = (plan.points[plan.next[p]], plan.points[p + 1]);
+                let (run_s, run_f) = (b.slow[0] - pt.slow[1], b.fast[0] - pt.fast[1]);
+                let lead = PASS_CLEAR_S.max(q.fast[0] - pt.fast[1] + plan.spacing - (q.slow[0] - pt.slow[1]));
+                fast.clear();
+                fast.extend(tr.iter().filter(|t| !t.slow).map(|t| t.dep));
+                fast.sort_by(f64::total_cmp);
+                for t in tr.iter_mut().filter(|t| t.slow) {
+                    let normal = t.dep;
+                    for &xa in &fast {
+                        if xa + lead <= t.dep {
+                            continue;
+                        }
+                        if xa + run_f >= t.dep + run_s + plan.spacing || xa + lead - normal > (hs - plan.spacing).min(hf + lead) {
+                            break;
+                        }
+                        t.dep = xa + lead;
+                    }
+                    t.wait[p] = t.dep - normal;
+                }
+            }
+            (prev_s, prev_f) = (pt.slow[1], pt.fast[1]);
+        }
+        let (end, end_s) = (plan.points[n - 1].fast[0], plan.points[n - 1].slow[0]);
+        let (mut loss, mut nf) = (0.0f64, 0.0f64);
+        let (mut waits, mut ns, mut behind) = (vec![0.0f64; n], 0.0f64, 0.0f64);
+        let mut each = vec![];
+        for t in tr.iter().filter(|t| t.measured) {
+            if t.slow {
+                ns += 1.0;
+                waits.iter_mut().zip(&t.wait).for_each(|(a, w)| *a += w);
+                behind += t.arr - t.t0 - end_s - t.wait.iter().sum::<f64>();
+                each.push(t.wait.clone());
+            } else {
+                nf += 1.0;
+                loss += t.arr - t.t0 - end;
+            }
+        }
+        waits.iter_mut().for_each(|w| *w /= ns.max(1.0));
+        (Outcome { loss: loss / nf.max(1.0), waits, behind: behind / ns.max(1.0), offset: x, costs: vec![], slow: vec![], hf }, each)
+    }
+}
+
+fn best_before(plan: &Plan, tf: f64, ts: f64, cap: f64) -> Outcome {
+    let sweep = |hs, hf, x, c| sweep_before(plan, hs, hf, x, c);
+    let n = plan.points.len();
+    if !(tf > 0.0 && ts > 0.0) {
+        return Outcome { loss: 0.0, waits: vec![0.0; n], behind: 0.0, offset: 0.0, costs: vec![], slow: vec![], hf: 0.0 };
+    }
+    let (hf, hs) = ((3600.0 / tf).min(cap), (3600.0 / ts).min(cap));
+    let c = cycle(hs, hf);
+    let mut best: Option<(f64, Outcome)> = None;
+    let (mut costs, mut slow) = (vec![], vec![]);
+    for k in 0..PHASES {
+        let (o, each) = sweep(hs, hf, hf * k as f64 / PHASES as f64, c);
+        let held = o.waits.iter().sum::<f64>() + o.behind;
+        let cost = o.loss * tf + held * ts;
+        costs.push(cost);
+        slow.push(each.iter().map(|w| w.iter().sum::<f64>()).fold(0.0, f64::max) + o.behind);
+        if best.as_ref().map_or(true, |b| cost < b.0 - 1e-9) {
+            best = Some((cost, o));
+        }
+    }
+    Outcome { costs, slow, hf, ..best.unwrap().1 }
+}
+
+/// Every figure of an outcome, as bits.
+pub(crate) fn outcome_bits(o: &Outcome) -> Vec<u64> {
+    [o.loss, o.behind, o.offset, o.hf].iter().chain(&o.waits).chain(&o.costs).chain(&o.slow).map(|x| x.to_bits()).chain([o.waits.len() as u64, o.costs.len() as u64]).collect()
+}
+
+/// `best` of `plan` at these rates and cap (s) against the one it replaced, to the bit.
+pub(crate) fn same_best(plan: &Plan, tf: f64, ts: f64, cap: f64) -> bool {
+    outcome_bits(&plan.best(tf, ts, cap)) == outcome_bits(&best_before(plan, tf, ts, cap))
+}
