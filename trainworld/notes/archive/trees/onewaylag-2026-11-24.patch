+/// T-4045: while held, `find_path_side` keeps its answers, so a sweep that tries many stops and
+/// slots (`stop_tiers`, `insert_stop`) searches each hop once. Hold it only over reads of one
+/// unchanged network; the answers are dropped when the last guard goes.
+pub struct SearchMemo;
+
+impl SearchMemo {
+    pub fn hold() -> Self {
+        SEARCHES.with(|m| {
+            let mut m = m.borrow_mut();
+            m.depth += 1;
+            m.cache.get_or_insert_with(Default::default);
+        });
+        SearchMemo
+    }
+}
+
+impl Drop for SearchMemo {
+    fn drop(&mut self) {
+        SEARCHES.with(|m| {
+            let mut m = m.borrow_mut();
+            m.depth -= 1;
+            if m.depth == 0 {
+                m.cache = None;
+            }
+        });
+    }
+}
