+/// What the app reads of a line ending at the station, or starting there, on both twins: no read fails on a run that
+/// starts or ends inside a piece, and those holding no piece ids agree.
+#[test]
+fn t4036_reads_of_a_line_ending_at_anchor_as_split() {
+    for (single, curved) in COMBOS {
+        let what = format!("single {single} curved {curved}");
+        let (split, cut, _, m) = twins(single, curved);
+        let mut reads: Vec<Vec<String>> = vec![];
+        for w in [split, cut] {
+            let (b0, a, d) = (at(&w, -3000.0, 0.0), at(&w, 0.0, 0.0), at(&w, 9000.0, 0.0));
+            let mut api = api_of(w);
+            let mut out = vec![];
+            for stops in [vec![b0, a, m], vec![m, d]] {
+                let id = api.world_mut().net.alloc_line();
+                assert_eq!(api.set_line_with_trains(id, &stops, 4, 2, 1, 30.0, 180.0, 0, 0, format!("T{id}")), 0, "{what}");
+                // read for no failure only: these name pieces, which the split renumbers
+                let _ = (api.line_path(id), api.line_run_path(id), api.line_back_path(id), api.line_part(id), api.lines_info(), api.nodes_info());
+                out.push(format!("{:?}", (api.line_run_stops(id), api.line_back_stops(id), api.line_fwd_stops(id), api.line_path_tracks(id), api.line_back_tracks(id))));
+                out.push(format!("{:?}", (api.passed_stations(id), api.stop_tiers(id), api.line_reversals(id), api.line_stop_ways(id), api.line_end_turns(id), api.line_loop(id))));
+                for run in 0..2 {
+                    let t: Vec<String> = (0..12).map(|k| format!("{:.6?}", api.train_at(id, run, 0, 0.0, k as f64 * 60.0))).collect();
+                    out.push(t.join(" "));
+                }
+            }
+            reads.push(out);
+        }
+        // trains at the same places to a millimetre on straight track (a curved split is fitted again)
+        if !curved {
+            assert_eq!(reads[0], reads[1], "{what}");
+        } else {
+            assert_eq!(reads[0].len(), reads[1].len(), "{what}");
+            for k in [0, 1, 4, 5] {
+                assert_eq!(reads[0][k], reads[1][k], "{what}");
+            }
+        }
+    }
+}
