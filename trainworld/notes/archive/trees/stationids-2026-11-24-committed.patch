@@ -0,0 +1,394 @@
+//! T-4031 (track rework stage a, notes/T-4030.md): a piece's tracks as records of their own, held on the piece
+//! (`EdgeData::tracks`, `Network::edge_recs`) and read by the compile (`compile.rs`) instead of being laid out from a
+//! track count. Each track has a key that names it within its piece (kept by splits, joins and undo; a load gives
+//! each its slot), its way, its partner and a join at each end. Slots run from the left looking from a to b, as
+//! TWT7 writes them (01-model "slot").
+//!
+//! A piece holds 1 to 16 tracks, each with a way of its own or the default (single track's from `ways.rs`, a
+//! bundle's A B A B by the running side, `compile::default_way`). Line paths name a track by its key (`net::entry`,
+//! T-4033). Partners follow 01-model's bracket rule (`repair`). Left and right joins are single track's (T-3137); a
+//! track end of any piece may be loose (`Join::Loose`).
+
+use super::compile::{default_way, WAY_AB, WAY_BA};
+
+/// The most tracks a piece holds (01-model "Bundle").
+pub const MAX_TRACKS: usize = 16;
+
+/// What a track end meets at its node.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Default)]
+pub enum Join {
+    /// Every track end across the node whose way fits (today's rule for an unjoined end; old saves rely on it).
+    #[default]
+    Auto,
+    /// Single track only (T-3137): the track of the double across to the left, looking out from the node along this
+    /// piece. Feeds the way rule (`ways.rs`) and the drawing (`drawn.rs`); moves stay `Auto`'s until stage c.
+    Left,
+    /// The same, the track to the right.
+    Right,
+    /// Connects to nothing across its node: no move through the node starts or ends on it there (her 11-21 call for
+    /// an added track, loose at both ends until connected manually). The node's turn moves (a station's, a bare
+    /// end's to its partner) are kept: they stand for turnbacks no track is drawn for yet (stage 8), and the route
+    /// search tests a turn at its first stop by side alone. That search also leaves a stop by any end without asking
+    /// for a move from the arriving track, so an edit making an end loose at a station must check its lines itself
+    /// (notes/T-4031.md).
+    Loose,
+}
+
+impl Join {
+    /// The file's code (TWT7): 0 auto, 1 left, 2 right, 3 loose.
+    pub fn code(self) -> u8 {
+        match self {
+            Join::Auto => 0,
+            Join::Left => 1,
+            Join::Right => 2,
+            Join::Loose => 3,
+        }
+    }
+
+    pub fn of_code(c: u8) -> Option<Join> {
+        Some(match c {
+            0 => Join::Auto,
+            1 => Join::Left,
+            2 => Join::Right,
+            3 => Join::Loose,
+            _ => return None,
+        })
+    }
+
+    /// Left or right of the double across (single track's join), else none.
+    pub fn side(self) -> Option<Side> {
+        match self {
+            Join::Left => Some(Side::Left),
+            Join::Right => Some(Side::Right),
+            _ => None,
+        }
+    }
+
+    pub fn of_side(s: Side) -> Join {
+        match s {
+            Side::Left => Join::Left,
+            Side::Right => Join::Right,
+        }
+    }
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Side {
+    Left,
+    Right,
+}
+
+/// One track of a piece.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct TrackRec {
+    /// Names the track within its piece, unique there.
+    pub key: u8,
+    /// The player's way on single track (T-3094): 0 not set (the way its run takes by itself, `Network::edge_way`), 1 a
+    /// to b, 2 b to a, 3 both. On a bundle every track 0 (by the running side, `default_way`) or every track its own
+    /// (`repair`; T-4038 sets one track's way, `set_slot_way`).
+    pub way: u8,
+    /// The key of the track a return run takes (01-model "Partner"): on a double the other track. None on single
+    /// track, where the compile pairs a two-way track with itself from its way, which may still be inferred.
+    pub partner: Option<u8>,
+    /// At end a and end b.
+    pub join: [Join; 2],
+}
+
+/// A piece's tracks in slot order.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Tracks(Vec<TrackRec>);
+
+impl Default for Tracks {
+    fn default() -> Self {
+        Tracks::new(2)
+    }
+}
+
+impl Tracks {
+    /// `n` tracks (1 to 16) with the defaults: keys in slot order, every way unset and every join `Auto`, partners
+    /// as `default_way` lays the ways (doubles side by side from the right, an odd leftmost track its own).
+    pub fn new(n: u8) -> Tracks {
+        let odd = n % 2;
+        let partner = |k: u8| match n {
+            1 => None,
+            _ if odd == 1 && k == 0 => Some(0),
+            _ => Some(((k - odd) ^ 1) + odd),
+        };
+        Tracks((0..n).map(|k| TrackRec { key: k, way: 0, partner: partner(k), join: [Join::Auto; 2] }).collect())
+    }
+
+    /// Each slot's way (`WAY_*`) on a piece of two or more tracks: its record's, else `default_way`'s. Single track's
+    /// way needs the network (`Network::slot_ways`).
+    pub fn ways(&self, right_hand: bool) -> Vec<u8> {
+        let n = self.0.len();
+        self.0.iter().enumerate().map(|(s, t)| if t.way != 0 { t.way } else { default_way(n, s, right_hand) }).collect()
+    }
+
+    /// Ways and partners as the model holds them, run whenever tracks are laid or ways change (`set_edge`). A bundle's
+    /// ways are all left to the running side where they are its defaults, else all its own. Partners by 01-model's
+    /// rule (05-sim section 6): a two-way track is
+    /// its own; pairs still running opposite ways are kept; a pair left running the same way loses its partners;
+    /// then the unpaired one-way tracks pair in slot order, each with the nearest unpaired track before it running
+    /// the other way (a bracket match: A B A B pairs 0-1 and 2-3, A A B B 1-2 and 0-3, A B B A 0-1 and 2-3, A B A
+    /// leaves slot 2 unpaired). Single track holds none (the compile pairs it from its way).
+    pub fn repair(&mut self, right_hand: bool) {
+        let n = self.0.len();
+        if n < 2 {
+            if let Some(t) = self.0.first_mut() {
+                t.partner = None;
+            }
+            return;
+        }
+        let ways = self.ways(right_hand);
+        // a bundle's ways are either all the running side's (0, turned by the running-side flip) or all its own
+        let by_side = (0..n).all(|s| ways[s] == default_way(n, s, right_hand));
+        for (t, &w) in self.0.iter_mut().zip(&ways) {
+            t.way = if by_side { 0 } else { w };
+        }
+        let both = WAY_AB | WAY_BA;
+        let slot = |k: u8| self.0.iter().position(|t| t.key == k);
+        let mut pair: Vec<Option<usize>> = vec![None; n];
+        for s in 0..n {
+            if ways[s] == both {
+                pair[s] = Some(s);
+            } else if let Some(o) = self.0[s].partner.and_then(slot) {
+                if o != s && ways[o] != both && ways[o] != ways[s] && self.0[o].partner == Some(self.0[s].key) {
+                    pair[s] = Some(o);
+                }
+            }
+        }
+        for s in 0..n {
+            if pair[s].is_none() {
+                if let Some(o) = (0..s).rev().find(|&o| pair[o].is_none() && ways[o] != both && ways[o] != ways[s]) {
+                    pair[s] = Some(o);
+                    pair[o] = Some(s);
+                }
+            }
+        }
+        for s in 0..n {
+            self.0[s].partner = pair[s].map(|o| self.0[o].key);
+        }
+    }
+
+    /// Whether some way has more than one track on this piece (more than one track runs a to b, or b to a). Never on
+    /// a piece of one or two tracks with default ways.
+    pub fn shares_a_way(&self, right_hand: bool) -> bool {
+        if self.0.len() < 2 {
+            return false;
+        }
+        let ways = self.ways(right_hand);
+        [WAY_AB, WAY_BA].iter().any(|&w| ways.iter().filter(|&&x| x & w != 0).count() > 1)
+    }
+
+    /// Whether a piece of two or more tracks runs ways of its own (any record way set; `repair` leaves them all 0
+    /// where they are the running side's). Such a piece is drawn track by track, its lines and trains each on the
+    /// track its path names (T-4038), since keeping to a side would put them on the wrong track.
+    pub fn own_ways(&self) -> bool {
+        self.0.len() >= 2 && self.0.iter().any(|t| t.way != 0)
+    }
+
+    /// Track `slot`'s way set to `way` (`TrackRec::way`; 0 its default) on a piece of two or more tracks, the other
+    /// tracks keeping theirs: every record takes its way as laid, then `repair` (run by `set_edge`) gives them all
+    /// back to the running side where they are its defaults.
+    pub fn set_slot_way(&mut self, slot: usize, way: u8, right_hand: bool) {
+        let n = self.0.len();
+        if n < 2 {
+            return;
+        }
+        let ways = self.ways(right_hand);
+        for (t, &w) in self.0.iter_mut().zip(&ways) {
+            t.way = w;
+        }
+        if let Some(t) = self.0.get_mut(slot) {
+            t.way = if way == 0 { default_way(n, slot, right_hand) } else { way };
+        }
+    }
+
+    /// Single track running `way` (`TrackRec::way`) with joins `join`.
+    pub fn single(way: u8, join: [Join; 2]) -> Tracks {
+        Tracks(vec![TrackRec { key: 0, way, partner: None, join }])
+    }
+
+    pub fn from_recs(recs: Vec<TrackRec>) -> Tracks {
+        Tracks(recs)
+    }
+
+    pub fn n(&self) -> u8 {
+        self.0.len() as u8
+    }
+
+    pub fn recs(&self) -> &[TrackRec] {
+        &self.0
+    }
+
+    pub fn recs_mut(&mut self) -> &mut [TrackRec] {
+        &mut self.0
+    }
+
+    /// The slot of the track keyed `key`.
+    pub fn slot_of(&self, key: u8) -> Option<u8> {
+        self.0.iter().position(|t| t.key == key).map(|s| s as u8)
+    }
+
+    /// Single track's way (`TrackRec::way`), 0 on any other count.
+    pub fn single_way(&self) -> u8 {
+        match &self.0[..] {
+            [t] => t.way,
+            _ => 0,
+        }
+    }
+
+    /// Single track's join at end `end` (0 a, 1 b), `Auto` on any other count.
+    pub fn single_join(&self, end: usize) -> Join {
+        match &self.0[..] {
+            [t] => t.join[end],
+            _ => Join::Auto,
+        }
+    }
+
+    /// Sets single track's way; nothing on any other count.
+    pub fn set_way(&mut self, way: u8) {
+        if let [t] = &mut self.0[..] {
+            t.way = way;
+        }
+    }
+
+    /// Sets single track's join at `end`; nothing on any other count.
+    pub fn set_join(&mut self, end: usize, j: Join) {
+        if let [t] = &mut self.0[..] {
+            t.join[end] = j;
+        }
+    }
+
+    /// Whether any track end at `end` connects to nothing.
+    pub fn loose_at(&self, end: usize) -> bool {
+        self.0.iter().any(|t| t.join[end] == Join::Loose)
+    }
+
+    /// The same tracks with every join at `end` back to `Auto`: a piece split in two, whose halves meet at a new
+    /// plain node there, where slot i carries on as slot i.
+    pub fn cleared_at(&self, end: usize) -> Tracks {
+        let mut t = self.clone();
+        for r in &mut t.0 {
+            r.join[end] = Join::Auto;
+        }
+        t
+    }
+
+    /// The same tracks seen from the other end (a piece walked b to a, as `unjoin_near` joins one): slots reversed,
+    /// ways turned, joins' ends swapped (a join is seen looking out from its node, so its side stays), keys and partners
+    /// kept.
+    pub fn reversed(&self) -> Tracks {
+        Tracks(
+            self.0
+                .iter()
+                .rev()
+                .map(|t| TrackRec { way: if matches!(t.way, 1 | 2) { 3 - t.way } else { t.way }, join: [t.join[1], t.join[0]], ..*t })
+                .collect(),
+        )
+    }
+
+    /// The track keyed `key` left alone as single track running `way` (T-3956's delete one track): its key and its
+    /// joins kept, no partner.
+    pub fn keep_one(&self, key: u8, way: u8) -> Option<Tracks> {
+        let t = self.0.iter().find(|t| t.key == key)?;
+        Some(Tracks(vec![TrackRec { way, partner: None, ..*t }]))
+    }
+
+    /// A piece's tracks the model can hold: 1 to 16, keys under 16 and unique, ways 0 to 3; single track with no
+    /// stored partner; on more tracks each partner its own track or one naming it back, and joins only `Auto` or
+    /// `Loose` (left and right are single track's).
+    pub fn valid(&self) -> bool {
+        let n = self.0.len();
+        if n == 0 || n > MAX_TRACKS || self.0.iter().any(|t| t.key as usize >= MAX_TRACKS || t.way > 3) {
+            return false;
+        }
+        if (0..n).any(|i| (0..i).any(|j| self.0[i].key == self.0[j].key)) {
+            return false;
+        }
+        if n == 1 {
+            return self.0[0].partner.is_none();
+        }
+        self.0.iter().all(|t| {
+            t.join.iter().all(|j| matches!(j, Join::Auto | Join::Loose))
+                && t.partner.map_or(true, |k| k == t.key || self.0.iter().any(|o| o.key == k && o.partner == Some(t.key)))
+        })
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn reversed_turns_ways_and_swaps_join_ends() {
+        let s = Tracks::single(1, [Join::Left, Join::Loose]);
+        let r = s.reversed();
+        assert_eq!(r.recs()[0].way, 2);
+        assert_eq!(r.recs()[0].join, [Join::Loose, Join::Left]);
+        assert_eq!(r.reversed(), s);
+        let mut d = Tracks::new(2);
+        d.recs_mut()[1].join[0] = Join::Loose;
+        let r = d.reversed();
+        assert_eq!(r.recs().iter().map(|t| t.key).collect::<Vec<_>>(), [1, 0]);
+        assert_eq!(r.recs()[0].join, [Join::Auto, Join::Loose]);
+        assert!(r.valid());
+    }
+
+    #[test]
+    fn what_the_model_holds() {
+        assert!((1..=16).all(|n| Tracks::new(n).valid()) && !Tracks::new(17).valid());
+        let mut d = Tracks::new(2);
+        d.recs_mut()[0].join[1] = Join::Left;
+        assert!(!d.valid(), "left and right are single track's joins");
+        let mut d = Tracks::new(2);
+        d.recs_mut()[0].way = 1;
+        assert!(d.valid(), "a double's track may have a way of its own (T-4033)");
+        let mut d = Tracks::new(4);
+        d.recs_mut()[1].partner = Some(3);
+        assert!(!d.valid(), "a partner names its track back");
+        assert!(!Tracks::from_recs(vec![]).valid());
+        assert_eq!(Tracks::new(2).keep_one(1, 2).unwrap().recs()[0], TrackRec { key: 1, way: 2, partner: None, join: [Join::Auto; 2] });
+    }
+
+    /// T-4033 (01-model "Partner"): the bracket rule pairs A B A B 0-1 and 2-3, A A B B 1-2 and 0-3, A B B A 0-1 and
+    /// 2-3; A B A leaves its last unpaired; a two-way track is its own; a pair left running the same way is broken.
+    #[test]
+    fn t4033_partners_by_the_bracket_rule() {
+        let laid = |ways: &[u8]| {
+            let mut t = Tracks::new(ways.len() as u8);
+            for (r, &w) in t.recs_mut().iter_mut().zip(ways) {
+                (r.way, r.partner) = (w, None);
+            }
+            t.repair(true);
+            assert!(t.valid());
+            t.recs().iter().map(|r| r.partner).collect::<Vec<_>>()
+        };
+        let (a, b) = (WAY_AB, WAY_BA);
+        assert_eq!(laid(&[a, b, a, b]), [Some(1), Some(0), Some(3), Some(2)]);
+        assert_eq!(laid(&[a, a, b, b]), [Some(3), Some(2), Some(1), Some(0)]);
+        assert_eq!(laid(&[a, b, b, a]), [Some(1), Some(0), Some(3), Some(2)]);
+        assert_eq!(laid(&[a, b, a]), [Some(1), Some(0), None]);
+        assert_eq!(laid(&[3, a, b]), [Some(0), Some(2), Some(1)]);
+        assert_eq!(laid(&[a, a]), [None, None], "one track of a double flipped: no pair");
+        // the defaults, by the running side, keep today's pairs
+        for rh in [true, false] {
+            let mut t = Tracks::new(2);
+            t.repair(rh);
+            assert_eq!(t, Tracks::new(2));
+            let mut t = Tracks::new(5);
+            t.repair(rh);
+            assert_eq!(t, Tracks::new(5));
+        }
+        // a pair kept while it still runs opposite ways, though the bracket rule alone would pair otherwise
+        let mut t = Tracks::new(4);
+        for (r, w) in t.recs_mut().iter_mut().zip([a, b, a, b]) {
+            r.way = w;
+        }
+        for (r, p) in t.recs_mut().iter_mut().zip([3, 2, 1, 0]) {
+            r.partner = Some(p);
+        }
+        t.repair(true);
+        assert_eq!(t.recs().iter().map(|r| r.partner).collect::<Vec<_>>(), [Some(3), Some(2), Some(1), Some(0)]);
+    }
+}
