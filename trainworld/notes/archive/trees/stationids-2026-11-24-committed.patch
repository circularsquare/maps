@@ -0,0 +1,48 @@
+// T-3956: the selection bar's track picture (notes/T-3444-design/03-tools.md "The second click"): one short stroke per
+// track of the place picked, red where trains head east (north on north-south track), blue the other way, grey both
+// ways, the picked ones bold. A click on a stroke picks that one track; on the one picked, the whole place again.
+
+import { t } from "../i18n";
+import { bpPicked, onlyOneKind, pickedTracks, pickPlace, selectPicked } from "../game/blueprintPick";
+import { boundOf, isPicked, placeTracks, type PlaceTrack } from "../game/oneTrack";
+import { tool } from "../game/ui";
+import { world } from "../game/world";
+
+const W = 36, STEP = 8, PAD = 4;
+
+export function TrackPicture() {
+  const p = bpPicked.value, w = world.value;
+  const place = pickPlace(p);
+  if (!w || !place) return null;
+  const tracks = placeTracks(w, place);
+  if (tracks.length < 2) return null;
+  const picked = pickedTracks(p);
+  const row = (id: number) => w.edges.find((e) => e.id === id)!;
+  const colour = (tr: PlaceTrack) => {
+    if (tr.dir === null) return "var(--none-grey)";
+    const b = boundOf(w, row(tr.edge), tr.dir);
+    return b === "east" || b === "north" ? "var(--dl-high)" : "var(--dl-low)";
+  };
+  const label = (tr: PlaceTrack) => t("trackInspector.oneTrack", { bound: tr.dir === null ? "both" : boundOf(w, row(tr.edge), tr.dir) });
+  const pickTrack = (tr: PlaceTrack) => {
+    const again = !!picked && picked.length === 1 && isPicked(tr, picked, []);
+    bpPicked.value = onlyOneKind(again ? { edges: place, stations: [] } : { edges: [tr.edge], stations: [], ...(tr.slot !== null ? { tracks: [{ edge: tr.edge, slot: tr.slot }] } : {}) });
+    if (tool.peek() === "select") selectPicked();
+  };
+  const h = PAD * 2 + STEP * (tracks.length - 1);
+  return (
+    <span class="track-picture" role="group" aria-label={t("trackPicture.label")}>
+      <svg width={W} height={h} viewBox={`0 0 ${W} ${h}`}>
+        {tracks.map((tr, i) => {
+          const y = PAD + STEP * i, on = isPicked(tr, picked, p.edges);
+          return (
+            <g key={`${tr.edge}:${tr.slot}`} class="tp-track" onClick={() => pickTrack(tr)} role="button" aria-label={label(tr)} aria-pressed={on}>
+              <rect x={0} y={y - STEP / 2} width={W} height={STEP} fill="transparent" stroke="none" />
+              <line x1={2} x2={W - 2} y1={y} y2={y} stroke={colour(tr)} stroke-width={on ? 4 : 2} stroke-linecap="round" opacity={on ? 1 : 0.55} />
+            </g>
+          );
+        })}
+      </svg>
+    </span>
+  );
+}
