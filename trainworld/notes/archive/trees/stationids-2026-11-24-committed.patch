+/// At a line's end on double track every train has the one stop point, so the line shows on the track it arrives
+/// on and the one it leaves by.
+#[test]
+fn end_station_on_double_track() {
+    let (mut a, [s0, mid, s1]) = run_at(2, 0.0, [0.0, 4000.0, 8000.0]);
+    assert_eq!(a.w.net.node_ports[s1 as usize].n, 1, "a track end");
+    let l = line(&mut a, &[s0, mid, s1]);
+    let (_, g) = picture(&a, s1);
+    assert_eq!(g[0].2.len(), 2);
+    assert!(g[0].2.iter().all(|r| r.1 >= 0.0 && r.2 == vec![l]), "{g:?}");
+}
+
+/// Single track: a passing loop is two rows, one each way; without it one two-way row.
+#[test]
+fn single_track_station() {
+    let (mut a, [s0, mid, s1]) = run(1);
+    let l = line(&mut a, &[s0, mid, s1]);
+    let (_, g) = picture(&a, mid);
+    let rows = &g[0].2;
+    assert_eq!(rows.iter().map(|r| r.0).collect::<Vec<_>>(), vec![2, 1], "{rows:?}");
+    assert!(rows.iter().all(|r| r.1 >= 0.0 && r.2 == vec![l]), "{rows:?}");
+    assert_eq!(a.set_station_tracks(mid, true), 0, "{}", a.issue_kinds());
+    let (_, g) = picture(&a, mid);
+    assert_eq!(g[0].2.len(), 1);
+    assert_eq!((g[0].2[0].0, g[0].2[0].2.clone()), (3, vec![l]));
+    assert!(g[0].2[0].1 >= 0.0);
+}
