+/// A new line ending at the station, and one starting there the other way, made as the Lines tab makes them.
+#[test]
+fn t4036_terminus_at_anchor_as_split() {
+    for (single, curved) in COMBOS {
+        let what = format!("single {single} curved {curved}");
+        let (split, cut, e, m) = twins(single, curved);
+        let mut out = vec![];
+        for w in [split, cut] {
+            let (b0, a, d) = (at(&w, -3000.0, 0.0), at(&w, 0.0, 0.0), at(&w, 9000.0, 0.0));
+            let mut api = api_of(w);
+            for stops in [vec![b0, a, m], vec![m, d]] {
+                let id = api.world_mut().net.alloc_line();
+                assert_eq!(api.set_line_with_trains(id, &stops, 4, 2, 1, 30.0, 180.0, 0, 0, format!("T{id}")), 0, "{what}: {}", api.issue_text());
+                assert_eq!(api.world_mut().net.line_stops(id), &stops[..], "{what}");
+                assert!(!api.world_mut().net.line_broken[id as usize], "{what}");
+            }
+            api.world_mut().reload();
+            out.push(api.into_world());
+        }
+        let cut = out.pop().unwrap();
+        let split = out.pop().unwrap();
+        let rel = if curved { 2e-5 } else { 1e-12 };
+        same(&what, &split, &cut, e, m, rel);
+        // the lines end there: each run of both stands at the station's platform, and turns there
+        let ends = |w: &TrackWorld| (3..5).all(|l| w.svc.lines[l].runs.iter().all(|r| r.nodes.first() == Some(&m) || r.nodes.last() == Some(&m)));
+        assert!(ends(&cut) && ends(&split), "{what}");
+        for k in [ResKind::Platform, ResKind::Terminus] {
+            assert!(at_node(&cut, k, m) >= 1, "{what}: {k:?}");
+            assert_eq!(at_node(&cut, k, m), at_node(&split, k, m), "{what}: {k:?}");
+        }
+        // the runs start and end at the anchor, not at the piece's ends
+        let run = &cut.svc.lines[3].runs[0];
+        assert_eq!(run.nodes.last(), Some(&m), "{what}");
+        assert!((run.len - split.svc.lines[3].runs[0].len).abs() < 1e-3, "{what}");
+    }
+}
