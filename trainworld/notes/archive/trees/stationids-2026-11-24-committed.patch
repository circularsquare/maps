+/// A0 - B - J and a loop J - K - J (stop_pass_tests' barbell), B to J one piece 3 km long, stations at A0, B and K.
+fn barbell() -> TrackWorld {
+    let mut w = world();
+    let a0 = node(&mut w, -4000.0, 0.0, 0);
+    let b = node(&mut w, -2000.0, 0.0, 0);
+    let j = node(&mut w, 1000.0, 0.0, 0);
+    let k = node(&mut w, 2000.0, 750.0, 0);
+    edge(&mut w, a0, b, &[], 0).unwrap();
+    edge(&mut w, b, j, &[], 0).unwrap();
+    edge(&mut w, j, k, &[(1200.0, 0.0)], 0).unwrap();
+    edge(&mut w, k, j, &[(2800.0, 1500.0), (3500.0, -750.0), (1400.0, 0.0)], 0).unwrap();
+    for n in [a0, b, k] {
+        station(&mut w, n, 200);
+    }
+    super::super::super::tests::terminals_at_dead_ends(&mut w);
+    w
+}
