+/// A piece's PIs and drawn-through points, in every body.
+fn pis_out(w: &mut W, net: &Network, d: &EdgeData) {
+    w.u(d.pis.len() as u64);
+    let (mut px, mut py) = (net.node_x[d.a as usize], net.node_y[d.a as usize]);
+    for p in &d.pis {
+        w.mm(p.x - px);
+        w.mm(p.y - py);
+        (px, py) = (p.x, p.y);
+        w.u((p.radius / QUANT).round() as u64);
+        w.i(p.level as i64);
+    }
+    if !d.thru.is_empty() {
+        w.u(d.thru.len() as u64);
+        let (mut px, mut py) = (net.node_x[d.a as usize], net.node_y[d.a as usize]);
+        for p in &d.thru {
+            w.mm(p.x - px);
+            w.mm(p.y - py);
+            (px, py) = (p.x, p.y);
+            w.i(p.level as i64);
+        }
+    }
+}
