+/// Twins of the world `make` builds, on its piece `e` at chainage `s`: split there with a station at the new node, or
+/// whole with an anchor station there (as `twins`).
+fn twins_of(make: fn() -> TrackWorld, e: u32, s: f64) -> (TrackWorld, TrackWorld, u32) {
+    let mut split = make();
+    let (nd, _, _) = split.net.split_plan(e, s).unwrap();
+    let (m, new_edge) = (split.net.alloc_node(), split.net.alloc_edge());
+    split.apply(Op::Split { edge: e, s, node: m, new_edge }).unwrap();
+    station(&mut split, m, 200);
+    split.reload();
+    let mut cut = make();
+    assert_eq!(cut.net.alloc_node(), m);
+    cut.apply(Op::Node { id: m, data: Some(nd.clone()) }).unwrap();
+    let at = cut.net.project(e, nd.x, nd.y).0;
+    let keys: Vec<u8> = cut.net.edge_recs[e as usize].recs().iter().map(|r| r.key).collect();
+    anchor(&mut cut, m, e, at, &keys, 200).unwrap();
+    cut.reload();
+    (split, cut, m)
+}
