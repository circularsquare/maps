+/// TWT7's body up to its lines (`body`). A field this build has no record for yet (a node's joins, a line set, a
+/// track's purpose or offset profile, ways or partners other than its piece's own, more than two tracks) is counted
+/// as unread, so the game refuses the save as newer rather than lose it.
+/// `path_out`'s path. A slot the piece has no track in counts as unread. Without slots (body level 1, TWT4-6) an
+/// entry runs on the first track of its piece that runs its way (`Network::entry_for`).
+fn path_in(r: &mut R, net: &mut Network, n_edges: usize, dead_edge: &mut Option<u32>, spans: bool, unknown: &mut usize) -> Result<Vec<u32>, String> {
+    let mut path = vec![];
+    let mut prev = 0i64;
+    for _ in 0..r.u()? {
+        let v = r.i()?;
+        prev += v >> 1;
+        let e = prev as u32;
+        let live = (e as usize) < n_edges;
+        let e = if live { e } else { *dead_edge.get_or_insert_with(|| net.alloc_edge()) };
+        let dir = (v & 1) as u32;
+        let p = if spans {
+            let slot = r.u()?.checked_sub(1);
+            let n = if live { net.edge_recs[e as usize].n() as u64 } else { 0 };
+            if slot.map_or(live, |s| s >= n) {
+                *unknown += 1;
+            }
+            net.span_entry(super::compile::TrackSpan { piece: e, slot: slot.filter(|&s| s < n).map(|s| s as u8), dir: dir as u8 })
+        } else {
+            net.entry_for(e, dir)
+        };
+        path.push(p);
+    }
+    Ok(path)
+}
