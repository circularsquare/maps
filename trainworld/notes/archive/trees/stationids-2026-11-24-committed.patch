index 000000000..2c96eb4f9
--- /dev/null
+++ b/trainworld/sim/src/track/derived.rs
@@ -0,0 +1,334 @@
+//! The derived edges runs read (T-4030 stage b, notes/T-4032.md; design 05-sim.md section 1): one track between
+//! derived nodes, a window of its piece's chainage. `Run::segs`, the capacity keys, stretches and the run-side
+//! geometry are in these terms (`DEntry`), so a track cut inside its piece (01-model's derived stop node, stage e) runs
+//! as the same piece split at a node would.
+//!
+//! **Identity.** A track's first part keeps the track's `TrackId` as its id, so while nothing is cut (every save and
+//! game today) the derived edges are the tracks, their ids today's capacity keys, and every reader takes the whole
+//! piece exactly as before. Extra parts take ids from `EXTRA_BASE` up (a free list), above every track id, so a track
+//! block handed out later never meets one; `d_slot` packs both ranges into one index for per-key tables.
+//!
+//! Anchors make the cuts (T-4035, `recut`): a station off the track, its node with no ports (as ferry ports and BRT
+//! stations are) at its platforms' middle, cuts every track of its piece there, so a run passes it in `Run::nodes` and
+//! stops there on a track with a platform. No junction move or turn stands at a cut (`d_inner_to`); a platform does.
+
+use super::compile::{TrackId, WAY_AB, WAY_BA};
+use super::net::{path_dir, path_edge, Network};
+use super::service::Run;
+
+/// The first id of extra parts (a track cut inside its piece).
+pub const EXTRA_BASE: u32 = 1 << 29;
+
+/// A run's path entry on a derived edge: the edge and the direction along its piece (0 a to b), as a newtype so no
+/// piece-entry arithmetic (`>> 1`, `^ 1`) can reach it. `Network::d_pentry` maps it back to its piece's entry.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord, Hash, Default)]
+pub struct DEntry(u32);
+
+impl DEntry {
+    fn new(edge: u32, dir: u32) -> DEntry {
+        DEntry(edge << 1 | dir)
+    }
+    /// The derived edge's id: a section's capacity key.
+    pub fn edge(self) -> u32 {
+        self.0 >> 1
+    }
+    /// The direction along its piece: 0 a to b.
+    pub fn dir(self) -> u32 {
+        self.0 & 1
+    }
+}
+
+/// One part of a cut track: its window of the piece's chainage, the nodes at its two ends (`u32::MAX`: the piece's
+/// own end), and the part after it along the piece.
+#[derive(Clone, Copy, Debug, PartialEq)]
+struct Part {
+    track: TrackId,
+    piece: u32,
+    s0: f64,
+    s1: f64,
+    a: u32,
+    b: u32,
+    next: u32,
+}
+
+/// The derived edges apart from the tracks (`Network::dedges`): only cut tracks hold anything.
+#[derive(Clone, Debug, Default)]
+pub struct DerivedEdges {
+    /// Per track id: its first part where it is cut, else None (the whole track).
+    first: Vec<Option<Part>>,
+    /// Extra parts by id - `EXTRA_BASE`; a dead one has `piece` `u32::MAX`.
+    extra: Vec<Part>,
+    free: Vec<u32>,
+    /// Where pieces are cut: (piece, chainage, the cut's node), sorted.
+    cuts: Vec<(u32, f64, u32)>,
+}
+
+impl Network {
+    fn part(&self, d: u32) -> Option<&Part> {
+        if d >= EXTRA_BASE {
+            self.dedges.extra.get((d - EXTRA_BASE) as usize)
+        } else {
+            self.dedges.first.get(d as usize).and_then(|p| p.as_ref())
+        }
+    }
+
+    /// Piece `e`'s derived edges again, after the compile laid its tracks (`derive`).
+    pub(super) fn derive_parts(&mut self, e: u32) {
+        if self.dedges.cuts.is_empty() && self.dedges.extra.is_empty() {
+            return;
+        }
+        // each track's extra ids as they were, so a piece derived again (an edit, its undo) keeps them in order
+        let mut old: Vec<(TrackId, Vec<u32>)> = vec![];
+        for (t, p) in self.dedges.first.iter().enumerate().filter_map(|(t, p)| p.filter(|x| x.piece == e).map(|x| (t, x))) {
+            let ids = std::iter::successors(Some(p.next), |&d| self.part(d).map(|x| x.next)).take_while(|&d| d != u32::MAX).collect();
+            old.push((TrackId(t as u32), ids));
+        }
+        let dd = &mut self.dedges;
+        for p in dd.first.iter_mut().filter(|p| p.is_some_and(|x| x.piece == e)) {
+            *p = None;
+        }
+        let mut freed = vec![];
+        for (k, p) in dd.extra.iter_mut().enumerate().filter(|(_, p)| p.piece == e) {
+            p.piece = u32::MAX;
+            freed.push(EXTRA_BASE + k as u32);
+        }
+        let cuts: Vec<(f64, u32)> = dd.cuts.iter().filter(|c| c.0 == e).map(|c| (c.1, c.2)).collect();
+        let tracks: Vec<TrackId> = if cuts.is_empty() || !self.edge_ok(e) { vec![] } else { self.piece_tracks(e).collect() };
+        let dd = &mut self.dedges;
+        for &t in &tracks {
+            if dd.first.len() <= t.0 as usize {
+                dd.first.resize(t.0 as usize + 1, None);
+            }
+            // parts in chainage order: the track's own id first, then its old extra ids, then free ones
+            let mut reuse = old.iter().find(|o| o.0 == t).map_or(vec![], |o| o.1.clone());
+            reuse.reverse();
+            let mut ids = vec![t.0];
+            for _ in &cuts {
+                let id = match reuse.pop() {
+                    Some(id) => {
+                        freed.retain(|&f| f != id);
+                        id
+                    }
+                    None => dd.free.pop().unwrap_or_else(|| {
+                        dd.extra.push(Part { track: t, piece: u32::MAX, s0: 0.0, s1: 0.0, a: 0, b: 0, next: u32::MAX });
+                        EXTRA_BASE + dd.extra.len() as u32 - 1
+                    }),
+                };
+                ids.push(id);
+            }
+            for (k, &id) in ids.iter().enumerate() {
+                let part = Part {
+                    track: t,
+                    piece: e,
+                    s0: if k == 0 { 0.0 } else { cuts[k - 1].0 },
+                    s1: cuts.get(k).map_or(f64::INFINITY, |c| c.0),
+                    a: if k == 0 { u32::MAX } else { cuts[k - 1].1 },
+                    b: cuts.get(k).map_or(u32::MAX, |c| c.1),
+                    next: ids.get(k + 1).copied().unwrap_or(u32::MAX),
+                };
+                if id >= EXTRA_BASE {
+                    dd.extra[(id - EXTRA_BASE) as usize] = part;
+                } else {
+                    dd.first[id as usize] = Some(part);
+                }
+            }
+        }
+        dd.free.extend(freed);
+    }
+
+    /// T-4035: stations `ss`' cuts made again from their records (an anchor cuts every track of its piece at its
+    /// platforms' middle, `anchor_of`); the pieces whose cuts that changes, for `derive_parts`. `ss` sorted.
+    pub(super) fn recut(&mut self, ss: &[u32]) -> Vec<u32> {
+        let add: Vec<(u32, f64, u32)> = ss.iter().filter_map(|&s| self.anchor_of(s).map(|(e, mid)| (e, mid, s))).collect();
+        if add.is_empty() && self.dedges.cuts.is_empty() {
+            return vec![];
+        }
+        let mut pieces: Vec<u32> = add.iter().map(|c| c.0).collect();
+        let cuts = &mut self.dedges.cuts;
+        cuts.retain(|c| {
+            let gone = ss.binary_search(&c.2).is_ok();
+            if gone {
+                pieces.push(c.0);
+            }
+            !gone
+        });
+        cuts.extend(add);
+        cuts.sort_by(|a, b| a.0.cmp(&b.0).then(a.1.total_cmp(&b.1)).then(a.2.cmp(&b.2)));
+        pieces.sort_unstable();
+        pieces.dedup();
+        pieces
+    }
+
+    /// No anchor cuts any piece.
+    pub fn dedges_empty(&self) -> bool {
+        self.dedges.cuts.is_empty()
+    }
+
+    /// The anchors cutting piece `e` (`recut`), in chainage order.
+    pub fn anchors_on(&self, e: u32) -> impl Iterator<Item = u32> + '_ {
+        let i = self.dedges.cuts.partition_point(|c| c.0 < e);
+        self.dedges.cuts[i..].iter().take_while(move |c| c.0 == e).map(|c| c.2)
+    }
+
+    // ---- derived edges
+
+    /// The track derived edge `d` is part of.
+    pub fn d_track(&self, d: u32) -> TrackId {
+        self.part(d).map_or(TrackId(d), |p| p.track)
+    }
+
+    /// The piece derived edge `d` lies on.
+    pub fn d_piece(&self, d: u32) -> u32 {
+        self.track(self.d_track(d)).piece
+    }
+
+    /// Derived edge `d`'s track runs one way: trains on it hold it in that direction only.
+    pub fn d_directed(&self, d: u32) -> bool {
+        self.track(self.d_track(d)).way != WAY_AB | WAY_BA
+    }
+
+    /// An index for derived edge `d` in tables of `d_slots` (extra parts after the track ids).
+    pub fn d_slot(&self, d: u32) -> usize {
+        if d >= EXTRA_BASE { self.track_id_count() + (d - EXTRA_BASE) as usize } else { d as usize }
+    }
+
+    pub fn d_slots(&self) -> usize {
+        self.track_id_count() + self.dedges.extra.len()
+    }
+
+    /// The derived edges of piece `e`, each track's parts in turn: what an edit of the piece makes go.
+    pub fn d_of_piece(&self, e: u32) -> impl Iterator<Item = u32> + '_ {
+        self.piece_tracks(e).flat_map(move |t| std::iter::successors(Some(t.0), move |&d| self.part(d).map(|p| p.next).filter(|&n| n != u32::MAX)))
+    }
+
+    // ---- entries
+
+    /// The path entry (`net::entry`: piece, track key, dir) derived entry `x` runs along.
+    pub fn d_pentry(&self, x: DEntry) -> u32 {
+        self.track_entry(self.d_track(x.edge()), x.dir())
+    }
+
+    /// The derived entries piece entry `p` runs over in order, appended to `out`: its track's parts (one while the
+    /// track is whole). An entry no track runs its way takes its piece's first track, as capacity's keys always did.
+    pub fn d_entries(&self, p: u32, out: &mut Vec<DEntry>) {
+        let dir = path_dir(p);
+        let Some(t) = self.track_of(p).or_else(|| self.piece_tracks(path_edge(p)).next()) else { return };
+        let from = out.len();
+        let mut d = t.0;
+        while d != u32::MAX {
+            out.push(DEntry::new(d, dir));
+            d = self.part(d).map_or(u32::MAX, |x| x.next);
+        }
+        if dir == 1 {
+            out[from..].reverse();
+        }
+    }
+
+    /// The derived entry for piece entry `p` where its track is whole; None where it is cut (or no track runs it).
+    pub fn d_entry_whole(&self, p: u32) -> Option<DEntry> {
+        let t = self.track_of(p).or_else(|| self.piece_tracks(path_edge(p)).next())?;
+        self.part(t.0).is_none().then(|| DEntry::new(t.0, path_dir(p)))
+    }
+
+    /// Derived edge `d`'s window of its piece's chainage, m, and whether it is the whole piece.
+    pub fn d_window(&self, d: u32) -> (f64, f64, bool) {
+        match self.part(d) {
+            None => (0.0, self.edge_len[self.d_piece(d) as usize], true),
+            Some(p) => (p.s0, p.s1.min(self.edge_len[p.piece as usize]), false),
+        }
+    }
+
+    /// Entry `x`'s length, m.
+    pub fn d_len(&self, x: DEntry) -> f64 {
+        match self.d_window(x.edge()) {
+            (_, len, true) => len,
+            (a, b, false) => b - a,
+        }
+    }
+
+    /// The nodes entry `x` runs from and to.
+    pub fn d_nodes(&self, x: DEntry) -> (u32, u32) {
+        let (a, b) = self.path_nodes(self.d_pentry(x));
+        let Some(p) = self.part(x.edge()) else { return (a, b) };
+        // (a, b) are the piece's ends in travel order; a part's own ends replace them where it is cut
+        let (pa, pb) = if x.dir() == 0 { (p.a, p.b) } else { (p.b, p.a) };
+        (if pa == u32::MAX { a } else { pa }, if pb == u32::MAX { b } else { pb })
+    }
+
+    /// Entry `x` arrives at a cut inside its piece, not at the piece's end: trains run straight on into the next
+    /// part; only an anchor's platform stands there.
+    pub fn d_inner_to(&self, x: DEntry) -> bool {
+        self.part(x.edge()).is_some_and(|p| if x.dir() == 0 { p.b != u32::MAX } else { p.a != u32::MAX })
+    }
+
+    /// The chainage of piece position `s` as an offset along entry `x` from where it starts, where `x`'s window
+    /// holds it (from its start, up to but not including its end unless it reaches the piece's end).
+    pub fn d_along(&self, x: DEntry, s: f64) -> Option<f64> {
+        let (a, b, whole) = self.d_window(x.edge());
+        let len = self.edge_len[self.d_piece(x.edge()) as usize];
+        if whole {
+            return Some(if x.dir() == 0 { s } else { len - s });
+        }
+        let inside = s >= a && (s < b || (b >= len && s <= b));
+        inside.then(|| if x.dir() == 0 { s - a } else { b - s })
+    }
+
+    /// The piece chainage (from its a end) `off` metres along entry `x` from where it starts.
+    pub fn d_piece_s(&self, x: DEntry, off: f64) -> f64 {
+        let (a, b, whole) = self.d_window(x.edge());
+        match (whole, x.dir()) {
+            (true, 0) => off,
+            (true, _) => b - off,
+            (false, 0) => a + off,
+            (false, _) => b - off,
+        }
+    }
+
+    /// A run turns back from `x` into `y` at their node (`turns_back` on their pieces); never at a cut.
+    pub fn d_turns_back(&self, x: DEntry, y: DEntry) -> bool {
+        !self.d_inner_to(x) && self.turns_back(self.d_pentry(x), self.d_pentry(y))
+    }
+
+    /// The crossing rule's positions of the move from `x` into `y` at node `n` (`move_at` on their pieces).
+    pub fn d_move_at(&self, n: u32, x: DEntry, y: DEntry) -> (f64, f64) {
+        self.move_at(n, self.d_pentry(x), self.d_pentry(y))
+    }
+
+    /// The piece end side `x` arrives by at its node (`port_side`); None at a cut.
+    pub fn d_arrive_side(&self, x: DEntry) -> Option<u8> {
+        if self.d_inner_to(x) {
+            return None;
+        }
+        let p = self.d_pentry(x);
+        self.port_side(path_edge(p), 1 - path_dir(p))
+    }
+
+    /// Whether entry `x` runs a to b along its track's way (`WAY_AB`) or b to a.
+    pub fn d_way_ok(&self, x: DEntry) -> bool {
+        self.track(self.d_track(x.edge())).way & if x.dir() == 0 { WAY_AB } else { WAY_BA } != 0
+    }
+}
+
+impl Run {
+    /// Its entries as piece entries, one per entry (so they line up with `nodes`).
+    pub fn pentries(&self, net: &Network) -> Vec<u32> {
+        self.segs.iter().map(|&x| net.d_pentry(x)).collect()
+    }
+
+    /// The piece path it was built from: its entries as piece entries, the parts of a cut track as one.
+    pub fn piece_path(&self, net: &Network) -> Vec<u32> {
+        let mut out: Vec<u32> = Vec::with_capacity(self.segs.len());
+        let mut joined = false;
+        for &x in &self.segs {
+            if !joined {
+                out.push(net.d_pentry(x));
+            }
+            joined = net.d_inner_to(x);
+        }
+        out
+    }
+}
