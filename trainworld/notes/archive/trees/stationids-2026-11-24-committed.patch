diff --git a/trainworld/sim/src/track/legacy.rs b/trainworld/sim/src/track/legacy.rs
new file mode 100644
index 000000000..5fca0cc39
--- /dev/null
+++ b/trainworld/sim/src/track/legacy.rs
@@ -0,0 +1,212 @@
+//! Load only: what a save from before the track rework needs to become today's records (notes/T-3444-design/
+//! 07-saves.md "How old saves load"). Frozen copies of rules live code no longer has, with no other callers but
+//! `realsave`, which lays its bundles by the same run rule (`lay_bundles`).
+
+use super::geom;
+use super::net::{Bundle, Network};
+use std::collections::HashMap;
+
+/// The pair-beside rule as it stood before bundles (`twin_at`, T-255, T-1895): another piece running parallel (the sine
+/// of the angle between them at most this) ...
+const TWIN_SIN: f64 = 0.03;
+/// ... 4 to 15 ground m off (half quad's 8 m spacing to 1.25 x the 12 m of track drawn beside track), the nearest.
+const TWIN_MIN_M: f64 = 4.0;
+const TWIN_MAX_M: f64 = 15.0;
+/// `twins`' grid cell, ground m: at least 1.34 x `TWIN_MAX_M` (its listing reaches 0.75 of a cell).
+const GRID_M: f64 = 100.0;
+
+/// T-3949: a network from a save without `LBN1` gets its bundles once, from the old rule asked at each piece's middle
+/// (as doubling up asked it): every piece and the nearest it finds beside it are one bundle, in other slots, and the
+/// pieces so linked, one after another, make one bundle. Slots alternate across (a third pair beside a quad gets the
+/// first pair's slot, so each piece's neighbour across is still the nearest of another slot). Crossovers are in none.
+/// Needs the network derived; changes nothing else.
+pub fn find_bundles(net: &mut Network) {
+    let edges = candidates(net);
+    let beside: Vec<(u32, u32, u8)> = twins(net, &edges).into_iter().map(|(e, f)| (e, f, 1)).collect();
+    lay_bundles(net, &beside);
+}
+
+/// The bundles of pieces known to lie side by side, `beside` as (piece, piece, 1 in other slots or 0 in one): those
+/// are one bundle, and so is the next such piece through a two-ended node (a joint, a station), in the same slot, one
+/// bundle per run as drawing makes them; a link that would put a piece in both slots is left out. `find_bundles`
+/// gives it the old rule's pairs, `realsave` (T-3958) the pipeline's, which knows them. Needs the network derived.
+pub fn lay_bundles(net: &mut Network, beside_links: &[(u32, u32, u8)]) {
+    net.bundles_known = true;
+    let edges = candidates(net);
+    let mut beside: HashMap<u32, Vec<(u32, u8)>> = HashMap::new();
+    for &(e, f, odd) in beside_links {
+        beside.entry(e).or_default().push((f, odd));
+        beside.entry(f).or_default().push((e, odd));
+    }
+    let mut sets = Parity::new(net.edge_count());
+    let mut links: Vec<(u32, u32, u8)> = beside.iter().flat_map(|(&e, fs)| fs.iter().map(move |&(f, odd)| (e, f, odd))).collect();
+    links.sort_unstable();
+    for &e in &edges {
+        if !beside.contains_key(&e) {
+            continue;
+        }
+        for n in [net.edge_a[e as usize], net.edge_b[e as usize]] {
+            let ends = net.node_ports[n as usize].ends();
+            if let [c, d] = ends[..] {
+                let f = if c >> 1 == e { d >> 1 } else { c >> 1 };
+                if f > e && beside.contains_key(&f) && !net.edge_crossover[f as usize] {
+                    links.push((e, f, 0));
+                }
+            }
+        }
+    }
+    for (e, f, odd) in links {
+        sets.join(e, f, odd);
+    }
+    let mut ids: HashMap<u32, u32> = HashMap::new();
+    for &e in &edges {
+        if beside.contains_key(&e) {
+            let (root, slot) = sets.find(e);
+            let id = *ids.entry(root).or_insert_with(|| net.new_bundle());
+            net.set_bundle_of(e, Bundle { id, slot });
+        }
+    }
+}
+
+/// The pieces of track the rule looks at: live, not crossovers.
+fn candidates(net: &Network) -> Vec<u32> {
+    (0..net.edge_count() as u32).filter(|&e| net.edge_ok(e) && !net.edge_crossover[e as usize] && net.edge_len[e as usize] > 0.0).collect()
+}
+
+/// Each of `edges` with the one of them the rule finds beside its middle, if any, in `edges`' order.
+pub(crate) fn twins(net: &Network, edges: &[u32]) -> Vec<(u32, u32)> {
+    let mut out = vec![];
+    if edges.len() < 2 {
+        return out;
+    }
+    // A grid listing each geometry piece in the cell of every point half a cell apart along it, so whatever lies within
+    // 0.75 of a cell of a point is listed within one cell of it; the cells are 100 m, several times the reach, so the
+    // list stays short (a sorted list of (cell, piece, geometry piece), not a map of cells). The rule took the nearest
+    // point of the whole piece of track; only its geometry pieces listed near the point can be within reach.
+    let kmax = edges.iter().map(|&e| net.k_at(net.node_y[net.edge_a[e as usize] as usize]).max(net.k_at(net.node_y[net.edge_b[e as usize] as usize]))).fold(1.0, f64::max);
+    let cell = GRID_M * kmax;
+    let key = |x: f64, y: f64| ((x / cell).floor() as i64, (y / cell).floor() as i64);
+    let mut grid: Vec<((i64, i64), u32, u32)> = vec![];
+    for &e in edges {
+        for (i, p) in net.edge_pieces(e).iter().enumerate() {
+            let n = (p.plen / (cell / 2.0)).ceil().max(1.0) as usize;
+            for t in 0..=n {
+                let (x, y, _) = p.at_plane(p.plen * t as f64 / n as f64);
+                grid.push((key(x, y), e, i as u32));
+            }
+        }
+    }
+    grid.sort_unstable();
+    grid.dedup();
+    let mut near: Vec<(u32, f64, f64)> = vec![];
+    for &e in edges {
+        let (x, y, th) = geom::pos_at(net.edge_pieces(e), net.edge_len[e as usize] / 2.0);
+        let k = net.k_at(y);
+        let (cx, cy) = key(x, y);
+        // per other piece of track, its nearest point among its geometry pieces listed here: (piece, distance, heading)
+        near.clear();
+        for gx in cx - 1..=cx + 1 {
+            for gy in cy - 1..=cy + 1 {
+                let from = grid.partition_point(|g| g.0 < (gx, gy));
+                for &(_, f, i) in grid[from..].iter().take_while(|g| g.0 == (gx, gy)) {
+                    if f == e {
+                        continue;
+                    }
+                    let one = &net.edge_pieces(f)[i as usize..=i as usize];
+                    let (sf, dist) = geom::project(one, x, y);
+                    let thf = geom::pos_at(one, sf).2;
+                    match near.iter_mut().find(|n| n.0 == f) {
+                        Some(n) if n.1 <= dist => {}
+                        Some(n) => (n.1, n.2) = (dist, thf),
+                        None => near.push((f, dist, thf)),
+                    }
+                }
+            }
+        }
+        // in id order, as the rule went through them
+        near.sort_unstable_by_key(|n| n.0);
+        let mut best: Option<(u32, f64)> = None;
+        for &(f, dist, thf) in &near {
+            if !(TWIN_MIN_M * k..=TWIN_MAX_M * k).contains(&dist) || (th - thf).sin().abs() > TWIN_SIN || best.is_some_and(|b| b.1 <= dist) {
+                continue;
+            }
+            best = Some((f, dist));
+        }
+        if let Some((f, _)) = best {
+            out.push((e, f));
+        }
+    }
+    out
+}
+
+/// `twins` the way the rule itself went, every piece projected whole: for tests.
+#[cfg(test)]
+pub(crate) fn twins_by_scan(net: &Network) -> Vec<(u32, u32)> {
+    let edges = candidates(net);
+    let mut out = vec![];
+    for &e in &edges {
+        let (x, y, th) = geom::pos_at(net.edge_pieces(e), net.edge_len[e as usize] / 2.0);
+        let k = net.k_at(y);
+        let mut best: Option<(u32, f64)> = None;
+        for &f in &edges {
+            if f == e {
+                continue;
+            }
+            let (sf, dist) = net.project(f, x, y);
+            if !(TWIN_MIN_M * k..=TWIN_MAX_M * k).contains(&dist) || (th - geom::pos_at(net.edge_pieces(f), sf).2).sin().abs() > TWIN_SIN || best.is_some_and(|b| b.1 <= dist) {
+                continue;
+            }
+            best = Some((f, dist));
+        }
+        if let Some((f, _)) = best {
+            out.push((e, f));
+        }
+    }
+    out
+}
+
+/// `twins` over the same pieces as `find_bundles`, for tests.
+#[cfg(test)]
+pub(crate) fn twins_by_grid(net: &Network) -> Vec<(u32, u32)> {
+    twins(net, &candidates(net))
+}
+
+/// Union-find keeping each member's parity against its set's root (its slot).
+struct Parity {
+    up: Vec<u32>,
+    odd: Vec<u8>,
+}
+
+impl Parity {
+    fn new(n: usize) -> Parity {
+        Parity { up: (0..n as u32).collect(), odd: vec![0; n] }
+    }
+    fn find(&mut self, e: u32) -> (u32, u8) {
+        let mut path = vec![];
+        let mut x = e;
+        while self.up[x as usize] != x {
+            path.push(x);
+            x = self.up[x as usize];
+        }
+        // from the root down, each one's parity against the root, then hung on it
+        for &p in path.iter().rev() {
+            let up = self.up[p as usize];
+            if up != x {
+                self.odd[p as usize] ^= self.odd[up as usize];
+            }
+            self.up[p as usize] = x;
+        }
+        (x, self.odd[e as usize])
+    }
+    /// `e` and `f` in one set, `odd` 1 for other slots; false (and nothing joined) where they are one already the
+    /// other way.
+    fn join(&mut self, e: u32, f: u32, odd: u8) -> bool {
+        let ((re, pe), (rf, pf)) = (self.find(e), self.find(f));
+        if re == rf {
+            return pe ^ pf == odd;
+        }
+        self.up[rf as usize] = re;
+        self.odd[rf as usize] = pe ^ pf ^ odd;
+        true
+    }
+}
