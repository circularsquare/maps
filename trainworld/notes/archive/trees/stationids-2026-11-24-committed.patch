+/// T-4033: a line path entry names a piece, one of its tracks by key (`TrackRec::key`) and a direction (0 a to b):
+/// `TAG | piece << 5 | key << 1 | dir`. Port codes (`Ports::end`, `edge << 1 | end`) and the app's entries
+/// (`app_entry`) are other encodings; the tag makes one used for the other fail loudly in tests (`entry_check`).
+pub const ENTRY_TAG: u32 = 1 << 31;
+
+pub fn entry(piece: u32, key: u8, dir: u32) -> u32 {
+    if cfg!(test) {
+        assert!(piece < 1 << 26 && key < 16 && dir < 2, "entry({piece}, {key}, {dir})");
+    }
+    ENTRY_TAG | piece << 5 | (key as u32) << 1 | dir
+}
+
+#[inline]
+fn entry_check(p: u32) {
+    if cfg!(test) {
+        assert!(p & ENTRY_TAG != 0, "{p:#x} is not a path entry");
+    }
+}
+
 pub fn path_edge(p: u32) -> u32 {
-    p >> 1
+    entry_check(p);
+    (p & !ENTRY_TAG) >> 5
 }
 pub fn path_dir(p: u32) -> u32 {
+    entry_check(p);
     p & 1
 }
+/// The key of the track a path entry runs on.
+pub fn path_key(p: u32) -> u8 {
+    entry_check(p);
+    (p >> 1 & 15) as u8
+}
+
+/// The same track and direction on piece `e` (a split's other half, a piece renumbered).
+pub fn with_piece(p: u32, e: u32) -> u32 {
+    entry(e, path_key(p), path_dir(p))
+}
+
+/// A path entry as the app and the fingerprints read it, `edge << 1 | dir`: the track goes (stage d sends it apart).
+pub fn app_entry(p: u32) -> u32 {
+    path_edge(p) << 1 | path_dir(p)
+}
+
+pub fn app_path(path: &[u32]) -> Vec<u32> {
+    path.iter().map(|&p| app_entry(p)).collect()
+}
 
