+/// TWT4 to TWT6's nodes and edges (`old_body`): the network as the converter reads it (07-saves "How old saves
+/// load"). Each edge loads as one piece with its tracks, ways and joins as they were, so it runs as before.
+fn read_old_body(bytes: &[u8], r: &mut R, unknown: &mut usize) -> Result<(Network, usize, usize), String> {
+    let f = |o: usize| f64::from_le_bytes(bytes[o..o + 8].try_into().unwrap());
+    let kind = match &bytes[..4] {
+        b"TWT5" => FrameKind::Lcc,
+        b"TWT6" => FrameKind::Merc,
+        _ => FrameKind::Equirect,
+    };
+    let mut net = Network::new_in(kind, f(4), f(12), false);
+    net.right_hand = r.u()? == 1;
+    let n_nodes = r.u()? as usize;
+    let (mut px, mut py) = (0.0, 0.0);
+    for _ in 0..n_nodes {
+        let id = net.alloc_node();
+        let (x, y) = (quant(px + r.mm()?), quant(py + r.mm()?));
+        (px, py) = (x, y);
+        let level = r.i()? as i8;
+        let flags = r.u()?;
+        *unknown += (flags >> 12 != 0) as usize;
+        net.set_node(id, Some(NodeData { x, y, level, flying: flags & 1 == 1 })).map_err(|e| format!("{e:?}"))?;
+        if flags & 2 != 0 {
+            let platform = r.u()? as u16;
+            let name = r.s()?;
+            net.set_station(id, Some(StationData { platform, name, named: flags >> 8 & 1 != 0, built: flags & 4 != 0, off: flags & 8 != 0, upgrades: (flags >> 4) as u8, berth: None, day: 0, one: (flags >> 9 & 3) as u8, fare: 0, own: String::new(), road: None, at: [None; 2] })).map_err(|e| format!("{e:?}"))?;
+        }
+    }
+    let n_edges = r.u()? as usize;
+    let mut prev_a = 0i64;
+    for _ in 0..n_edges {
+        let id = net.alloc_edge();
+        let a = prev_a + r.i()?;
+        let b = a + r.i()?;
+        prev_a = a;
+        let tb = r.u()?;
+        *unknown += (tb >> 17 != 0) as usize;
+        let oneway = (tb >> 11 & 3) as u8;
+        let (tracks, built, off, crossover, sep) = ((tb & 3) as u8, tb & 4 != 0, tb & 16 != 0, tb & 32 != 0, tb & 128 != 0);
+        let kind = match (tb >> 8 & 7) as u8 {
+            0 => TrackKind::from_hsr(tb & 64 != 0),
+            k => TrackKind::from_u8(k).unwrap_or_else(|| {
+                *unknown += 1;
+                TrackKind::Regular
+            }),
+        };
+        // T-2820: ends and sizes that cannot be are a damaged save, not a panic
+        if a < 0 || b < 0 || a as usize >= n_nodes || b as usize >= n_nodes {
+            return Err("bad edge".into());
+        }
+        let (pis, thru) = pis_in(r, &net, a as usize, tb & 8 != 0, bytes.len())?;
+        // the old model wrote 0 to 2 (left and right of a double); nothing was ever loose
+        let mut join = |c: u64| if c == 3 { join_in(4, unknown) } else { join_in(c, unknown) };
+        let tracks = if tracks == 1 { Tracks::single(oneway, [join(tb >> 13 & 3), join(tb >> 15 & 3)]) } else { Tracks::new(tracks) };
+        net.set_edge(id, Some(EdgeData { a: a as u32, b: b as u32, tracks, pis, built, off, thru, crossover, kind, sep, day: 0, limit: 0, ramp: 0, bundle: Default::default() })).map_err(|e| format!("{e:?}"))?;
