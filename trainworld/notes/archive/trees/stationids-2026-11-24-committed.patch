+//! T-3957 (track rework stage 3f): a way set on one piece spreads along its track to the nearest branch points, a
+//! track traced junction to junction, and one track of a double given its own way.
+
+use super::*;
+
+fn api(right_hand: bool) -> TrackApi {
+    let mut a = TrackApi::new(-73.985, 40.758, right_hand);
+    a.set_cash(1e9);
+    a
+}
+fn free(x: f64, y: f64) -> [f64; 5] {
+    [0.0, 0.0, x, y, 0.0]
+}
+fn ends(a: [f64; 5], b: [f64; 5]) -> Vec<f64> {
+    a.iter().chain(b.iter()).copied().collect()
+}
+fn node_near(a: &TrackApi, x: f64, y: f64) -> u32 {
+    let n = &a.w.net;
+    let d = |k: u32| (n.node_x[k as usize] - x).hypot(n.node_y[k as usize] - y);
+    (0..n.node_count() as u32).filter(|&k| n.node_ok(k)).min_by(|&p, &q| d(p).total_cmp(&d(q))).unwrap()
+}
+fn at_node(a: &TrackApi, n: u32) -> [f64; 5] {
+    [1.0, n as f64, a.w.net.node_x[n as usize], a.w.net.node_y[n as usize], 0.0]
+}
+fn edge_near(a: &TrackApi, x: f64, y: f64) -> u32 {
+    let n = &a.w.net;
+    (0..n.edge_count() as u32).filter(|&e| n.edge_ok(e)).min_by(|&p, &q| n.project(p, x, y).1.total_cmp(&n.project(q, x, y).1)).unwrap()
+}
+fn station_on(a: &mut TrackApi, x: f64, y: f64) -> u32 {
+    let e = edge_near(a, x, y);
+    let n = &a.w.net;
+    let (px, py, _) = crate::track::geom::pos_at(n.edge_pieces(e), n.project(e, x, y).0);
+    assert_eq!(a.add_station(2, e, px, py, 120, "S".into()), 0, "{}", a.issues());
+    node_near(a, px, py)
+}
+fn end_station(a: &mut TrackApi, x: f64, y: f64) -> u32 {
+    let n = node_near(a, x, y);
+    assert_eq!(a.add_station(1, n, x, y, 200, "T".into()), 0, "{}", a.issues());
+    n
+}
+fn line(a: &mut TrackApi, stops: &[u32]) -> u32 {
+    let l = a.new_line_id();
+    assert_eq!(a.set_line_with_trains(l, stops, 4, 2, 0, 30.0, 180.0, 0, 0, "L".into()), 0, "{}", a.issues());
+    l
+}
+
+/// T-3647's scene A (her tram street split round a kerbside pair): double (0, 0) to (2000, 0), two single legs to
+/// (4000, 0) through (3000, +-`gap`), drawn with no way set (their joins give the ways), then double to (6000, 0);
+/// end stations P and Q and a kerbside stop on each leg. Returns (P, Q, north stop, south stop).
+fn kerbside(right_hand: bool, gap: f64) -> (TrackApi, [u32; 4]) {
+    let mut a = api(right_hand);
+    assert_eq!(a.add_route(&ends(free(0.0, 0.0), free(2000.0, 0.0)), &[], 2, false), 0, "{}", a.issues());
+    assert_eq!(a.add_route(&ends(free(4000.0, 0.0), free(6000.0, 0.0)), &[], 2, false), 0, "{}", a.issues());
+    let (j0, j1) = (node_near(&a, 2000.0, 0.0), node_near(&a, 4000.0, 0.0));
+    for y in [gap, -gap] {
+        assert_eq!(a.add_route(&ends(at_node(&a, j0), at_node(&a, j1)), &[3000.0, y, 0.0, 0.0], 1, false), 0, "{}", a.issues());
+    }
+    let (p, q) = (end_station(&mut a, 0.0, 0.0), end_station(&mut a, 6000.0, 0.0));
+    let (n, s) = (station_on(&mut a, 3000.0, gap), station_on(&mut a, 3000.0, -gap));
+    (a, [p, q, n, s])
+}
+
+/// The pieces of the leg through (x, y), and the way each runs looking east (1 east, 2 west, 0 both).
+fn leg_ways(a: &TrackApi, x: f64, y: f64) -> Vec<u8> {
+    let net = &a.w.net;
+    let e = edge_near(a, x, y);
+    net.track_trace(e, 0)
+        .iter()
+        .map(|&(p, _, _)| {
+            let east = net.node_x[net.edge_a[p as usize] as usize] < net.node_x[net.edge_b[p as usize] as usize];
+            match net.edge_way(p) {
+                0 => 0,
+                w => if (w == 1) == east { 1 } else { 2 },
+            }
+        })
+        .collect()
+}
+
+/// T-3662: switching one kerbside piece of a leg both ways takes the whole leg with it, out to the split, and every
+/// line on the scene still runs (or the switch is refused naming the line it would break, never accepted quietly).
+#[test]
+fn t3662_one_kerbside_piece_switched() {
+    for right_hand in [true, false] {
+        let (mut a, [p, q, n, s]) = kerbside(right_hand, 40.0);
+        let lines = [line(&mut a, &[p, q]), line(&mut a, &[p, n, s, q]), line(&mut a, &[p, n]), line(&mut a, &[s, q])];
+        let what = format!("right hand {right_hand}");
+        assert_eq!(leg_ways(&a, 2500.0, 30.0).len(), 2, "{what}: the leg is two pieces, split by its stop");
+        let piece = edge_near(&a, 2500.0, 30.0);
+        let r = a.set_edge_oneway(piece, 3);
+        let net = &a.w.net;
+        if r == 0 {
+            assert_eq!(leg_ways(&a, 2500.0, 30.0), vec![0, 0], "{what}: the whole leg both ways");
+            for l in lines {
+                assert!(!net.line_broken[l as usize] && net.check_line(l).is_ok(), "{what}: line {l} runs, {:?}", net.check_line(l));
+            }
+        } else {
+            assert!(matches!(a.issues[..], [Issue::OneWayNoWay { .. }]), "{what}: {}", a.issues());
+            assert!(lines.iter().all(|&l| !net.line_broken[l as usize]), "{what}: nothing broken");
+        }
+        eprintln!("{what}: switch {r} {}", a.issues());
+    }
+}
+
+/// A long single-track segment with stations along it, set one way from one piece in one edit: every piece out to
+/// the junctions, one undo; the reach export names the same pieces.
+#[test]
+fn a_long_leg_set_one_way_in_one_edit() {
+    for right_hand in [true, false] {
+        let (mut a, _) = kerbside(right_hand, 40.0);
+        for x in [2300.0, 2700.0, 3300.0, 3700.0] {
+            station_on(&mut a, x, -38.0);
+        }
+        let leg = leg_ways(&a, 3500.0, -35.0);
+        assert_eq!(leg.len(), 6, "right hand {right_hand}: six pieces between the junctions");
+        let piece = edge_near(&a, 3500.0, -35.0);
+        let reach = a.oneway_reach(&[piece]);
+        assert_eq!(reach.len(), 6);
+        let was = leg[0];
+        let want = if was == 1 { 2 } else { 1 };
+        let net = &a.w.net;
+        let east = net.node_x[net.edge_a[piece as usize] as usize] < net.node_x[net.edge_b[piece as usize] as usize];
+        let dir = if (want == 1) == east { 1 } else { 2 };
+        assert_eq!(a.set_edge_oneway(piece, dir), 0, "{}", a.issues());
+        assert_eq!(leg_ways(&a, 3500.0, -35.0), vec![want; 6], "right hand {right_hand}: the whole leg turned");
+        assert_eq!(a.undo(), 0);
+        assert_eq!(leg_ways(&a, 3500.0, -35.0), vec![was; 6], "one undo");
+    }
+}
