+/// T-4035: the twins with line 1 stopping at the new station as well: by the split twin's route through its station
+/// node, by the anchor on the same path with the stop put in (a route to an anchor is stage f's). One edit each, from
+/// twins already equal.
+fn stopping_twins(single: bool, curved: bool) -> (TrackWorld, TrackWorld, u32, u32) {
+    let (mut split, mut cut, e, m) = twins(single, curved);
+    let mut stops = split.net.line_stops(1).to_vec();
+    stops.insert(2, m);
+    let mut d = split.net.line_data(1).unwrap();
+    d.stops = stops.clone();
+    d.path = split.net.route(&stops, &[]).unwrap();
+    split.apply(Op::Line { id: 1, data: Some(d) }).unwrap();
+    let mut d = cut.net.line_data(1).unwrap();
+    d.stops = stops;
+    cut.apply(Op::Line { id: 1, data: Some(d) }).map_err(|i| format!("{i:?}")).unwrap();
+    split.reload();
+    cut.reload();
+    (split, cut, e, m)
+}
+
+/// T-4035 (stage e's capability): a station off the track, its platforms on the piece's tracks (an anchor), runs as
+/// the same station at a node splitting the piece: a line stopping there, a line passing, a line crossing; run times,
+/// stops, every capacity resource, its price and upkeep share agree; demand sees the stop (a running line's stop).
+#[test]
+fn t4035_anchor_runs_as_split_station() {
+    for (single, curved) in [(false, false), (true, false), (false, true), (true, true)] {
+        let what = format!("single {single} curved {curved}");
+        let (split, cut, e, m) = stopping_twins(single, curved);
+        assert_eq!(cut.net.node_ports[m as usize].n, 0, "{what}");
+        assert_eq!(cut.net.anchor_of(m).map(|a| a.0), Some(e), "{what}");
+        for w in [&split, &cut] {
+            let ls = &w.svc.lines[1];
+            assert!(ls.ok && !w.net.line_broken[1], "{what}");
+            for run in &ls.runs {
+                assert_eq!(run.stop_s.len(), 5, "{what}");
+                let k = run.stop_idx[2] as usize;
+                assert_eq!(run.nodes[k], m, "{what}: both runs stop at the station");
+                assert!(!run.passes(2), "{what}");
+            }
+        }
+        // the stop's platform stands at the anchor for both runs of both lines over it
+        let at_m = |w: &TrackWorld| w.svc.cap.res.iter().filter(|r| r.kind == super::super::capacity::ResKind::Platform && r.node == m).count();
+        assert_eq!(at_m(&cut), at_m(&split), "{what}");
+        assert!(at_m(&cut) >= 1, "{what}");
+        assert_eq!(cut.net.station_build_price(m), split.net.station_build_price(m), "{what}: price by its platforms' tracks");
+        assert_eq!(cut.net.station_tracks(m), split.net.station_tracks(m), "{what}");
+        assert_eq!(cut.net.one_platform(m), split.net.one_platform(m), "{what}: upkeep share");
+        let rel = if curved { 2e-5 } else { 1e-12 };
+        agree(&format!("runs, {what}"), &run_figures(&split), &run_figures(&cut), rel);
+        agree(&format!("capacity, {what}"), &cap_figures(&split), &cap_figures(&cut), rel);
+    }
+}
+
+/// T-4035: placing an anchor station is an edit whose undo gives every derived id and figure back to the bit, and
+/// doing it again gives the placed figures again; an edit splitting its piece under it is refused.
+#[test]
+fn t4035_anchor_edit_and_undo() {
+    let (mut w, e, s) = fixture(false, true);
+    let before = exact(&w);
+    let ids: Vec<u32> = w.net.d_of_piece(e).collect();
+    let (nd, _, _) = w.net.split_plan(e, s).unwrap();
+    let m = w.net.alloc_node();
+    w.apply(Op::Node { id: m, data: Some(nd.clone()) }).unwrap();
+    let keys: Vec<u8> = w.net.edge_recs[e as usize].recs().iter().map(|r| r.key).collect();
+    let at = w.net.project(e, nd.x, nd.y).0;
+    anchor(&mut w, m, e, at, &keys, 200).unwrap();
+    let placed = exact(&w);
+    let figures = (run_figures(&w), cap_figures(&w));
+    assert_ne!(placed, before);
+    assert!(w.net.d_of_piece(e).any(|d| d >= EXTRA_BASE), "the piece is cut at the anchor");
+    assert!((w.net.node_heading[m as usize] - geom_heading(&w, e, at)).abs() < 1e-6, "its heading along its piece");
+    w.undo().unwrap().unwrap();
+    assert!(w.net.d_of_piece(e).all(|d| d < EXTRA_BASE));
+    w.undo().unwrap().unwrap();
+    assert_eq!(w.net.d_of_piece(e).collect::<Vec<_>>(), ids);
+    assert_eq!(exact(&w), before, "undone to the bit");
+    w.apply(Op::Node { id: m, data: Some(nd) }).unwrap();
+    anchor(&mut w, m, e, at, &keys, 200).unwrap();
+    // (its extra ids come off the free list in another order: derived ids are compiled, not restored)
+    agree("placed again", &run_figures(&w), &figures.0, 0.0);
+    agree("placed again", &cap_figures(&w), &figures.1, 0.0);
+    let placed = exact(&w);
+    // a split of the piece under it leaves the platforms off their piece: refused
+    let (n2, e2) = (w.net.alloc_node(), w.net.alloc_edge());
+    assert!(w.apply(Op::Split { edge: e, s: 1000.0, node: n2, new_edge: e2 }).is_err(), "a split under an anchor waits for stage g");
+    assert_eq!(exact(&w), placed);
+}
+
+fn geom_heading(w: &TrackWorld, e: u32, s: f64) -> f64 {
+    super::super::geom::pos_at(w.net.edge_pieces(e), s).2
+}
+
+/// T-4035: an anchor saves its platforms' tracks (platform bit 1) and loads them back, the figures the same.
+#[test]
+fn t4035_anchor_saved_and_loaded() {
+    let (_, cut, _, m) = stopping_twins(false, false);
+    let bytes = super::super::save::encode(&cut.net);
+    let (net, unread) = super::super::save::decode_read(&bytes).unwrap();
+    assert_eq!(unread, 0, "nothing unread");
+    let mut back = TrackWorld::new(net);
+    back.reload();
+    assert_eq!(back.net.station_platforms(m).map(|p| p.and_then(|p| p.at)), cut.net.station_platforms(m).map(|p| p.and_then(|p| p.at)));
+    assert_eq!(exact(&back), exact(&cut));
+    assert_eq!(super::super::save::encode(&back.net), bytes);
+}
+
+/// T-4035: an anchor placed as an edit (the incremental derive and settle g's tool will take) gives the figures the
