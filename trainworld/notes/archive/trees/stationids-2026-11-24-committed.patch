+/// T-3961 (T-4036's departure 4): one-way legs as anchors are one-way stations, as split into the legs: a line clicked
+/// onto either leg's station is a two-way stop in one click, each run at its own leg, the pick stored; shift clicked it
+/// is served one way; the stops, picks, runs and every capacity resource agree with the split legs'.
+#[test]
+fn t3961_split_legs_as_anchors_as_split() {
+    for right_hand in [true, false] {
+        let mut out = vec![];
+        for anchors in [false, true] {
+            let (mut a, p, q, n, s) = split_legs(right_hand, anchors);
+            let what = format!("right hand {right_hand}, anchors {anchors}");
+            let net = &a.world().net;
+            assert_eq!(net.anchor_of(n).is_some(), anchors, "{what}");
+            assert!(net.leg_stop(n) && net.leg_stop(s), "{what}: one-way stations");
+            assert!(net.way_limited(n) && net.way_limited(s), "{what}");
+            let mut picks = vec![];
+            for click in [n, s] {
+                let l = a.world_mut().net.alloc_line();
+                assert_eq!(a.set_line_with_trains(l, &[p, q], 4, 2, 0, 30.0, 180.0, 0, 0, "L".into()), 0, "{}", a.issue_text());
+                assert_eq!(a.add_stop(l, click), 0, "{what}: {}", a.issue_text());
+                let other = if click == n { s } else { n };
+                let net = &a.world().net;
+                assert_eq!(net.line_stops(l), &[p, click, q], "{what}");
+                assert_eq!(net.line_picks(l), &[(click, other)], "{what}");
+                assert!(!net.line_broken[l as usize] && net.check_line(l).is_ok(), "{what}");
+                assert!(net.path_reversals(net.line_path(l)).is_empty(), "{what}: no turn back on the way out");
+                let ls = &a.world().svc.lines[l as usize];
+                assert!(ls.ok && ls.runs.iter().all(|r| !r.passes(1)), "{what}: served both ways");
+                let at: Vec<u32> = ls.runs.iter().map(|r| r.nodes[r.stop_idx[1] as usize]).collect();
+                assert!(at.contains(&n) && at.contains(&s), "{what}: each run at its own leg, {at:?}");
+                // shift clicked, served one way by its own leg's run; again, both ways
+                assert_eq!(a.one_way_stop(l, click), 0, "{}", a.issue_text());
+                assert!(a.world().net.line_picks(l).is_empty(), "{what}");
+                assert_eq!(a.world().svc.lines[l as usize].runs.iter().filter(|r| r.passes(1)).count(), 1, "{what}: served one way");
+                assert_eq!(a.one_way_stop(l, click), 0, "{}", a.issue_text());
+                picks.push(a.world().net.line_picks(l).to_vec());
+            }
+            // a line listing both legs: each stop served once, by the run its leg carries (T-3605)
+            let l = a.world_mut().net.alloc_line();
+            assert_eq!(a.set_line_with_trains(l, &[p, n, s, q], 4, 2, 0, 30.0, 180.0, 0, 0, "B".into()), 0, "{what}: {}", a.issue_text());
+            let net = &a.world().net;
+            assert!(!net.line_broken[l as usize] && net.line_picks(l).is_empty(), "{what}");
+            assert_eq!(a.world().svc.lines[l as usize].runs.iter().map(|r| r.pass.iter().filter(|&&x| x).count()).collect::<Vec<_>>(), [1, 1], "{what}");
+            let stops = net.line_stops(l).to_vec();
+            a.world_mut().reload();
+            out.push((a.into_world(), picks, stops));
+        }
+        let (cut, cpicks, cstops) = out.pop().unwrap();
+        let (split, spicks, sstops) = out.pop().unwrap();
+        assert_eq!((spicks, sstops), (cpicks, cstops), "right hand {right_hand}");
+        // the legs are curved through their stations
+        agree("split legs runs", &run_figures(&split), &run_figures(&cut), 2e-5);
+        agree("split legs capacity", &cap_figures(&split), &cap_figures(&cut), 2e-5);
+    }
+}
