--- /dev/null
+++ b/trainworld/sim/src/track/drawn.rs
@@ -0,0 +1,147 @@
+//! Where each track is drawn (T-3444 stage 3d, notes/T-3955.md): every track at its own offset from its piece's centre
+//! line, and at each end the offset where it meets the tracks it connects to across the node, from the compile's moves
+//! and the piece end's join. The map draws from these and works out nothing at nodes itself.
+//!
+//! The rule at a node, in this order:
+//! - **Join**: single track whose end has a join that counts (`join_away`) meets the double's track the join names.
+//! - **One-way leg**: one-way single track at a junction meets the track its trains come from or go to: the one track
+//!   its moves reach on the piece across the node it runs most nearly straight into.
+//! - **Merge**: where double track's tracks connect across the node only to single track that was not drawn onto one
+//!   of its tracks, its tracks meet that single track's line (the old automatic merge, which old saves keep until
+//!   stage 3e's tools stop making it).
+//! - **Single lead**: a two-way single drawn onto one track that also connects to the double's other track (the
+//!   compile gives it both) has that move drawn as a lead, along the double from the one track to the other.
+//!
+//! Offsets are metres, positive to the left looking from the piece's a to its b, as `Track::off`. Ends are drawn at
+//! the node's point: a piece end's place across the node (`TrackEnd::pos`, rank spacing included) is for crossing
+//! tests only.
+
+use super::compile::{TrackId, WAY_AB, WAY_BA};
+use super::geom;
+use super::net::Network;
+use super::params::TRACK_PITCH_M;
+
+/// A drawn single-lead link: along `piece`, from its end `end` (0 a, 1 b) at `node`, from the track at offset `from`
+/// at the node to the one at `to` (metres, `Track::off`); `single` the single track's piece it serves.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct Lead {
+    pub node: u32,
+    pub piece: u32,
+    pub single: u32,
+    pub end: u8,
+    pub from: f32,
+    pub to: f32,
+}
+
+impl Network {
+    /// Per track id, the offset it is drawn at where it meets the node at its piece's end a and end b (its own
+    /// offset where nothing moves it; `f32::NAN` for an id no live piece holds), and the single-lead links.
+    pub fn drawn_tracks(&self) -> (Vec<[f32; 2]>, Vec<Lead>) {
+        let mut at: Vec<[f32; 2]> = (0..self.track_id_count()).map(|t| {
+            let tr = self.track(TrackId(t as u32));
+            if tr.piece == u32::MAX { [f32::NAN; 2] } else { [tr.off; 2] }
+        }).collect();
+        let mut leads = vec![];
+        for n in 0..self.node_count() as u32 {
+            if self.node_ok(n) && self.node_ports[n as usize].n >= 2 {
+                self.drawn_at(n, &mut at, &mut leads);
+            }
+        }
+        (at, leads)
+    }
+
+    fn drawn_at(&self, n: u32, at: &mut [[f32; 2]], leads: &mut Vec<Lead>) {
+        let p = self.node_ports[n as usize];
+        let k = p.n as usize;
+        let piece = |j: usize| p.end[j] >> 1;
+        let single = |j: usize| self.edge_tracks[piece(j) as usize] == 1 && !self.edge_crossover[piece(j) as usize];
+        // every rule starts from single track
+        if !(0..k).any(single) {
+            return;
+        }
+        let nt = self.node_compiled(n);
+        let end = |j: usize| (p.end[j] & 1) as usize;
+        // a track's offset as seen along the node's heading is `sign * off` (as `compile_node` places them)
+        let sign = |j: usize| if (p.end[j] & 1 == 0) == (p.side[j] == 1) { 1.0f32 } else { -1.0 };
+        let mut heads = [0.0f64; super::net::MAX_PORTS];
+        for (j, h) in heads.iter_mut().enumerate().take(k) {
+            let pcs = self.edge_pieces(piece(j));
+            *h = if end(j) == 0 { geom::pos_at(pcs, 0.0).2 } else { geom::pos_at(pcs, self.edge_len[piece(j) as usize]).2 + std::f64::consts::PI };
+        }
+        let heading = |j: usize| heads[j];
+        let double = |j: usize| self.edge_tracks[piece(j) as usize] >= 2 && !self.edge_crossover[piece(j) as usize];
+        // the track ends each track end connects to through the node (either way a train runs)
+        let links = |x: usize| nt.moves.iter().filter_map(move |&(a, b)| if a as usize == x { Some(b as usize) } else if b as usize == x { Some(a as usize) } else { None });
+        let end_of = |j: usize| nt.ends.iter().position(|x| x.port as usize == j);
+        // the port across from `j` among `of` that `j` runs most nearly straight into
+        let straightest = |j: usize, of: &mut dyn Iterator<Item = usize>| {
+            let h = heading(j);
+            of.max_by(|&a, &b| (-(heading(a) - h).cos()).total_cmp(&-(heading(b) - h).cos()))
+        };
+        let mut moved = [false; super::net::MAX_PORTS];
+        for j in 0..k {
+            if !single(j) {
+                continue;
+            }
+            let Some(x) = end_of(j) else { continue };
+            let t = nt.ends[x].track;
+            let across: Vec<usize> = (0..k).filter(|&q| p.side[q] != p.side[j] && double(q)).collect();
+            if across.is_empty() {
+                continue;
+            }
+            let c = p.end[j];
+            if self.join_away(c).is_some() {
+                // 1 the track to the left looking out from the node along the piece, which runs b to a at end b
+                let left = self.end_join(c) == crate::track::net::Join::Left;
+                let h = across.iter().flat_map(|&q| self.piece_tracks(piece(q))).map(|u| self.track(u).off.abs()).fold(0.0f32, f32::max);
+                let h = if h > 0.0 { h } else { (TRACK_PITCH_M / 2.0) as f32 };
+                let off = if left { h } else { -h } * if end(j) == 0 { 1.0 } else { -1.0 };
+                at[t.0 as usize][end(j)] = off;
+                moved[j] = true;
+                // the lead: its other moves onto the double it runs into
+                if self.track(t).way == WAY_AB | WAY_BA {
+                    let Some(q) = straightest(j, &mut across.iter().copied()) else { continue };
+                    let from = sign(q) * sign(j) * off;
+                    for y in links(x) {
+                        if nt.ends[y].port as usize != q {
+                            continue;
+                        }
+                        let to = self.track(nt.ends[y].track).off;
+                        if (to - from).abs() > 0.5 {
+                            leads.push(Lead { node: n, piece: piece(q), single: piece(j), end: end(q) as u8, from, to });
+                        }
+                    }
+                }
+            } else if self.track(t).way != WAY_AB | WAY_BA && k >= 3 {
+                // (T-3209: a leg carrying straight on as single track, a double branching there, stays on its line)
+                let reached: Vec<usize> = links(x).collect();
+                let Some(q) = straightest(j, &mut reached.iter().map(|&y| nt.ends[y].port as usize)) else { continue };
+                if !double(q) {
+                    continue;
+                }
+                let mut on_q = reached.iter().filter(|&&y| nt.ends[y].port as usize == q);
+                if let (Some(&y), None) = (on_q.next(), on_q.next()) {
+                    at[t.0 as usize][end(j)] = sign(j) * sign(q) * self.track(nt.ends[y].track).off;
+                    moved[j] = true;
+                }
+            }
+        }
+        for j in 0..k {
+            if !double(j) {
+                continue;
+            }
+            let mine: Vec<usize> = (0..nt.ends.len()).filter(|&x| nt.ends[x].port as usize == j).collect();
+            let mut to: Vec<usize> = mine.iter().flat_map(|&x| links(x)).map(|y| nt.ends[y].port as usize).collect();
+            to.sort_unstable();
+            to.dedup();
+            if to.is_empty() || !to.iter().all(|&q| single(q) && !moved[q] && self.join_away(p.end[q]).is_none()) {
+                continue;
+            }
+            // onto the single track's line (several: between them, on the centre line)
+            let line = if to.len() == 1 { nt.ends.iter().find(|y| y.port as usize == to[0]).map_or(0.0, |y| sign(j) * sign(to[0]) * at[y.track.0 as usize][end(to[0])]) } else { 0.0 };
+            for &x in &mine {
+                at[nt.ends[x].track.0 as usize][end(j)] = line;
+            }
+        }
+    }
+}
