--- /dev/null
+++ b/trainworld/sim/src/track/wasm/platpic.rs
@@ -0,0 +1,215 @@
+//! The station panel's platform picture (T-3964, track rework stage 4e; notes/T-3444-design/03-tools.md "The station
+//! panel's platform picture"): a station across its tracks, each track with its way, its platform and the lines that
+//! stop beside it, and on quad the pair beside with its twin station (or the place one would go).
+
+use super::*;
+use crate::track::compile::{TrackId, WAY_AB, WAY_BA};
+use crate::track::net::{path_dir, path_edge, LoopKind};
+use std::f64::consts::PI;
+
+/// One track across the picture.
+struct Row {
+    t: TrackId,
+    piece: u32,
+    key: u8,
+    /// 1 its trains head right (east, or north on north-south track), 2 left, 3 both ways.
+    way: u8,
+    /// Its platform's id, -1 for none.
+    platform: f64,
+    x: f64,
+    y: f64,
+    /// Across the picture, m, up positive.
+    lat: f64,
+    lines: Vec<u32>,
+}
+
+/// The way trains head where they run right in the picture (the station's heading or its reverse, whichever is east
+/// or north by the nearest of the four compass words, as the app's `compass`), so up is north on track running more
+/// east-west and west on track running more north-south.
+fn right_of(h: f64) -> f64 {
+    let a = h.rem_euclid(2.0 * PI);
+    if a < 0.75 * PI || a >= 1.75 * PI { a } else { (a + PI).rem_euclid(2.0 * PI) }
+}
+
+#[wasm_bindgen]
+impl TrackApi {
+    /// The platform picture of station `node`: [the heading trains running right take (radians, world frame), group
+    /// count], then per group (the side up first): its station (-1 none: the pair beside with no station yet), its
+    /// kind (0 a station by its node's axis, 3 one whose platforms name their tracks, T-4035; with no station, where
+    /// one would go: 1 on node `id`, 2 on piece `id`), `id`, what a constructed one-track station pays for its second
+    /// platform (US$M, `station_tracks_cost`; 0 for a blueprint or any other), row count, then per
+    /// track (up first): piece, track key, way (1 right, 2 left, 3 both), platform id (-1 none), x, y (world), across
+    /// (m, up positive), line count and the lines stopping beside it. A station on single track with a passing loop
+    /// has two rows on its one track, one each way. Empty for no station, a port or a BRT station.
+    pub fn station_picture(&self, node: u32) -> Vec<f64> {
+        let net = &self.w.net;
+        if !net.node_ok(node) || net.platform_len(node) == 0 || net.station_berth(node).is_some() || net.station_road(node).is_some() {
+            return vec![];
+        }
+        let right = right_of(net.node_heading[node as usize]);
+        let (sx, sy) = (net.node_x[node as usize], net.node_y[node as usize]);
+        let k = net.k_at(sy);
+        let up = (-right.sin(), right.cos());
+        let lat = |x: f64, y: f64| ((x - sx) * up.0 + (y - sy) * up.1) / k;
+        let kind = |m: u32| if net.by_track(m) { 3.0 } else { 0.0 };
+        let mut groups: Vec<(f64, f64, f64, Vec<Row>)> = vec![(node as f64, kind(node), node as f64, self.station_rows(node, right, &lat))];
+        if let Some((e, s)) = self.station_place(node) {
+            if let Some(twin) = self.station_beside(e, s).filter(|&m| m != node) {
+                groups.push((twin as f64, kind(twin), twin as f64, self.station_rows(twin, right, &lat)));
+            } else if let Some((f, fs)) = self.pair_beside(e, s) {
+                let rows = if f == u32::MAX {
+                    let m = fs as u32;
+                    self.node_place(m).map_or(vec![], |(g, gs)| self.piece_rows(g, gs, right, &lat))
+                } else {
+                    self.piece_rows(f, fs, right, &lat)
+                };
+                if !rows.is_empty() {
+                    groups.push((-1.0, if f == u32::MAX { 1.0 } else { 2.0 }, if f == u32::MAX { fs } else { f as f64 }, rows));
+                }
+            }
+        }
+        let mean = |r: &[Row]| r.iter().map(|x| x.lat).sum::<f64>() / r.len().max(1) as f64;
+        groups.sort_by(|a, b| mean(&b.3).total_cmp(&mean(&a.3)));
+        let mut out = vec![right, groups.len() as f64];
+        for (st, kind, id, mut rows) in groups {
+            rows.sort_by(|a, b| b.lat.total_cmp(&a.lat));
+            let price = if st >= 0.0 && net.station_built(st as u32) { self.station_tracks_cost(st as u32) } else { 0.0 };
+            out.extend([st, kind, id, price, rows.len() as f64]);
+            for r in rows {
+                out.extend([r.piece as f64, r.key as f64, r.way as f64, r.platform, r.x, r.y, r.lat, r.lines.len() as f64]);
+                out.extend(r.lines.iter().map(|&l| l as f64));
+            }
+        }
+        out
+    }
+}
+
+impl TrackApi {
+    /// The piece a station stands on and its chainage there: an anchor's, else its first piece end's.
+    fn station_place(&self, n: u32) -> Option<(u32, f64)> {
+        self.w.net.anchor_of(n).or_else(|| self.node_place(n))
+    }
+
+    fn node_place(&self, n: u32) -> Option<(u32, f64)> {
+        let net = &self.w.net;
+        let c = *net.node_ports[n as usize].ends().first()?;
+        let e = c >> 1;
+        Some((e, if c & 1 == 0 { 0.0 } else { net.edge_len[e as usize] }))
+    }
+
+    /// Piece `e`'s tracks at chainage `s`, with their ways in the picture (trains heading `right` run right).
+    fn piece_rows(&self, e: u32, s: f64, right: f64, lat: &dyn Fn(f64, f64) -> f64) -> Vec<Row> {
+        let net = &self.w.net;
+        let (px, py, th) = geom::pos_at(net.edge_pieces(e), s);
+        let k = net.k_at(py);
+        let ab_right = (th - right).cos() > 0.0;
+        net.piece_tracks(e)
+            .map(|t| {
+                let tr = net.track(t);
+                let off = tr.off as f64 * k;
+                let (x, y) = (px - th.sin() * off, py + th.cos() * off);
+                let way = match tr.way {
+                    w if w == WAY_AB | WAY_BA => 3,
+                    WAY_AB => if ab_right { 1 } else { 2 },
+                    _ => if ab_right { 2 } else { 1 },
+                };
+                Row { t, piece: e, key: tr.key, way, platform: -1.0, x, y, lat: lat(x, y), lines: vec![] }
+            })
+            .collect()
+    }
+
+    /// Station `n`'s rows: its tracks with their platforms and the lines stopping beside each.
+    fn station_rows(&self, n: u32, right: f64, lat: &dyn Fn(f64, f64) -> f64) -> Vec<Row> {
+        let net = &self.w.net;
+        let Some((e, s)) = self.station_place(n) else { return vec![] };
+        let mut rows = self.piece_rows(e, s, right, lat);
+        let [along, against] = net.station_platforms(n).map(|p| p.is_some());
+        let axis = net.node_heading[n as usize];
+        // the platform by the node's axis that trains heading `h` stop at (`StationData::one`'s fixed axis)
+        let by_axis = |h: f64| -> f64 {
+            if crate::track::net::one_for_travel(h) == 1 {
+                if along { (2 * n) as f64 } else { -1.0 }
+            } else if against {
+                (2 * n + 1) as f64
+            } else {
+                -1.0
+            }
+        };
+        let heading = |way: u8| if way == 1 { right } else { right + PI };
+        let looped = !net.by_track(n) && rows.len() == 1 && along && against;
+        if net.by_track(n) {
+            for r in &mut rows {
+                r.platform = net.platform_on(n, r.t).map_or(-1.0, |p| p as f64);
+            }
+        } else if looped {
+            // the passing loop (drawn, not yet track): a row each way, trains keeping to the running side
+            let r = rows.pop().unwrap();
+            let k = net.k_at(r.y);
+            for (way, side) in [(1u8, -1.0), (2, 1.0)] {
+                let side = if net.right_hand { side } else { -side };
+                let (x, y) = (r.x - right.sin() * side * 2.0 * k, r.y + right.cos() * side * 2.0 * k);
+                rows.push(Row { t: r.t, piece: r.piece, key: r.key, way, platform: by_axis(heading(way)), x, y, lat: lat(x, y), lines: vec![] });
+            }
+        } else if rows.len() == 1 {
+            rows[0].platform = if along { (2 * n) as f64 } else if against { (2 * n + 1) as f64 } else { -1.0 };
+        } else {
+            for r in &mut rows {
+                r.platform = if r.way != 3 {
+                    by_axis(heading(r.way))
+                } else {
+                    // a two-way track of a double: by its side of the axis, as the station tool places one (`one_at`)
+                    let left = axis.cos() * (r.y - net.node_y[n as usize]) - axis.sin() * (r.x - net.node_x[n as usize]) > 0.0;
+                    by_axis(if left != net.right_hand { axis } else { axis + PI })
+                };
+            }
+        }
+        // the lines stopping here, each beside the platform it stops at (its stop point, found as `d_run_passes` finds
+        // it); in a passing loop, on the loop track its way takes; at a track end, on the track it arrives on or
+        // leaves by
+        let through = net.by_track(n) || net.node_ports[n as usize].n == 2;
+        for (l, ls) in self.w.svc.lines.iter().enumerate() {
+            if !ls.ok || !net.line_ok(l as u32) {
+                continue;
+            }
+            let circle = ls.kind == LoopKind::Circle;
+            for run in &ls.runs {
+                for (j, &i) in run.stop_idx.iter().enumerate() {
+                    let i = i as usize;
+                    // (a stop its trains pass on a track with no platform, T-3332)
+                    if run.nodes.get(i) != Some(&n) || run.segs.is_empty() || run.pass.get(j) == Some(&true) {
+                        continue;
+                    }
+                    let last = *run.segs.last().unwrap();
+                    let (side, x) = if i > 0 {
+                        (net.d_arrive_side(run.segs[i - 1]), run.segs[i - 1])
+                    } else if circle {
+                        (net.d_arrive_side(last), last)
+                    } else {
+                        let p = net.d_pentry(run.segs[0]);
+                        (net.port_side(path_edge(p), path_dir(p)), run.segs[0])
+                    };
+                    let row = if looped {
+                        let (_, _, th) = geom::pos_at(net.edge_pieces(e), s);
+                        let travel = th + if x.dir() == 1 { PI } else { 0.0 };
+                        let way = if (travel - right).cos() > 0.0 { 1 } else { 2 };
+                        rows.iter_mut().find(|r| r.way == way)
+                    } else if !through {
+                        // a track end: one stop point for every train (`stop_point`), so the track it is on
+                        let t = net.d_track(x.edge());
+                        rows.iter_mut().find(|r| r.t == t)
+                    } else {
+                        let side = if net.d_inner_to(x) || (i == 0 && net.anchor_of(n).is_some()) { Some(0) } else { side };
+                        let sp = side.and_then(|sd| net.stop_point(n, sd, net.d_track(x.edge())));
+                        sp.and_then(|sp| rows.iter_mut().find(|r| r.platform == sp.platform as f64))
+                    };
+                    if let Some(r) = row {
+                        if !r.lines.contains(&(l as u32)) {
+                            r.lines.push(l as u32);
+                        }
+                    }
+                }
+            }
+        }
+        rows
+    }
+}
diff --git a/trainworld/sim/src/track/wasm/platpic_tests.rs b/trainworld/sim/src/track/wasm/platpic_tests.rs
