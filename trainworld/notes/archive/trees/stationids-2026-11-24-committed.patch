index 000000000..480a2b8b3
--- /dev/null
+++ b/trainworld/app/src/ui/inspector/StopChip.tsx
@@ -0,0 +1,90 @@
+// T-3962: the stop list's track chip (notes/T-3444-design/04-stops.md "The track chip in the stop list"): on a stop
+// whose two runs stop at different stations (her split legs, a one-track station's way beside) or where a run could
+// stop at another, a small picture of the tracks there, one stroke per station's track, north first, those the line
+// stops on in its colour. A click lists each way with its choices; picking one is one edit, that way only.
+
+import { useEffect, useRef } from "preact/hooks";
+import { t } from "../../i18n";
+import type { StationInput, StopPicks } from "../../game/types";
+import { compass } from "../../game/oneTrack";
+
+/** the picture: 14 px tall, one stroke per track */
+const W = 18, H = 14, PAD = 3;
+
+/** The stations a chip draws, north first (west first where its track runs north and south): the listed stop's and
+ * every one either run stops at or could. */
+function tracksOf(p: StopPicks, stop: string, byId: (id: string) => StationInput | undefined): string[] {
+  const ids = [...new Set([stop, ...p.at.filter((x): x is string => x !== null), ...p.choices[0], ...p.choices[1]])];
+  // across the stop's axis, the axis turned to run east (north where it runs exactly north and south)
+  const s = byId(stop), h = p.heading;
+  let ax = Math.cos(h), ay = Math.sin(h);
+  if (ax < -1e-6 || (Math.abs(ax) <= 1e-6 && ay < 0)) { ax = -ax; ay = -ay; }
+  const across = (id: string) => { const m = byId(id); return m && s ? (m.x - s.x) * -ay + (m.y - s.y) * ax : 0; };
+  return ids.sort((a, b) => across(b) - across(a));
+}
+
+function Picture({ tracks, on, colour }: { tracks: string[]; on: (id: string) => boolean; colour: string }) {
+  const step = tracks.length > 1 ? (H - 2 * PAD) / (tracks.length - 1) : 0;
+  return (
+    <svg width={W} height={H} viewBox={`0 0 ${W} ${H}`} aria-hidden="true">
+      {tracks.map((id, i) => {
+        const y = tracks.length > 1 ? PAD + step * i : H / 2;
+        return <line key={id} x1={2} x2={W - 2} y1={y} y2={y} stroke={on(id) ? colour : "var(--none-grey)"} stroke-width={2} stroke-linecap="round" />;
+      })}
+    </svg>
+  );
+}
+
+/** the way word of run `r` at the stop: run 0 along `heading`, run 1 the other way */
+const wayOf = (p: StopPicks, r: 0 | 1) => compass(p.heading + (r ? Math.PI : 0));
+
+export function StopChip({ p, stop, colour, name, byId, open, onOpen }: {
+  p: StopPicks; stop: string; colour: string; name: (id: string) => string; byId: (id: string) => StationInput | undefined; open: boolean; onOpen: (open: boolean) => void;
+}) {
+  const tracks = tracksOf(p, stop, byId);
+  const tip = ([0, 1] as const).map((r) => {
+    const at = p.at[r];
+    return at === null ? t("stopChip.passes", { way: wayOf(p, r) }) : t("stopChip.stopsAt", { way: wayOf(p, r), station: name(at) });
+  }).join("\n");
+  return (
+    <span class={"stop-chip" + (open ? " on" : "")} role="button" aria-expanded={open} aria-label={tip} data-tip={open ? undefined : tip}
+      onPointerDown={(e) => e.stopPropagation()} onClick={(e) => { e.stopPropagation(); onOpen(!open); }}>
+      <Picture tracks={tracks} on={(id) => p.at.includes(id)} colour={colour} />
+    </span>
+  );
+}
+
+/** The chip's list: a row per way, each with that way's choices, the one it stops at ringed. */
+export function StopChipPop({ p, stop, colour, name, byId, pick, onClose }: {
+  p: StopPicks; stop: string; colour: string; name: (id: string) => string; byId: (id: string) => StationInput | undefined;
+  pick: (heading: number, at: string) => void; onClose: () => void;
+}) {
+  const box = useRef<HTMLDivElement>(null);
+  useEffect(() => {
+    // before main.ts's Escape, which would clear the selection too
+    const key = (e: KeyboardEvent) => { if (e.key !== "Escape") return; onClose(); e.preventDefault(); e.stopImmediatePropagation(); };
+    const away = (e: PointerEvent) => { if (!box.current?.contains(e.target as Node) && !(e.target as Element).closest?.(".stop-chip")) onClose(); };
+    window.addEventListener("keydown", key, true);
+    window.addEventListener("pointerdown", away, true);
+    return () => { window.removeEventListener("keydown", key, true); window.removeEventListener("pointerdown", away, true); };
+  }, [onClose]);
+  const tracks = tracksOf(p, stop, byId);
+  return (
+    <div class="stop-chip-pop" ref={box} role="group" onPointerDown={(e) => e.stopPropagation()}>
+      {([0, 1] as const).map((r) => (
+        <div class="chip-way" key={r}>
+          <span class="way">{t("stopChip.way", { way: wayOf(p, r) })}</span>
+          {p.choices[r].map((m) => {
+            const on = p.at[r] === m, label = t("stopChip.stopAt", { station: name(m) });
+            return (
+              <button key={m} class={"btn icon mini" + (on ? " on" : "")} aria-pressed={on} aria-label={label} data-tip={label}
+                onClick={() => { if (!on) pick(p.heading + (r ? Math.PI : 0), m); }}>
+                <Picture tracks={tracks} on={(id) => id === m} colour={colour} />
+              </button>
+            );
+          })}
+        </div>
+      ))}
+    </div>
+  );
+}
