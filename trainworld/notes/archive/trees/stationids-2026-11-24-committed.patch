+fn read_body(bytes: &[u8], r: &mut R, unknown: &mut usize, body: &mut u32) -> Result<(Network, usize, usize), String> {
+    let f = |o: usize| f64::from_le_bytes(bytes[o..o + 8].try_into().unwrap());
+    let level = r.u()?;
+    if level > BODY_LEVEL as u64 {
+        return Err(NEWER_FORMAT.into());
+    }
+    *body = level as u32;
+    let kind = FrameKind::from_u8(r.u()? as u8).ok_or("bad frame")?;
+    let mut net = Network::new_in(kind, f(4), f(12), false);
+    net.right_hand = r.u()? == 1;
+    let n_nodes = r.u()? as usize;
+    let (mut px, mut py) = (0.0, 0.0);
+    for _ in 0..n_nodes {
+        let id = net.alloc_node();
+        let (x, y) = (quant(px + r.mm()?), quant(py + r.mm()?));
+        (px, py) = (x, y);
+        let level = r.i()? as i8;
+        let flags = r.u()?;
+        *unknown += (flags >> 1 != 0) as usize;
+        net.set_node(id, Some(NodeData { x, y, level, flying: flags & 1 == 1 })).map_err(|e| format!("{e:?}"))?;
+    }
+    // stations; before body level 3 each with its platform length and one-track way, from 3 their platforms after them
+    let records = level >= 3;
+    // T-4035: platforms placed by track: (station's place, which platform, bundle + 1, slot, mid mm)
+    let mut places: Vec<(usize, usize, u64, u64, u64)> = vec![];
+    let mut stations: Vec<(usize, StationData)> = vec![];
+    let mut node = 0usize;
+    for _ in 0..r.u()? {
+        node += r.u()? as usize;
+        if node >= n_nodes {
+            return Err("bad station".into());
+        }
+        let flags = r.u()?;
+        *unknown += (flags >> if records { 3 } else { 5 } != 0) as usize;
+        let upgrades = r.u()? as u8;
+        let platform = if records { 0 } else { r.u()? as u16 };
+        let name = r.s()?;
+        let one = if records { 0 } else { (flags >> 3 & 3) as u8 };
+        stations.push((node, StationData { platform, name, named: flags & 4 != 0, built: flags & 1 != 0, off: flags & 2 != 0, upgrades, berth: None, day: 0, one, fare: 0, own: String::new(), road: None, at: [None; 2] }));
+    }
+    if records {
+        // per station its platform beside the track along its node's axis and against it, their lengths
+        let mut sides: Vec<[Option<u16>; 2]> = vec![[None; 2]; stations.len()];
+        let mut k = 0usize;
+        for _ in 0..r.u()? {
+            k += r.u()? as usize;
+            let flags = r.u()?;
+            if flags >> 2 != 0 {
+                *unknown += 1;
+            }
