+// T-3950: the one rule every tool picks track by under the pointer (notes/T-3444-design/03-tools.md "One rule all
+// tools share"). A tool names the edge under the pointer, the point, and what it asks for: "whole" is every track of
+// the bundle there (4 tracks: that piece and the piece of each other slot level with it), "piece" the piece alone.
+// A piece of double track is one edge holding two tracks, so one track is the piece and its way (`OneTrack`, T-3956).
+// Main thread, from the rows' bundle and slot (T-3949) and the drawn geometry, so a hover and a click agree.
+
+import type { TrackEdge, WorldView } from "../game/types";
+import { world } from "../game/world";
+import { kAtY } from "./geo";
+import { live } from "./live";
+
+export type TrackAsk = "whole" | "piece";
+
+/** Ground metres within which a piece of another slot counts as level with the pointer: the sim's `LEVEL_WITH_M`
+ * (wasm.rs `piece_beside`), so the pick takes the piece the sim would call beside. */
+const LEVEL_WITH_M = 15;
+
+/** Each bundle's live pieces and the pieces in a bundle by id, kept per world state (the hover asks on every
+ * pointer move). */
+let members: { w: WorldView | null; by: Map<number, TrackEdge[]>; ids: Map<number, TrackEdge> } = { w: null, by: new Map(), ids: new Map() };
+function bundled(w: WorldView) {
+  if (members.w === w) return members;
+  const by = new Map<number, TrackEdge[]>(), ids = new Map<number, TrackEdge>();
+  for (const e of w.edges) {
+    if (!e.bundle) continue;
+    ids.set(e.id, e);
+    const l = by.get(e.bundle);
+    l ? l.push(e) : by.set(e.bundle, [e]);
+  }
+  return (members = { w, by, ids });
+}
+
+/** The point on polyline `pts` (x, y, z triples) nearest (x, y), and how far off it is, in local units. */
+function nearestPoint(pts: Float32Array, x: number, y: number): [number, number, number] {
+  let best = Infinity, bx = pts[0], by = pts[1];
+  for (let k = 0; k + 5 < pts.length; k += 3) {
+    const x0 = pts[k], y0 = pts[k + 1], dx = pts[k + 3] - x0, dy = pts[k + 4] - y0, l2 = dx * dx + dy * dy;
+    const t = l2 ? Math.max(0, Math.min(1, ((x - x0) * dx + (y - y0) * dy) / l2)) : 0;
+    const px = x0 + t * dx, py = y0 + t * dy, d = (px - x) ** 2 + (py - y) ** 2;
+    if (d < best) [best, bx, by] = [d, px, py];
+  }
+  return [bx, by, Math.sqrt(best)];
+}
+
+/** The middle of polyline `pts` by length, local units. */
+function middle(pts: Float32Array): [number, number] {
+  let total = 0;
+  for (let k = 3; k < pts.length; k += 3) total += Math.hypot(pts[k] - pts[k - 3], pts[k + 1] - pts[k - 2]);
+  let s = 0;
+  for (let k = 3; k < pts.length; k += 3) {
+    const d = Math.hypot(pts[k] - pts[k - 3], pts[k + 1] - pts[k - 2]);
+    if (s + d >= total / 2 && d > 0) {
+      const t = (total / 2 - s) / d;
+      return [pts[k - 3] + (pts[k] - pts[k - 3]) * t, pts[k - 2] + (pts[k + 1] - pts[k - 2]) * t];
+    }
+    s += d;
+  }
+  return [pts[0], pts[1]];
+}
+
+/** The pieces of track `ask` picks with the pointer on `edge` at local point `at` (its middle when absent): the edge
+ * first. */
+export function tracksAt(edge: number, at: [number, number] | null, ask: TrackAsk): number[] {
+  const w = world.peek(), pts = live.overlay?.renderer.net?.edgePts;
+  const e = w && bundled(w).ids.get(edge);
+  if (ask === "piece" || !w || !e?.bundle || !pts) return [edge];
+  const own = pts.get(edge);
+  if (!own || own.length < 6) return [edge];
+  // the place along the bundle: the point on the picked piece nearest the pointer
+  const [x, y] = at ? nearestPoint(own, at[0], at[1]) : middle(own);
+  const reach = LEVEL_WITH_M * kAtY(y);
+  const best = new Map<number, [number, number]>(); // slot -> [edge, distance]
+  for (const f of bundled(w).by.get(e.bundle) ?? []) {
+    if (f.slot === e.slot || f.crossover) continue;
+    const fp = pts.get(f.id);
+    if (!fp || fp.length < 6) continue;
+    const d = nearestPoint(fp, x, y)[2];
+    const was = best.get(f.slot ?? 0);
+    if (d <= reach && !(was && was[1] <= d)) best.set(f.slot ?? 0, [f.id, d]);
+  }
+  return [edge, ...[...best.values()].map((b) => b[0])];
+}
+
+/** `tracksAt` for a pick: only the pieces built as `edge` is, since a pick holds one kind (T-829), so the piece
+ * clicked always stays in it. */
+export function pickAt(edge: number, at: [number, number] | null, ask: TrackAsk = "whole"): number[] {
+  const out = tracksAt(edge, at, ask), ids = members.ids, built = ids.get(edge)?.built;
+  return out.filter((f) => f === edge || ids.get(f)?.built === built);
+}
+
+/** One track of a piece of double track, by its slot from the left looking a to b (TWT7's order, T-3957): 0 the left,
+ * 1 the right. Its way is the piece's (`game/oneTrack.ts` `trackDir`). */
+export interface OneTrack { edge: number; slot: 0 | 1 }
+
+/** The track of piece `edge` under the local point `at`: on double track the one on the pointer's side of its centre
+ * line; null for single track. */
+export function trackUnder(edge: number, at: [number, number] | null): OneTrack | null {
+  const w = world.peek(), e = w?.edges.find((x) => x.id === edge), pts = live.overlay?.renderer.net?.edgePts.get(edge);
+  if (!e || e.tracks !== 2 || e.crossover || !pts || pts.length < 6) return null;
+  const [x, y] = at ?? middle(pts);
+  let best = Infinity, left = true;
+  for (let k = 0; k + 5 < pts.length; k += 3) {
+    const x0 = pts[k], y0 = pts[k + 1], dx = pts[k + 3] - x0, dy = pts[k + 4] - y0, l2 = dx * dx + dy * dy;
+    if (!(l2 > 0)) continue;
+    const t = Math.max(0, Math.min(1, ((x - x0) * dx + (y - y0) * dy) / l2));
+    const d = (x0 + t * dx - x) ** 2 + (y0 + t * dy - y) ** 2;
+    // (local y runs south, so the left side looking along the piece has the cross product negative)
+    if (d < best) [best, left] = [d, dx * (y - y0) - dy * (x - x0) < 0];
+  }
+  return { edge, slot: left ? 0 : 1 };
+}
+
+/** A pick: its pieces, and `tracks` when it is narrowed to tracks of double track pieces, one each (one track by the
+ * second click, a traced track by a double click; then `edges` is those pieces). */
+export interface TrackPick { edges: number[]; tracks?: OneTrack[] }
+
+/** T-3957: what a double click on `edge` at `at` traces, given the pick `before` its first click: the track under the
+ * pointer, where that pick was already this place's whole or tracks narrowed to there (its first click narrows, so
+ * nothing waits on a timer); else null, for the run of whole track as before (T-1680). On single track it is its one
+ * track (`slot` null). */
+export function traceAt(before: TrackPick, edge: number, at: [number, number] | null): OneTrack | { edge: number; slot: null } | null {
+  const here = before.tracks ? before.edges.includes(edge) : before.edges.includes(edge) && sameSet(before.edges, pickAt(edge, at));
+  if (!here) return null;
+  return trackUnder(edge, at) ?? { edge, slot: null };
+}
+
+/** What a plain click on `edge` at `at` picks, given the pick `current`: the whole bundle there; a click on track
+ * already the whole pick narrows it to the one track under the pointer, on any count (her 11-21 call, T-3956), and a
+ * click on a pick narrowed so goes back to the whole. */
+export function clickTracks(current: TrackPick, edge: number, at: [number, number] | null): TrackPick {
+  const whole = pickAt(edge, at);
+  if (current.tracks || !sameSet(current.edges, whole)) return { edges: whole };
+  const track = trackUnder(edge, at);
+  return track ? { edges: [edge], tracks: [track] } : { edges: [edge] };
+}
+
+/** Whether a click on `edge` at `at` narrows the pick `current` (the whole there, holding more than one track). */
+export function narrowsAt(current: TrackPick, edge: number, at: [number, number] | null): boolean {
+  if (current.tracks || !current.edges.includes(edge) || !sameSet(current.edges, pickAt(edge, at))) return false;
+  return current.edges.length > 1 || trackUnder(edge, at) !== null;
+}
+
+const sameSet = (a: readonly number[], b: readonly number[]) => a.length === b.length && b.every((x) => a.includes(x));
+
+/** T-3950: the picked pieces in a bundle with a picked piece of another slot: those the pick holds as 4 tracks. */
+export function pairedIn(w: WorldView, edges: readonly number[]): Set<number> {
+  const picked = new Set(edges), out = new Set<number>();
+  const { by, ids } = bundled(w);
+  for (const id of edges) {
+    const e = ids.get(id);
+    if (!e?.bundle || e.crossover) continue;
+    if ((by.get(e.bundle) ?? []).some((f) => f.slot !== e.slot && picked.has(f.id))) out.add(id);
+  }
+  return out;
+}
