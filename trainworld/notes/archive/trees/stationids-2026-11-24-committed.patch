new file mode 100644
index 000000000..fdbd41579
--- /dev/null
+++ b/trainworld/sim/src/track/compile.rs
@@ -0,0 +1,524 @@
+//! The compile (T-3444 stage 3a1, notes/T-3444-design/01-model.md "The derived graph", 05-sim.md section 1): each
+//! piece is a bundle of its tracks, and the compile turns pieces and nodes into the graph the sim runs on, one track
+//! per derived edge. Each track has a stable id, its way, its offset from the piece's centre line and its partner;
+//! each track end at a node has its place across the node in metres; and each node holds the moves a train may make
+//! from one track end to another, and apart from them its turn moves (stage 3a2). Routing, line checks, capacity's
+//! keys and crossing tests, the flat-junction badge and the train guard all read it, so they agree by construction
+//! (as since T-3137).
+//!
+//! Stations are still nodes. A line path's entry names a piece, a track of it by key and a direction (`net::entry`,
+//! T-4033): `track_of` maps it to its track, `span_of` to the slot the save names (`TrackSpan`), `moves_from` and
+//! `turns_from` to the entries a train may take on through its node, which the route search walks.
+//!
+//! **Ids.** A piece's tracks take a block of ids (at least two) the first time it is compiled, kept with the piece's
+//! id while the piece lives, dies and comes back (an undo), and replaced only when the piece needs more tracks than
+//! its block holds. A network compiled from scratch (a load) numbers the blocks in piece order, the track running a
+//! to b first: the order of the old `edge * 2 + dir` keys, which capacity sorts by. An unrelated edit keeps every
+//! other id.
+
+use super::net::{entry, path_dir, path_edge, path_key, Join, Network, Ports, MAX_PORTS};
+use super::params::{END_GAP_M, TRACK_PITCH_M};
+
+/// Directions a track carries: a to b, b to a.
+pub const WAY_AB: u8 = 1;
+pub const WAY_BA: u8 = 2;
+
+/// `Network::node_unusable`: one-way track pointing into the node with no way on, and pointing
+/// out of it with no way in.
+pub const UNUSABLE_IN: u8 = 1;
+pub const UNUSABLE_OUT: u8 = 2;
+
+/// A derived track id. Never an index into a piece's arrays (`edge_len`, `edge_pieces`): `Track::piece` is.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord, Hash)]
+pub struct TrackId(pub u32);
+
+/// One track of a piece.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct Track {
+    /// The piece it is a track of; `u32::MAX` for an id no live piece uses.
+    pub piece: u32,
+    /// Its record's key in the piece (`TrackRec::key`).
+    pub key: u8,
+    /// `WAY_AB`, `WAY_BA` or both.
+    pub way: u8,
+    /// From the piece's centre line, m, positive to the left looking from a to b.
+    pub off: f32,
+    /// The track a return run uses (05-sim section 6): on double track the partner its record names (the piece's
+    /// other track), on single track itself where it runs both ways, else none. Partners never cross pieces, so
+    /// quad's two pairs keep their own.
+    pub partner: Option<TrackId>,
+    /// No move through the node starts or ends on it at the piece's end a, b (`Join::Loose`); its turns stay.
+    pub loose: [bool; 2],
+}
+
+const NO_TRACK: Track = Track { piece: u32::MAX, key: 0, way: 0, off: 0.0, partner: None, loose: [false; 2] };
+
+/// One track's end at a node.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct TrackEnd {
+    pub track: TrackId,
+    /// The piece end it belongs to, as an index into the node's `Ports`.
+    pub port: u8,
+    /// Trains run into the node on it, and out of the node on it.
+    pub arrive: bool,
+    pub leave: bool,
+    /// Across the node, m, positive to the left looking along the node's heading.
+    pub pos: f32,
+}
+
+/// A node's track ends and moves, compiled with its ports.
+#[derive(Clone, Debug, Default)]
+pub struct NodeTracks {
+    pub ends: Vec<TrackEnd>,
+    /// (arriving track end, leaving track end), indices into `ends`: a move a train may make without turning back.
+    pub moves: Vec<(u8, u8)>,
+    /// Turn moves (01-model "Node" 4, 05-sim section 3), apart from `moves` so crossing tests, badges and the
+    /// search's through moves never see them: (arriving track end, leaving track end) on the same side of the node.
+    /// At a station, every arriving end to every leaving end on its side (a line may reverse there onto another
+    /// branch, as it always could); at a bare end, each track to its partner. Nowhere else.
+    pub turns: Vec<(u8, u8)>,
+}
+
+/// The derived graph (`Network::dg`).
+#[derive(Clone, Debug, Default)]
+pub struct Compiled {
+    /// Per piece id: its block's first id and size, and how many tracks it has now (0 while dead).
+    block: Vec<(u32, u8, u8)>,
+    tracks: Vec<Track>,
+    nodes: Vec<NodeTracks>,
+}
+
+/// The way of the track in slot `slot` (from the left looking a to b) of a piece of `n >= 2` tracks whose record
+/// sets none (`TrackRec::way` 0): 01-model's default A B A B in doubles side by side from the right, each double's
+/// right track carrying a to b with right-hand running, and an odd last track (the leftmost) both ways.
+pub fn default_way(n: usize, slot: usize, right_hand: bool) -> u8 {
+    let (right, left) = if right_hand { (WAY_AB, WAY_BA) } else { (WAY_BA, WAY_AB) };
+    let s = n - 1 - slot;
+    if s + 1 == n && n % 2 == 1 {
+        WAY_AB | WAY_BA
+    } else if s % 2 == 0 {
+        right
+    } else {
+        left
+    }
+}
+
+/// The tracks of a piece whose slots run `ways` (from the left looking a to b), in id order (a to b first, then
+/// across from the right): the slot and the offset, 4 m apart about the centre line.
+fn layout(ways: &[u8]) -> Vec<(usize, f32)> {
+    let n = ways.len();
+    let mut slots: Vec<usize> = (0..n).rev().collect();
+    slots.sort_by_key(|&slot| ways[slot] & WAY_AB == 0);
+    slots.into_iter().map(|slot| (slot, (((n - 1 - slot) as f64 - (n as f64 - 1.0) / 2.0) * TRACK_PITCH_M) as f32)).collect()
+}
+
+/// T-3954: a stretch of a line's path in authored terms, as the save names it: the piece (one bundle per piece until
+/// stations stop splitting track, stage 4a), the slot of its track from the left looking a to b (TWT7's order of a
+/// bundle's tracks; None on a piece no longer there, a broken line's), and the direction. In memory an entry names
+/// the track by its key (`net::entry`); `Network::span_of` and `span_entry` are the one crossing between the two.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct TrackSpan {
+    pub piece: u32,
+    pub slot: Option<u8>,
+    pub dir: u8,
+}
+
+/// The slot (TWT7's order, from the left looking a to b) of the track a piece of `tracks` tracks, none of them with
+/// a way of its own, has running `dir`: single track's one track whichever way it runs, double track's right one
+/// carrying a to b with right-hand running (as `layout` lays them).
+pub fn span_slot(tracks: u8, right_hand: bool, dir: u8) -> Option<u8> {
+    match tracks {
+        1 => Some(0),
+        2 => Some(((dir == 0) == right_hand) as u8),
+        _ => None,
+    }
+}
+
+/// The ends set in a bit mask of `Ports` indices, ascending.
+pub fn ends_in(mask: u8) -> impl Iterator<Item = usize> {
+    (0..MAX_PORTS).filter(move |&k| mask >> k & 1 != 0)
+}
+
+impl Network {
+    // ---- tracks
+
+    /// The live tracks of piece `e`, in id order.
+    pub fn piece_tracks(&self, e: u32) -> impl Iterator<Item = TrackId> {
+        let (first, _, n) = self.dg.block.get(e as usize).copied().unwrap_or((0, 0, 0));
+        (first..first + n as u32).map(TrackId)
+    }
+
+    pub fn track(&self, t: TrackId) -> Track {
+        self.dg.tracks.get(t.0 as usize).copied().unwrap_or(NO_TRACK)
+    }
+
+    /// The size of the track id space (for tables indexed by track).
+    pub fn track_id_count(&self) -> usize {
+        self.dg.tracks.len()
+    }
+
+    /// Piece `e` is single track running one way.
+    pub fn one_way_single(&self, e: u32) -> bool {
+        let mut ts = self.piece_tracks(e);
+        matches!((ts.next(), ts.next()), (Some(t), None) if self.track(t).way != WAY_AB | WAY_BA)
+    }
+
+    /// The track a path entry runs on; None where its piece has no track of its key, or that track does not run its
+    /// way.
+    pub fn track_of(&self, p: u32) -> Option<TrackId> {
+        let want = if path_dir(p) == 0 { WAY_AB } else { WAY_BA };
+        let key = path_key(p);
+        self.piece_tracks(path_edge(p)).find(|&t| self.dg.tracks[t.0 as usize].key == key).filter(|t| self.dg.tracks[t.0 as usize].way & want != 0)
+    }
+
+    /// The entry of track `t` running `dir`.
+    pub fn track_entry(&self, t: TrackId, dir: u32) -> u32 {
+        let tr = self.track(t);
+        entry(tr.piece, tr.key, dir)
+    }
+
+    /// Each slot's way (`WAY_*`) on piece `e` from its records, as the compile lays them: a record's own way, else
+    /// single track's from `edge_way`, a bundle's from `default_way`.
+    pub fn slot_ways(&self, e: u32) -> Vec<u8> {
+        let recs = self.edge_recs[e as usize].recs();
+        let n = recs.len();
+        if n == 1 {
+            return vec![match self.edge_way(e) {
+                1 => WAY_AB,
+                2 => WAY_BA,
+                _ => WAY_AB | WAY_BA,
+            }];
+        }
+        recs.iter().enumerate().map(|(s, r)| if r.way != 0 { r.way } else { default_way(n, s, self.right_hand) }).collect()
+    }
+
+    /// Whether piece `e` is drawn track by track, each line and train on the track its path names (T-4034): more than
+    /// two tracks, or (T-4038) two running ways of their own. Other pieces draw as one stroke, trains keeping to their
+    /// side.
+    pub fn drawn_by_track(&self, e: u32) -> bool {
+        self.edge_ok(e) && (self.edge_tracks[e as usize] > 2 || self.edge_recs[e as usize].own_ways())
+    }
+
+    /// The entry running `dir` on piece `e` on the first track (in id order) that runs that way: how an entry that
+    /// names only a piece and a direction (old saves, the app's) is read. Key 0 where none runs it (a broken line's
+    /// entry on a dead piece, or against one-way single track).
+    pub fn entry_for(&self, e: u32, dir: u32) -> u32 {
+        if !self.edge_ok(e) {
+            return entry(e, 0, dir);
+        }
+        let want = if dir == 0 { WAY_AB } else { WAY_BA };
+        let ways = self.slot_ways(e);
+        let recs = self.edge_recs[e as usize].recs();
+        let key = layout(&ways).into_iter().find(|&(s, _)| ways[s] & want != 0).map_or(recs[0].key, |(s, _)| recs[s].key);
+        entry(e, key, dir)
+    }
+
+    /// Path entry `p` on the track of its piece that runs its way where the track it names no longer does (its key
+    /// gone, or the track laid again another way); None where it runs, or no track of its piece runs that way.
+    pub fn rekeyed(&self, p: u32) -> Option<u32> {
+        let e = path_edge(p);
+        if !self.edge_ok(e) || self.track_of(p).is_some() {
+            return None;
+        }
+        let q = self.entry_for(e, path_dir(p));
+        self.track_of(q).is_some().then_some(q)
+    }
+
+    /// T-3954 (05-sim section 6): the entry a return run takes for path entry `p` run backward: its track's partner,
+    /// the other way. None where the track has no partner (a one-way single) or the partner does not run that way.
+    pub fn partner_entry(&self, p: u32) -> Option<u32> {
+        let partner = self.track(self.track_of(p)?).partner?;
+        let q = self.track_entry(partner, 1 - path_dir(p));
+        (self.track_of(q) == Some(partner)).then_some(q)
+    }
+
+    /// Path entry `p`'s piece run the other way: on its partner where that runs so (`partner_entry`), else on the
+    /// first track that runs that way (`entry_for`; which may be none, so the entry does not run).
+    pub fn reverse_entry(&self, p: u32) -> u32 {
+        self.partner_entry(p).unwrap_or_else(|| self.entry_for(path_edge(p), 1 - path_dir(p)))
+    }
+
+    /// The entries leaving through port end code `c` (`edge << 1 | end`): one per track of its piece that runs
+    /// away from the node there.
+    pub fn port_entries(&self, c: u32) -> impl Iterator<Item = u32> + '_ {
+        let (e, which) = (c >> 1, c & 1);
+        let want = if which == 0 { WAY_AB } else { WAY_BA };
+        self.piece_tracks(e).filter(move |&t| self.track(t).way & want != 0).map(move |t| self.track_entry(t, which))
+    }
+
+    /// T-3954: a path entry as a span of the track it runs on, as the save names it (`TrackSpan`).
+    pub fn span_of(&self, p: u32) -> TrackSpan {
+        let e = path_edge(p);
+        let slot = if self.edge_ok(e) { self.edge_recs[e as usize].slot_of(path_key(p)) } else { None };
+        TrackSpan { piece: e, slot, dir: path_dir(p) as u8 }
+    }
+
+    /// A span as a path entry: the track in its slot (key 0 on a dead piece or a slot past the piece's tracks).
+    pub fn span_entry(&self, s: TrackSpan) -> u32 {
+        let key = s.slot.filter(|_| self.edge_ok(s.piece)).and_then(|k| self.edge_recs[s.piece as usize].recs().get(k as usize)).map_or(0, |r| r.key);
+        entry(s.piece, key, s.dir as u32)
+    }
+
+    /// Piece `e`'s tracks again (an edit touched it, or the way of its single track changed). Its ids stay where its
+    /// track count fits its block.
+    pub(super) fn compile_piece(&mut self, e: u32) {
+        let i = e as usize;
+        if self.dg.block.len() <= i {
+            self.dg.block.resize(i + 1, (0, 0, 0));
+        }
+        let n = if self.edge_ok(e) { self.edge_tracks[i] as usize } else { 0 };
+        let (mut first, mut size, _) = self.dg.block[i];
+        if n > size as usize {
+            for t in first..first + size as u32 {
+                self.dg.tracks[t as usize] = NO_TRACK;
+            }
+            // at least two, so single track doubled keeps its block
+            first = self.dg.tracks.len() as u32;
+            size = n.max(2) as u8;
+            self.dg.tracks.resize(self.dg.tracks.len() + size as usize, NO_TRACK);
+        }
+        let ways = if n == 0 { vec![] } else { self.slot_ways(e) };
+        let tracks = layout(&ways);
+        let recs = self.edge_recs[i].recs().to_vec();
+        // the id of the track in slot `s`
+        let id_at = |s: usize| tracks.iter().position(|t| t.0 == s).map(|k| TrackId(first + k as u32));
+        for k in 0..size as usize {
+            self.dg.tracks[first as usize + k] = match tracks.get(k) {
+                Some(&(slot, off)) => {
+                    let (r, way) = (recs[slot], ways[slot]);
+                    // single track pairs with itself where it runs both ways, whatever its record says
+                    let partner = if n == 1 { (way == WAY_AB | WAY_BA).then_some(TrackId(first)) } else { r.partner.and_then(|p| recs.iter().position(|q| q.key == p)).and_then(id_at) };
+                    Track { piece: e, key: r.key, way, off, partner, loose: r.join.map(|j| j == Join::Loose) }
+                }
+                None => NO_TRACK,
+            };
+        }
+        self.dg.block[i] = (first, size, n as u8);
+    }
+
+    // ---- nodes
+
+    pub fn node_compiled(&self, n: u32) -> &NodeTracks {
+        static NONE: NodeTracks = NodeTracks { ends: vec![], moves: vec![], turns: vec![] };
+        self.dg.nodes.get(n as usize).unwrap_or(&NONE)
+    }
+
+    /// The width of piece `e`'s tracks, centre to centre of the outer two (0 for single track).
+    fn piece_width(&self, e: u32) -> f64 {
+        let offs = self.piece_tracks(e).map(|t| self.track(t).off as f64);
+        let (lo, hi) = offs.fold((f64::INFINITY, f64::NEG_INFINITY), |(lo, hi), o| (lo.min(o), hi.max(o)));
+        if lo.is_finite() { hi - lo } else { 0.0 }
+    }
+
+    /// Node `n`'s track ends and moves from its ports (`derive_node`: sides, ranks) and its pieces' tracks. Piece
+    /// ends on one side sit in rank order, neighbours half their widths plus `END_GAP_M` apart (05-sim "Node
+    /// positions": two doubles 8 m, so a quad's ends never interleave with a neighbour's), and each track end lies at
+    /// its track's offset from its piece end's place. A move runs from a track bringing trains in to a track taking
+    /// them out through an end on the node's other side.
+    pub(super) fn compile_node(&mut self, n: u32) {
+        let i = n as usize;
+        if self.dg.nodes.len() <= i {
+            self.dg.nodes.resize(i + 1, NodeTracks::default());
+        }
+        let p: Ports = self.node_ports[i];
+        let k = if self.node_ok(n) { p.n as usize } else { 0 };
+        let mut place = [0.0f64; MAX_PORTS];
+        for side in 0..2u8 {
+            let mut idx: Vec<usize> = (0..k).filter(|&j| p.side[j] == side).collect();
+            idx.sort_by_key(|&j| p.rank[j]);
+            let mut at = 0.0;
+            for (r, &j) in idx.iter().enumerate() {
+                if r > 0 {
+                    let w = |q: usize| self.piece_width(p.end[q] >> 1);
+                    at += (w(idx[r - 1]) + w(j)) / 2.0 + END_GAP_M;
+                }
+                place[j] = at;
+            }
+        }
+        let mut nt = NodeTracks::default();
+        for j in 0..k {
+            let c = p.end[j];
+            // a piece runs a to b outward from its end a, and an end on side 1 leaves along the heading: the
+            // track's offset as seen along the heading
+            let sign = if (c & 1 == 0) == (p.side[j] == 1) { 1.0 } else { -1.0 };
+            // trains leave the node through end a on a track running a to b
+            let (out, inn) = if c & 1 == 0 { (WAY_AB, WAY_BA) } else { (WAY_BA, WAY_AB) };
+            for t in self.piece_tracks(c >> 1) {
+                let tr = self.track(t);
+                nt.ends.push(TrackEnd { track: t, port: j as u8, arrive: tr.way & inn != 0, leave: tr.way & out != 0, pos: (place[j] + sign * tr.off as f64) as f32 });
+            }
+        }
+        let station = k > 0 && self.platform_len(i as u32) > 0;
+        let bare = k > 0 && !station && self.turn_end(n);
+        let loose = |x: &TrackEnd| self.track(x.track).loose[(p.end[x.port as usize] & 1) as usize];
+        // 01-model "Node" 1: where two pieces of one count meet end to end, slot i carries on as slot i. `Auto`'s
+        // "every track across whose way fits" says the same while each way has one track a piece; where a way has
+        // more, it would make every such joint a crossover, so there the slots decide
+        let continues = k == 2 && p.side[0] != p.side[1] && {
+            let (e0, e1) = (p.end[0] >> 1, p.end[1] >> 1);
+            let (r0, r1) = (&self.edge_recs[e0 as usize], &self.edge_recs[e1 as usize]);
+            e0 != e1 && r0.n() == r1.n() && (r0.shares_a_way(self.right_hand) || r1.shares_a_way(self.right_hand))
+        };
+        let slot = |x: &TrackEnd| {
+            let tr = self.track(x.track);
+            self.edge_recs[tr.piece as usize].slot_of(tr.key).unwrap_or(0)
+        };
+        // slot i of one meets slot i of the other where both run on the same way through the node (one leaves by
+        // its end b, the other by its end a), else slot n - 1 - i
+        let carries_on = |x: &TrackEnd, y: &TrackEnd| {
+            let (cx, cy) = (p.end[x.port as usize], p.end[y.port as usize]);
+            let n = self.edge_recs[(cx >> 1) as usize].n();
+            slot(y) == if cx & 1 != cy & 1 { slot(x) } else { n - 1 - slot(x) }
+        };
+        for (a, x) in nt.ends.iter().enumerate() {
+            for (b, y) in nt.ends.iter().enumerate() {
+                if !(x.arrive && y.leave) {
+                    continue;
+                }
+                if p.side[x.port as usize] != p.side[y.port as usize] {
+                    if loose(x) || loose(y) || (continues && !carries_on(x, y)) {
+                        continue;
+                    }
+                    nt.moves.push((a as u8, b as u8));
+                } else if station || (bare && x.port == y.port && self.track(x.track).partner == Some(y.track)) {
+                    nt.turns.push((a as u8, b as u8));
+                }
+            }
+        }
+        self.dg.nodes[i] = nt;
+    }
+
+    /// Takes the moves between ends `i` and `j` of node `n` out of its table, both ways (a test of what reads it).
+    #[cfg(test)]
+    pub(crate) fn drop_moves(&mut self, n: u32, i: usize, j: usize) {
+        let nt = &mut self.dg.nodes[n as usize];
+        let ends = nt.ends.clone();
+        let between = |a: u8, b: u8| {
+            let (x, y) = (ends[a as usize].port as usize, ends[b as usize].port as usize);
+            (x, y) == (i, j) || (x, y) == (j, i)
+        };
+        nt.moves.retain(|&(a, b)| !between(a, b));
+    }
+
+    /// Takes node `n`'s turn moves out of its table (a test of what reads them).
+    #[cfg(test)]
+    pub(crate) fn drop_turns(&mut self, n: u32) {
+        let nt = &mut self.dg.nodes[n as usize];
+        nt.turns.clear();
+    }
+
+    /// The track end of path entry `p` at node `n`: arriving there (`arrive`) or leaving.
+    fn end_of(&self, n: u32, p: u32, arrive: bool) -> Option<&TrackEnd> {
+        self.end_index(n, p, arrive).map(|k| &self.node_compiled(n).ends[k])
+    }
+
+    /// `end_of`'s index into the node's `ends`.
+    fn end_index(&self, n: u32, p: u32, arrive: bool) -> Option<usize> {
+        let t = self.track_of(p)?;
+        let port = self.node_ports[n as usize].find(path_edge(p), if arrive { 1 - path_dir(p) } else { path_dir(p) })?;
+        self.node_compiled(n).ends.iter().position(|x| x.track == t && x.port as usize == port)
+    }
+
+    /// The node a path entry arrives at and the index there of the piece end it arrives by.
+    pub fn arrive_at(&self, p: u32) -> (u32, Option<usize>) {
+        let (_, node) = self.path_nodes(p);
+        (node, self.node_ports[node as usize].find(path_edge(p), 1 - path_dir(p)))
+    }
+
+    /// The entries a train arriving on path entry `p` may run on into through its node without turning back (the
+    /// node's moves from its track end), with the index of the piece end each leaves by.
+    pub fn moves_from(&self, p: u32) -> impl Iterator<Item = (u32, usize)> + '_ {
+        self.track_of(p).into_iter().flat_map(move |t| self.table_from(p, t, false)).map(|(q, k, _)| (q, k))
+    }
+
+    /// The entries a train arriving on path entry `p` may turn back onto at its node (the node's turn moves).
+    pub fn turns_from(&self, p: u32) -> impl Iterator<Item = (u32, usize)> + '_ {
+        self.track_of(p).into_iter().flat_map(move |t| self.table_from(p, t, true)).map(|(q, k, _)| (q, k))
+    }
+
+    /// `moves_from` (`turns`: `turns_from`) for entry `p` on track `t`, with each entry's track.
+    pub(super) fn table_from(&self, p: u32, t: TrackId, turns: bool) -> impl Iterator<Item = (u32, usize, TrackId)> + '_ {
+        let (node, port) = self.arrive_at(p);
+        let nt = self.node_compiled(node);
+        let from = port.and_then(|port| nt.ends.iter().position(|x| x.track == t && x.port as usize == port));
+        let ports = &self.node_ports[node as usize];
+        let table = if turns { &nt.turns } else { &nt.moves };
+        table.iter().filter(move |m| Some(m.0 as usize) == from).map(move |&(_, b)| {
+            let y = &nt.ends[b as usize];
+            // a train leaves through end a on the track's a to b way
+            (self.track_entry(y.track, ports.end[y.port as usize] & 1), y.port as usize, y.track)
+        })
+    }
+
+    /// Whether a train may run on from path entry `p` into `q` through their node without turning
+    /// back.
+    pub fn move_ok(&self, p: u32, q: u32) -> bool {
+        self.moves_from(p).any(|(x, _)| x == q)
+    }
+
+    /// Whether a train may turn back from path entry `p` into `q` at their node: a turn move the node's table holds.
+    pub fn turn_ok(&self, p: u32, q: u32) -> bool {
+        self.turns_from(p).any(|(x, _)| x == q)
+    }
+
+    /// Whether any track of node `n` runs through it from its piece end `i` to its piece end `j`.
+    pub fn port_moves(&self, n: u32, i: usize, j: usize) -> bool {
+        let nt = self.node_compiled(n);
+        nt.moves.iter().any(|&(a, b)| nt.ends[a as usize].port as usize == i && nt.ends[b as usize].port as usize == j)
+    }
+
+    /// The crossing rule's positions of the move from path entry `p` into `q` at node `n`: its track's place on the
+    /// node's side 0, then on side 1. Two moves cross at the node when `(a1 - a2)(b1 - b2) < 0`.
+    pub fn move_at(&self, n: u32, p: u32, q: u32) -> (f64, f64) {
+        let a = self.end_of(n, p, true).map_or(0.0, |x| x.pos as f64);
+        let b = self.end_of(n, q, false).map_or(0.0, |x| x.pos as f64);
+        let side_in = self.node_ports[n as usize].find(path_edge(p), 1 - path_dir(p)).map_or(0, |i| self.node_ports[n as usize].side[i]);
+        if side_in == 0 { (a, b) } else { (b, a) }
+    }
+
+    /// Every move through node `n` as the crossing rule's positions (`move_at`).
+    pub fn node_move_places(&self, n: u32) -> Vec<(f64, f64)> {
+        let p = &self.node_ports[n as usize];
+        let nt = self.node_compiled(n);
+        nt.moves
+            .iter()
+            .map(|&(a, b)| {
+                let (x, y) = (&nt.ends[a as usize], &nt.ends[b as usize]);
+                if p.side[x.port as usize] == 0 { (x.pos as f64, y.pos as f64) } else { (y.pos as f64, x.pos as f64) }
+            })
+            .collect()
+    }
+
+    /// The ends of node `n` on the other side from end `i`: those its tracks connect to, whichever way they run.
+    pub fn port_links(&self, n: u32, i: usize) -> u8 {
+        let p = &self.node_ports[n as usize];
+        (0..p.n as usize).filter(|&j| p.side[j] != p.side[i]).fold(0, |m, j| m | 1 << j)
+    }
+
+    /// T-3164: one-way single track at node `n` that no train can use, from its moves. Bit `UNUSABLE_IN`: an end whose
+    /// track brings trains in with no move on (one-way pieces pointing into each other); bit `UNUSABLE_OUT`: an end
+    /// whose track takes trains out that no move reaches (pointing away from each other). A bare end (a stub still
+    /// being drawn) and a station (a line may end there) say nothing.
+    pub fn node_unusable(&self, n: u32) -> u8 {
+        let i = n as usize;
+        let p = &self.node_ports[i];
+        if p.n < 2 || self.platform_len(i as u32) > 0 {
+            return 0;
+        }
+        let nt = self.node_compiled(n);
+        let mut out = 0;
+        for (k, x) in nt.ends.iter().enumerate() {
+            let e = p.end[x.port as usize] >> 1;
+            if self.edge_crossover[e as usize] || !self.one_way_single(e) {
+                continue;
+            }
+            if x.arrive && !nt.moves.iter().any(|m| m.0 as usize == k) {
+                out |= UNUSABLE_IN;
+            }
+            if x.leave && !nt.moves.iter().any(|m| m.1 as usize == k) {
+                out |= UNUSABLE_OUT;
+            }
+        }
+        out
+    }
+}
diff --git a/trainworld/sim/src/track/complexes.rs b/trainworld/sim/src/track/complexes.rs
new file mode 100644
index 000000000..d0048f2dc
--- /dev/null
+++ b/trainworld/sim/src/track/complexes.rs
@@ -0,0 +1,221 @@
+//! Station complexes (T-146, T-161, T-197, T-1859, T-2217): stations whose centres are within `MERGE_M`, whose
+//! platforms come within `PLATFORM_GAP_M`, that the player linked, or whose platforms touch one station building,
+//! directly or through others (single linkage). Levels are ignored. The one rule: demand's snapshot reads the
+//! partition (`complexes`, `TrackApi::demand_stations`, T-3962) and `complex_of` walks the same pairs. The app's
+//! game/complexes.ts keeps the rule for the map's complex views, which have no track model at hand.
+
+use super::building::{self, platform_line, seg_gap};
+use super::net::Network;
+
+type P = [f64; 2];
+
+/// Platforms (centre lines) this close are one complex, ground m (game/complexes.ts `PLATFORM_GAP_M`).
+pub const PLATFORM_GAP_M: f64 = 50.0;
+/// Stations whose centres are this close are one complex, ground m: the demand kernel's 100 m merge, so a complex
+/// is always whole demand stations (game/complexes.ts `DEMAND_MERGE_M`).
+pub const MERGE_M: f64 = 100.0;
+
+/// The partition of some stations into complexes.
+pub struct Complexes {
+    /// The stations, in node order.
+    pub stations: Vec<u32>,
+    /// Each one's complex, numbered by its first station in `stations` (as game/complexes.ts `buildComplexes`, so
+    /// demand's packed `complex` is the app's byte for byte).
+    pub of: Vec<u32>,
+}
+
+/// A station's platform as the rule reads it: its drawn centre line and the straight segment of its length along
+/// its heading through the node (the rule before T-1859, kept so no complex it made splits).
+pub(crate) struct Shape {
+    n: u32,
+    x: f64,
+    y: f64,
+    straight: [P; 2],
+    /// the farthest either reaches from the node, plane units
+    reach: f64,
+    /// the drawn line, worked out only once a pair is near enough to need it
+    line: std::cell::OnceCell<Vec<P>>,
+}
+
+/// Shortest distance between two polylines (a lone point is a stretch of no length).
+pub(crate) fn polyline_gap(a: &[P], b: &[P]) -> f64 {
+    let seg = |p: &[P], i: usize| if p.len() < 2 { (p[i], p[i]) } else { (p[i], p[i + 1]) };
+    let (na, nb) = (a.len().saturating_sub(1).max(1).min(a.len()), b.len().saturating_sub(1).max(1).min(b.len()));
+    let mut best = f64::INFINITY;
+    for i in 0..na {
+        let (p0, p1) = seg(a, i);
+        for j in 0..nb {
+            let (q0, q1) = seg(b, j);
+            best = best.min(seg_gap(p0, p1, q0, q1));
+        }
+    }
+    best
+}
+
+impl Network {
+    pub(crate) fn complex_shape(&self, n: u32) -> Shape {
+        let i = n as usize;
+        let (x, y) = (self.node_x[i], self.node_y[i]);
+        // the straight segment at the station's own scale, as the app's `straightOffsets`
+        let h = self.platform_len(n) as f64 / 2.0 * self.k_at(y);
+        let (dx, dy) = (self.node_heading[i].cos() * h, self.node_heading[i].sin() * h);
+        // a line runs half its length each way through the node, or its whole length from a dead end (1% for the
+        // scale changing along it)
+        let reach = if self.node_ports[i].ends().len() == 1 { 2.0 * h } else { h } * 1.01;
+        Shape { n, x, y, straight: [[x - dx, y - dy], [x + dx, y + dy]], reach, line: std::cell::OnceCell::new() }
+    }
+
+    fn shape_line<'a>(&self, s: &'a Shape) -> &'a [P] {
+        s.line.get_or_init(|| platform_line(self, s.n))
+    }
+
+    /// Whether two stations are one complex by distance: centres within `MERGE_M`, or platforms, drawn or straight,
+    /// within `PLATFORM_GAP_M`, at the mean of their scales (game/complexes.ts `nearEnough`).
+    pub(crate) fn near_shapes(&self, a: &Shape, b: &Shape) -> bool {
+        let k = (self.k_at(a.y) + self.k_at(b.y)) / 2.0;
+        let d = (a.x - b.x).hypot(a.y - b.y);
+        if d <= MERGE_M * k {
+            return true;
+        }
+        if d > a.reach + b.reach + PLATFORM_GAP_M * k {
+            return false;
+        }
+        polyline_gap(&a.straight, &b.straight) <= PLATFORM_GAP_M * k || polyline_gap(self.shape_line(a), self.shape_line(b)) <= PLATFORM_GAP_M * k
+    }
+
+    /// The complexes of the stations `keep` admits (of `is_station`), with the player's links and the station
+    /// buildings among them.
+    pub fn complexes(&self, keep: impl Fn(u32) -> bool) -> Complexes {
+        let stations: Vec<u32> = (0..self.node_count() as u32).filter(|&m| self.is_station(m) && keep(m)).collect();
+        let n = stations.len();
+        let shapes: Vec<Shape> = stations.iter().map(|&m| self.complex_shape(m)).collect();
+        let mut parent: Vec<usize> = (0..n).collect();
+        fn find(p: &mut [usize], mut i: usize) -> usize {
+            while p[i] != i {
+                p[i] = p[p[i]];
+                i = p[i];
+            }
+            i
+        }
+        let join = |p: &mut Vec<usize>, i: usize, j: usize| {
+            let (a, b) = (find(p, i), find(p, j));
+            if a != b {
+                p[a.max(b)] = a.min(b);
+            }
+        };
+        // a grid as wide as the farthest two linked centres can be: candidates in the 3 x 3 block
+        let mut cell = 0f64;
+        for s in &shapes {
+            let k = self.k_at(s.y);
+            cell = cell.max(MERGE_M * k).max(2.0 * s.reach + PLATFORM_GAP_M * k);
+        }
+        if n > 0 && cell > 0.0 {
+            let key = |s: &Shape| ((s.x / cell).floor() as i64, (s.y / cell).floor() as i64);
+            let mut grid: std::collections::HashMap<(i64, i64), Vec<usize>> = std::collections::HashMap::new();
+            for (i, s) in shapes.iter().enumerate() {
+                grid.entry(key(s)).or_default().push(i);
+            }
+            for i in 0..n {
+                let (cx, cy) = key(&shapes[i]);
+                for gx in cx - 1..=cx + 1 {
+                    for gy in cy - 1..=cy + 1 {
+                        for &j in grid.get(&(gx, gy)).map_or(&[][..], |v| &v[..]) {
+                            if j > i && self.near_shapes(&shapes[i], &shapes[j]) {
+                                join(&mut parent, i, j);
+                            }
+                        }
+                    }
+                }
+            }
+        }
+        let at = |m: u32| stations.binary_search(&m).ok();
+        for [p, q] in self.links_live() {
+            if let (Some(i), Some(j)) = (at(p), at(q)) {
+                join(&mut parent, i, j);
+            }
+        }
+        for b in self.buildings.iter().flatten() {
+            let mut first = None;
+            for m in building::members(self, &b.corners) {
+                if let Some(j) = at(m) {
+                    match first {
+                        None => first = Some(j),
+                        Some(i) => join(&mut parent, i, j),
+                    }
+                }
+            }
+        }
+        let (mut of, mut index) = (Vec::with_capacity(n), vec![u32::MAX; n]);
+        let mut next = 0;
+        for i in 0..n {
+            let r = find(&mut parent, i);
+            if index[r] == u32::MAX {
+                index[r] = next;
+                next += 1;
+            }
+            of.push(index[r]);
+        }
+        Complexes { stations, of }
+    }
+
+    /// The stations of station `n`'s complex among every station (blueprints too), `n` first: the pairs
+    /// `complexes` joins, walked out from `n`.
+    pub fn complex_of(&self, n: u32) -> Vec<u32> {
+        if !self.is_station(n) {
+            return vec![];
+        }
+        let stations: Vec<u32> = (0..self.node_count() as u32).filter(|&m| self.is_station(m)).collect();
+        let shapes: Vec<Shape> = stations.iter().map(|&m| self.complex_shape(m)).collect();
+        let at = |m: u32| stations.binary_search(&m).unwrap();
+        let halls: Vec<(&[P], [f64; 4])> = self
+            .buildings
+            .iter()
+            .flatten()
+            .filter(|b| b.corners.len() >= 3)
+            .map(|b| {
+                let c = &b.corners[..];
+                (c, c.iter().fold([f64::INFINITY, f64::INFINITY, f64::NEG_INFINITY, f64::NEG_INFINITY], |r, p| [r[0].min(p[0]), r[1].min(p[1]), r[2].max(p[0]), r[3].max(p[1])]))
+            })
+            .collect();
+        let mut hall_members: Vec<Option<Vec<u32>>> = vec![None; halls.len()];
+        let links: Vec<[u32; 2]> = self.links_live().collect();
+        let mut out = vec![n];
+        let mut k = 0;
+        while k < out.len() {
+            let a = out[k];
+            k += 1;
+            let add = |m: u32, out: &mut Vec<u32>| {
+                if !out.contains(&m) {
+                    out.push(m);
+                }
+            };
+            for &[p, q] in &links {
+                if p == a {
+                    add(q, &mut out);
+                } else if q == a {
+                    add(p, &mut out);
+                }
+            }
+            let (x, y) = (self.node_x[a as usize], self.node_y[a as usize]);
+            let r = (self.platform_len(a) as f64 * 1.5 + building::TOUCH_M) * self.k_at(y);
+            for (h, &(c, b)) in halls.iter().enumerate() {
+                if x < b[0] - r || x > b[2] + r || y < b[1] - r || y > b[3] + r {
+                    continue;
+                }
+                let got = hall_members[h].get_or_insert_with(|| building::members(self, c));
+                if got.contains(&a) {
+                    for &m in got.iter() {
+                        add(m, &mut out);
+                    }
+                }
+            }
+            let sa = &shapes[at(a)];
+            for (j, &m) in stations.iter().enumerate() {
+                if !out.contains(&m) && self.near_shapes(sa, &shapes[j]) {
+                    out.push(m);
+                }
+            }
+        }
+        out
+    }
+}
