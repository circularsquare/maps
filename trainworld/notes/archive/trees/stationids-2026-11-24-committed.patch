+// T-3956 (track rework stage 3e): the tracks of one place along a bundle, as the selection bar's track picture and the
+// track panel show them. A piece of double track holds two: by the running side the left one looking from a to b
+// carries trains b to a with right-hand running (the sim's `compile::default_way`), unless it runs ways of its own.
+
+import type { TrackEdge, WorldView } from "./types";
+import { rightHand } from "./world";
+import type { OneTrack } from "../map/trackPick";
+
+/** A compass word for a way along a piece: where trains running a to b (`dir` 0) or b to a head, by its ends. */
+export type Bound = "east" | "west" | "north" | "south";
+
+/** The compass word of heading `h` (rad, counter-clockwise from east), the nearest of the four. */
+export function compass(h: number): Bound {
+  const a = ((h % (2 * Math.PI)) + 2 * Math.PI) % (2 * Math.PI);
+  return a < Math.PI / 4 || a >= 7 * Math.PI / 4 ? "east" : a < 3 * Math.PI / 4 ? "north" : a < 5 * Math.PI / 4 ? "west" : "south";
+}
+
+/** One track at the place: its piece, its slot there (from the left looking a to b; null on single track), the way it
+ * runs on it (null: both ways), and where it lies across. */
+export interface PlaceTrack { edge: number; slot: 0 | 1 | null; dir: 0 | 1 | null; across: number }
+
+/** The way track `slot` of double track piece `e` runs: 0 a to b, 1 b to a, null both ways. Its own where the piece
+ * runs ways of its own (T-4038, `TrackEdge.ways`); else with right-hand running the left one (slot 0) carries trains
+ * b to a. */
+export function trackDir(e: TrackEdge, slot: 0 | 1): 0 | 1 | null {
+  const own = e.ways?.[slot];
+  if (own) return own === 1 ? 0 : own === 2 ? 1 : null;
+  return (slot === 0) === rightHand.peek() ? 1 : 0;
+}
+
+/** T-4038: the way (`TrackApi::set_tracks_way`: 1 a to b, 2 b to a) track `slot` of double track piece `e` runs by the
+ * running side. */
+export function defaultWay(slot: 0 | 1): 1 | 2 {
+  return (slot === 0) === rightHand.peek() ? 2 : 1;
+}
+
+/** Where trains on piece `e` running `dir` head, east or west unless the piece runs more north-south. */
+export function boundOf(w: WorldView, e: TrackEdge, dir: 0 | 1): Bound {
+  const a = w.nodes.get(dir === 0 ? e.a : e.b), b = w.nodes.get(dir === 0 ? e.b : e.a);
+  if (!a || !b) return "east";
+  const east = (b.lng - a.lng) * Math.cos((a.lat * Math.PI) / 180), north = b.lat - a.lat;
+  return Math.abs(east) >= Math.abs(north) ? (east >= 0 ? "east" : "west") : north >= 0 ? "north" : "south";
+}
+
+/** The tracks of `edges` (the pieces of one place, the first the reference), ordered from the north side (west for
+ * north-south track) across, each piece's tracks 2 m either side of its line and the pieces where their middles lie. */
+export function placeTracks(w: WorldView, edges: readonly number[]): PlaceTrack[] {
+  const rows = edges.map((id) => w.edges.find((e) => e.id === id)).filter((e): e is TrackEdge => !!e && !e.crossover);
+  const ref = rows[0];
+  if (!ref) return [];
+  const mid = (e: TrackEdge) => {
+    const a = w.nodes.get(e.a)!, b = w.nodes.get(e.b)!;
+    return { x: ((a.lng + b.lng) / 2) * Math.cos((a.lat * Math.PI) / 180), y: (a.lat + b.lat) / 2, dx: (b.lng - a.lng) * Math.cos((a.lat * Math.PI) / 180), dy: b.lat - a.lat };
+  };
+  const r = mid(ref), rl = Math.hypot(r.dx, r.dy) || 1;
+  // looking along the reference's a to b, the left side is north when it heads east (west when it heads north)
+  const leftUp = boundOf(w, ref, 0) === "east" || boundOf(w, ref, 0) === "north";
+  const out: PlaceTrack[] = [];
+  for (const e of rows) {
+    const m = mid(e);
+    // its offset to the reference's left, metres (a degree of latitude is 111 km)
+    const lateral = ((r.dx * (m.y - r.y) - r.dy * (m.x - r.x)) / rl) * 111_320;
+    const same = r.dx * m.dx + r.dy * m.dy >= 0;
+    if (e.tracks === 1) out.push({ edge: e.id, slot: null, dir: e.oneWay ? (e.oneWay === 1 ? 0 : 1) : null, across: lateral });
+    // the piece's left track (slot 0) 2 m to its left looking a to b
+    else out.push({ edge: e.id, slot: 0, dir: trackDir(e, 0), across: lateral + (same ? 2 : -2) }, { edge: e.id, slot: 1, dir: trackDir(e, 1), across: lateral + (same ? -2 : 2) });
+  }
+  out.sort((p, q) => (leftUp ? q.across - p.across : p.across - q.across));
+  return out;
+}
+
+/** Whether `t` is a track picked: on a pick narrowed to tracks (`tracks`) one of them, else any track of a picked piece. */
+export function isPicked(t: PlaceTrack, tracks: readonly OneTrack[] | null, edges: readonly number[]): boolean {
+  return tracks ? tracks.some((o) => o.edge === t.edge && o.slot === t.slot) : edges.includes(t.edge);
+}
