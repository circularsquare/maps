+/// A piece's PIs and drawn-through points (`pis_out`); `thru` from its flags.
+fn pis_in(r: &mut R, net: &Network, a: usize, thru: bool, cap: usize) -> Result<(Vec<Pi>, Vec<Pi>), String> {
+    let n = r.u()? as usize;
+    let (mut px, mut py) = (net.node_x[a], net.node_y[a]);
+    let mut pis = Vec::with_capacity(n.min(cap));
+    for _ in 0..n {
+        let (x, y) = (quant(px + r.mm()?), quant(py + r.mm()?));
+        (px, py) = (x, y);
+        let radius = r.u()? as f64 * QUANT;
+        let level = r.i()? as i8;
+        pis.push(Pi { x, y, radius, level });
+    }
+    let mut points = vec![];
+    if thru {
+        let (mut px, mut py) = (net.node_x[a], net.node_y[a]);
+        for _ in 0..r.u()? {
+            let (x, y) = (quant(px + r.mm()?), quant(py + r.mm()?));
+            (px, py) = (x, y);
+            points.push(Pi { x, y, radius: 0.0, level: r.i()? as i8 });
+        }
+    }
+    Ok((pis, points))
+}
