+#[test]
+fn t4032_cut_ids_kept_by_edit_and_undo() {
+    let (_, mut w, e, _) = twins(false, true);
+    let before = exact(&w);
+    let parts: Vec<u32> = w.net.d_of_piece(e).collect();
+    // an edit of the cut piece itself (its speed limit) and its undo: the piece is derived again twice
+    let mut d = w.net.edge_data(e).unwrap();
+    d.limit = 80;
+    w.apply(Op::Edge { id: e, data: Some(d) }).unwrap();
+    assert_eq!(w.net.d_of_piece(e).collect::<Vec<_>>(), parts);
+    assert_ne!(exact(&w), before, "the edit changed nothing");
+    w.undo().unwrap().unwrap();
+    assert_eq!(w.net.d_of_piece(e).collect::<Vec<_>>(), parts);
+    assert_eq!(exact(&w), before);
+    // a new piece takes track ids of its own, below the extra ids, and its undo leaves the cut's as they were
+    let (p, q) = (node(&mut w, 0.0, -3000.0, 0), node(&mut w, 3000.0, -3000.0, 0));
+    let f = edge(&mut w, p, q, &[], 0).unwrap();
+    let fresh: Vec<u32> = w.net.d_of_piece(f).collect();
+    assert!(!fresh.is_empty() && fresh.iter().all(|&d| d < EXTRA_BASE && !parts.contains(&d)), "{fresh:?} {parts:?}");
+    for _ in 0..3 {
+        w.undo().unwrap().unwrap();
+    }
+    assert_eq!(w.net.d_of_piece(e).collect::<Vec<_>>(), parts);
+    assert_eq!(exact(&w), before);
+}
