+/// Quad: the pair beside shows with no station until one is placed there, then as the twin.
+#[test]
+fn quad_station_and_its_twin() {
+    let (mut a, [_, mid, _]) = run(4);
+    let (_, g) = picture(&a, mid);
+    assert_eq!(g.len(), 2, "{g:?}");
+    let other = g.iter().find(|x| x.0 != mid as f64).unwrap();
+    assert_eq!((other.0, other.1 > 0.0, other.2.len()), (-1.0, true, 2));
+    assert!(other.2.iter().all(|r| r.1 < 0.0));
+    let v = a.station_picture(mid);
+    // place a station where the picture says, on the track of the first row
+    let mut k = 2;
+    let mut at = None;
+    for _ in 0..v[1] as usize {
+        let (st, kind, id, rows) = (v[k], v[k + 1], v[k + 2], v[k + 4] as usize);
+        if st < 0.0 {
+            at = Some((kind as u32, id, v[k + 5 + 4], v[k + 5 + 5]));
+        }
+        k += 5;
+        for _ in 0..rows {
+            k += 8 + v[k + 7] as usize;
+        }
+    }
+    let (kind, id, x, y) = at.unwrap();
+    a.set_station_one(&[x, y]);
+    assert_eq!(a.add_station(kind, id as u32, x, y, 200, String::new()), 0, "{}", a.issues());
+    a.set_station_one(&[]);
+    let (_, g) = picture(&a, mid);
+    assert_eq!(g.len(), 2);
+    let twin = g.iter().find(|x| x.0 != mid as f64).unwrap();
+    assert!(twin.0 >= 0.0 && twin.1 == 0.0, "a station by its axis: {g:?}");
+    assert_eq!(a.w.net.station_name(twin.0 as u32), a.w.net.station_name(mid), "named alike");
+    assert_eq!(twin.2.iter().filter(|r| r.1 >= 0.0).count(), 1, "one platform: {:?}", twin.2);
+}
