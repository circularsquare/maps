+/// TWT4 to TWT6's nodes and edges (stations on their nodes, a piece's tracks as a count and a way).
+fn old_body(w: &mut W, net: &Network, nodes: &[u32], edges: &[u32], node_id: &[u32]) {
+    w.0.extend_from_slice(match net.frame_kind {
+        FrameKind::Lcc => MAGIC_TWT5,
+        FrameKind::Merc => MAGIC_TWT6,
+        FrameKind::Equirect => MAGIC,
+    });
+    w.0.extend_from_slice(&net.origin_lon.to_le_bytes());
+    w.0.extend_from_slice(&net.origin_lat.to_le_bytes());
+    w.u(net.right_hand as u64);
+    w.u(nodes.len() as u64);
+    let (mut px, mut py) = (0.0, 0.0);
+    for &n in nodes {
+        let i = n as usize;
+        w.mm(net.node_x[i] - px);
+        w.mm(net.node_y[i] - py);
+        (px, py) = (net.node_x[i], net.node_y[i]);
+        w.i(net.node_level[i] as i64);
+        let plat = net.platform_len(i as u32);
+        let ups = if plat > 0 { net.station_upgrades(i as u32) as u64 } else { 0 };
+        let one = if plat > 0 { net.station_one(i as u32) as u64 } else { 0 };
+        w.u(net.node_flying[i] as u64 | ((plat > 0) as u64) << 1 | ((plat > 0 && net.station_built(i as u32)) as u64) << 2 | ((plat > 0 && net.station_off(i as u32) && !net.station_built(i as u32)) as u64) << 3 | ups << 4 | ((plat > 0 && net.station_named(i as u32)) as u64) << 8 | one << 9);
+        if plat > 0 {
+            w.u(plat as u64);
+            w.s(&net.station_name(i as u32));
+        }
+    }
+    w.u(edges.len() as u64);
+    let mut prev_a = 0i64;
+    for &e in edges {
+        let d = net.edge_data(e).unwrap();
+        let a = node_id[d.a as usize] as i64;
+        w.i(a - prev_a);
+        w.i(node_id[d.b as usize] as i64 - a);
+        prev_a = a;
+        w.u(d.tracks.n() as u64 | (d.built as u64) << 2 | (!d.thru.is_empty() as u64) << 3 | ((d.off && !d.built) as u64) << 4 | (d.crossover as u64) << 5 | (d.kind.is_hsr() as u64) << 6 | (d.sep as u64) << 7 | edge_kind_bits(d.kind) | (if d.tracks.n() == 1 { d.tracks.single_way() as u64 | (d.tracks.single_join(0).code() as u64) << 2 | (d.tracks.single_join(1).code() as u64) << 4 } else { 0 }) << 11);
+        pis_out(w, net, &d);
+    }
+}
