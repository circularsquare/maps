+#[test]
+fn t4032_cut_runs_as_split() {
+    for (single, curved) in [(false, false), (true, false), (false, true), (true, true)] {
+        let (split, cut, e, m) = twins(single, curved);
+        let what = format!("single {single} curved {curved}");
+        // the cut is there: line 1's run goes over two parts of the piece, through the cut's node
+        let run = &cut.svc.lines[0].runs[0];
+        assert_eq!(run.segs.len(), cut.net.line_path(0).len() + 1, "single {single}");
+        assert!(run.nodes.contains(&m) && cut.net.node_ports[m as usize].n == 0);
+        assert_eq!(run.piece_path(&cut.net), cut.net.line_path(0));
+        assert!(cut.net.d_of_piece(e).any(|d| d >= EXTRA_BASE));
+        // and the fixture has power: a flat crossing on the cut piece, a following loss and (single) single track
+        let kinds: Vec<String> = cap_figures(&cut).iter().map(|s| s.0.split(' ').next().unwrap().to_string()).collect();
+        assert!(kinds.iter().any(|k| k == "Crossing"), "{kinds:?}");
+        assert!(kinds.iter().any(|k| k == "Follow"), "{kinds:?}");
+        assert_eq!(kinds.iter().any(|k| k == "SingleTrack"), single, "{kinds:?}");
+        // a curve's limit and the piece's own on the cut piece
+        assert!(!curved || run.limits.len() >= 4, "{:?}", run.limits);
+        // a straight piece split is the same alignment to the bit; a curved one is fitted again, its length moving by
+        // a fraction of a millimetre (the times and delays with it, by a few millionths)
+        let rel = if curved { 2e-5 } else { 1e-12 };
+        let len = |w: &TrackWorld| w.svc.lines[0].runs[0].len;
+        assert!((len(&split) - len(&cut)).abs() < if curved { 1e-3 } else { 1e-9 }, "{what}: {} {}", len(&split), len(&cut));
+        agree(&format!("runs, {what}"), &run_figures(&split), &run_figures(&cut), rel);
+        agree(&format!("capacity, {what}"), &cap_figures(&split), &cap_figures(&cut), rel);
+    }
+}
+
+/// Everything exact: each run's derived entries and offsets, the line figures and every resource to the bit.
+fn exact(w: &TrackWorld) -> String {
+    let mut s = String::new();
+    for ls in &w.svc.lines {
+        for run in &ls.runs {
+            s += &format!("{:?} {:?} {:?} {:?}\n", run.segs, run.seg_off, run.nodes, run.prof.iter().map(|p| (&p.arr, &p.dep, p.duration)).collect::<Vec<_>>());
+        }
+        s += &format!("{:?} {:?} {:?}\n", ls.round_trip, ls.trains, ls.delay);
+    }
+    for x in w.svc.cap.canonical() {
+        s += &format!("{x:?}\n");
+    }
+    s
+}
