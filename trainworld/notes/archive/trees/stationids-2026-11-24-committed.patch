@@ -0,0 +1,21 @@
+// T-3157, T-3691: `Strokes.level` packs a segment's heights at its start and end in one float, start * 256 + end
+// (exact in a float), each in 8 bits as 1/LEVEL_STEPS of a level (8 m) from level -LEVEL_FROM: -8 to +7.9, room for
+// levels -5 to +5 and the ramps between. The stroke shader blends the level colours along it from the same numbers.
+
+export const LEVEL_STEPS = 16;
+export const LEVEL_FROM = 8;
+
+/** The code of a segment from height `z0` to `z1`, m. */
+export const levelCode = (z0: number, z1: number) => {
+  const q = (z: number) => Math.max(0, Math.min(255, Math.round((z / 8 + LEVEL_FROM) * LEVEL_STEPS)));
+  return q(z0) * 256 + q(z1);
+};
+
+/** The height in levels a code has at its start (`end` 0) or its end (1). */
+export const levelOfCode = (code: number, end: 0 | 1) => (end ? code % 256 : Math.floor(code / 256)) / LEVEL_STEPS - LEVEL_FROM;
+
+/** The whole level a packed segment starts at. */
+export const levelAtStart = (code: number) => Math.round(levelOfCode(code, 0));
+
+/** GLSL: the height in levels of one end's 8 bits of a code. */
+export const LEVEL_OF_GLSL = (q: string) => `(${q} / ${LEVEL_STEPS.toFixed(1)} - ${LEVEL_FROM.toFixed(1)})`;
