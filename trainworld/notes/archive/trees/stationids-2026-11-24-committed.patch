diff --git a/trainworld/sim/src/track/wasm/trackdraw_tests.rs b/trainworld/sim/src/track/wasm/trackdraw_tests.rs
new file mode 100644
index 000000000..20e406a5c
--- /dev/null
+++ b/trainworld/sim/src/track/wasm/trackdraw_tests.rs
@@ -0,0 +1,119 @@
+//! T-4034 (track rework stage d): the app is told which track each path entry runs on, so it draws trains and line
+//! ribbons on their own track of a piece of more than two.
+
+use super::*;
+use crate::track::compile::{WAY_AB, WAY_BA};
+use crate::track::net::{entry, path_dir, path_key};
+use crate::track::tracks::TrackRec;
+
+fn api() -> TrackApi {
+    let mut a = TrackApi::new(-73.985, 40.758, true);
+    a.set_cash(1e9);
+    a
+}
+fn free(x: f64, y: f64) -> [f64; 5] {
+    [0.0, 0.0, x, y, 0.0]
+}
+fn ends(a: [f64; 5], b: [f64; 5]) -> Vec<f64> {
+    a.iter().chain(b.iter()).copied().collect()
+}
+fn node_near(a: &TrackApi, x: f64, y: f64) -> u32 {
+    let n = &a.w.net;
+    let d = |k: u32| (n.node_x[k as usize] - x).hypot(n.node_y[k as usize] - y);
+    (0..n.node_count() as u32).filter(|&k| n.node_ok(k)).min_by(|&p, &q| d(p).total_cmp(&d(q))).unwrap()
+}
+fn at_node(a: &TrackApi, n: u32) -> [f64; 5] {
+    [1.0, n as f64, a.w.net.node_x[n as usize], a.w.net.node_y[n as usize], 0.0]
+}
+fn piece(a: &TrackApi, m: u32, n: u32) -> u32 {
+    let net = &a.w.net;
+    (0..net.edge_count() as u32).find(|&e| net.edge_ok(e) && net.edge_a[e as usize] == m && net.edge_b[e as usize] == n).unwrap()
+}
+
+/// Doubles W (0, 0) - X - M - Y - E (8 km), with stations at W and E; X - M and M - Y laid again as four tracks,
+/// from the left looking east: two-way, two-way, east, west (the east and west pair keeping left, against the
+/// running side). Three lines: L0 W to E on slot 0, L1 E to W on slot 1 (its path runs b to a), L2 W to E east on
+/// slot 2 (and back on its partner, slot 3), so every track carries a line. Built and running. Returns the api, the two four-track pieces and the lines.
+pub(super) fn four_tracks() -> (TrackApi, [u32; 2], [u32; 3]) {
+    let mut a = api();
+    assert_eq!(a.add_route(&ends(free(0.0, 0.0), free(2000.0, 0.0)), &[], 2, false), 0, "{}", a.issues());
+    for k in 1..4 {
+        let from = node_near(&a, 2000.0 * k as f64, 0.0);
+        assert_eq!(a.add_route(&ends(at_node(&a, from), free(2000.0 * (k + 1) as f64, 0.0)), &[], 2, false), 0, "{}", a.issues());
+    }
+    let [w, x, m, y, e] = [0, 1, 2, 3, 4].map(|k| node_near(&a, 2000.0 * k as f64, 0.0));
+    for n in [w, e] {
+        let (px, py) = (a.w.net.node_x[n as usize], a.w.net.node_y[n as usize]);
+        assert_eq!(a.add_station(1, n, px, py, 200, "S".into()), 0, "{}", a.issues());
+    }
+    let quads = [piece(&a, x, m), piece(&a, m, y)];
+    for &p in &quads {
+        let mut d = a.w.net.edge_data(p).unwrap();
+        let both = WAY_AB | WAY_BA;
+        d.tracks = Tracks::from_recs([both, both, WAY_AB, WAY_BA].iter().enumerate().map(|(s, &way)| TrackRec { key: s as u8, way, partner: None, join: [Join::Auto; 2] }).collect());
+        assert_eq!(a.run(Op::Edge { id: p, data: Some(d) }), 0, "{}", a.issues());
+    }
+    assert_eq!(a.construct_all(), 0, "{}", a.issues());
+    let colours = [0xe6b800, 0x3a7bd5, 0xc2185b];
+    let lines = [0, 1, 2].map(|k| {
+        let l = a.new_line_id();
+        let stops = if k == 1 { [e, w] } else { [w, e] };
+        assert_eq!(a.set_line_with_trains(l, &stops, 6, 4, 2, 30.0, 180.0, 0, colours[k], format!("L{k}")), 0, "{}", a.issues());
+        // the router takes the first track each time: each line is put on its own
+        let mut d = a.w.net.line_data(l).unwrap();
+        for p in d.path.iter_mut() {
+            if quads.contains(&path_edge(*p)) {
+                *p = entry(path_edge(*p), k as u8, path_dir(*p));
+            }
+        }
+        assert_eq!(a.run(Op::Line { id: l, data: Some(d) }), 0, "{}", a.issues());
+        l
+    });
+    (a, quads, lines)
+}
+
+/// Each line's entries on the four-track pieces name its own track, and the app is told it by index in
+/// `track_rows`' order (east first from the right, then the rest from the right: slots 2, 1, 0, 3); the return
+/// runs on the same two-way track, or on the partner. On double track alone the app is told nothing.
+#[test]
+fn t4034_the_app_is_told_each_entrys_track() {
+    let (a, quads, lines) = four_tracks();
+    let order: Vec<u8> = a.w.net.piece_tracks(quads[0]).map(|t| a.w.net.track(t).key).collect();
+    assert_eq!(order, [2, 1, 0, 3]);
+    let idx = |key: u8| order.iter().position(|&k| k == key).unwrap() as u8;
+    for (k, &l) in lines.iter().enumerate() {
+        let path = a.w.net.line_path(l).to_vec();
+        assert!(path.iter().filter(|&&p| quads.contains(&path_edge(p))).all(|&p| path_key(p) == k as u8 && path_dir(p) == (k == 1) as u32), "L{k} on slot {k}: {path:?}");
+        let fwd = a.line_path_tracks(l);
+        assert_eq!(fwd.len(), a.line_path(l).len(), "one per app entry");
+        let back = a.line_back_tracks(l);
+        assert!(a.line_back_path(l).is_empty(), "the return is the path backward at the app's level");
+        assert_eq!(back.len(), fwd.len());
+        let on = |v: &[u8], path: &[u32]| path.iter().zip(v).filter(|(p, _)| quads.contains(&path_edge(**p))).map(|(_, &t)| t).collect::<Vec<_>>();
+        let back_path = a.w.svc.lines[l as usize].runs[1].piece_path(&a.w.net);
+        let ret = if k == 2 { 3 } else { k as u8 };
+        assert_eq!((on(&fwd, &path), on(&back, &back_path)), (vec![idx(k as u8); 2], vec![idx(ret); 2]), "L{k}");
+        assert!(!a.w.net.line_broken[l as usize] && a.w.net.check_line(l).is_ok(), "L{k} runs");
+    }
+    let mut b = api();
+    assert!(b.load(&a.save()));
+    assert_eq!(lines.map(|l| b.line_path_tracks(l)), lines.map(|l| a.line_path_tracks(l)), "a load keeps them");
+    // double track only: nothing to tell
+    let (mut c, _, _) = four_tracks();
+    for p in quads {
+        let mut d = c.w.net.edge_data(p).unwrap();
+        d.tracks = Tracks::new(2);
+        assert_eq!(c.run(Op::Edge { id: p, data: Some(d) }), 0, "{}", c.issues());
+    }
+    for l in lines {
+        assert!(c.line_path_tracks(l).is_empty() && c.line_back_tracks(l).is_empty() && !c.line_path(l).is_empty());
+    }
+}
+
+/// Not a check: writes `four_tracks` as a save to `TW_T4034_SAVE` for the play check (no tool lays four tracks yet).
+#[test]
+#[ignore]
+fn t4034_write_fixture() {
+    let (a, _, _) = four_tracks();
+    std::fs::write(std::env::var("TW_T4034_SAVE").expect("TW_T4034_SAVE"), a.save()).unwrap();
+}
diff --git a/trainworld/sim/src/track/wasm/trackedit_tests.rs b/trainworld/sim/src/track/wasm/trackedit_tests.rs
new file mode 100644
index 000000000..58f6d0400
--- /dev/null
+++ b/trainworld/sim/src/track/wasm/trackedit_tests.rs
@@ -0,0 +1,184 @@
+//! T-3956 (track rework stage 3e): single track carried on from one track of a double, merging singles manually, and
+//! one track of a double removed.
+
+use super::*;
+
+fn api(right_hand: bool) -> TrackApi {
+    let mut a = TrackApi::new(-73.985, 40.758, right_hand);
+    a.set_cash(1e9);
+    a
+}
+fn free(x: f64, y: f64) -> [f64; 5] {
+    [0.0, 0.0, x, y, 0.0]
+}
+fn ends(a: [f64; 5], b: [f64; 5]) -> Vec<f64> {
+    a.iter().chain(b.iter()).copied().collect()
+}
+fn node_near(a: &TrackApi, x: f64, y: f64) -> u32 {
+    let n = &a.w.net;
+    let d = |k: u32| (n.node_x[k as usize] - x).hypot(n.node_y[k as usize] - y);
+    (0..n.node_count() as u32).filter(|&k| n.node_ok(k)).min_by(|&p, &q| d(p).total_cmp(&d(q))).unwrap()
+}
+fn at_node(a: &TrackApi, n: u32) -> [f64; 5] {
+    [1.0, n as f64, a.w.net.node_x[n as usize], a.w.net.node_y[n as usize], 0.0]
+}
+fn edge_near(a: &TrackApi, x: f64, y: f64) -> u32 {
+    let n = &a.w.net;
+    (0..n.edge_count() as u32).filter(|&e| n.edge_ok(e)).min_by(|&p, &q| n.project(p, x, y).1.total_cmp(&n.project(q, x, y).1)).unwrap()
+}
+fn on_edge(a: &TrackApi, x: f64, y: f64) -> [f64; 5] {
+    let n = &a.w.net;
+    let e = edge_near(a, x, y);
+    let (px, py, _) = crate::track::geom::pos_at(n.edge_pieces(e), n.project(e, x, y).0);
+    [2.0, e as f64, px, py, 0.0]
+}
+fn singles(a: &TrackApi) -> Vec<u32> {
+    (0..a.w.net.edge_count() as u32).filter(|&e| a.w.net.edge_ok(e) && a.w.net.edge_tracks[e as usize] == 1).collect()
+}
+/// Piece `e`'s join at its end at node `n`.
+fn join_at(a: &TrackApi, e: u32, n: u32) -> u8 {
+    a.w.net.join_codes(e)[(a.w.net.end_node(e, 1) == n) as usize]
+}
+fn station(a: &mut TrackApi, x: f64, y: f64, name: &str) -> u32 {
+    let n = node_near(a, x, y);
+    let (nx, ny) = (a.w.net.node_x[n as usize], a.w.net.node_y[n as usize]);
+    assert_eq!(a.add_station(1, n, nx, ny, 200, name.into()), 0, "{}", a.issues());
+    node_near(a, x, y)
+}
+fn line(a: &mut TrackApi, stops: &[u32]) -> u32 {
+    let l = a.new_line_id();
+    assert_eq!(a.set_line_with_trains(l, stops, 4, 2, 0, 30.0, 180.0, 0, 0, "L".into()), 0, "{}", a.issues());
+    l
+}
+
+/// A double's loose end at (6000, 0), its far end at (0, 0).
+fn double_end(right_hand: bool) -> (TrackApi, u32) {
+    let mut a = api(right_hand);
+    assert_eq!(a.add_route(&ends(free(0.0, 0.0), free(6000.0, 0.0)), &[], 2, false), 0);
+    let n = node_near(&a, 6000.0, 0.0);
+    (a, n)
+}
+
+/// A single from a double's loose end with no point named carries on the track on the side it bends to, never both.
+#[test]
+fn a_single_from_a_loose_end_takes_the_track_it_bends_to() {
+    for right_hand in [true, false] {
+        for (to, want) in [((7500.0, 1500.0), 1), ((7500.0, -1500.0), 2)] {
+            let (mut a, n) = double_end(right_hand);
+            assert_eq!(a.add_route(&ends(at_node(&a, n), free(to.0, to.1)), &[], 1, false), 0, "{}", a.issues());
+            let s = singles(&a)[0];
+            assert_eq!(join_at(&a, s, n), want, "right hand {right_hand}, to {to:?}");
+            assert_ne!(a.w.net.edge_way(s), 0, "it runs one way, the way of its track");
+        }
+    }
+}
+
+/// Each track of a double carried on as its own single: both joined, to different tracks, running opposite ways.
+#[test]
+fn each_track_of_a_double_extends() {
+    for right_hand in [true, false] {
+        let (mut a, n) = double_end(right_hand);
+        a.set_route_join(&[6000.0, 2.0, f64::NAN, f64::NAN]);
+        assert_eq!(a.add_route(&ends(at_node(&a, n), free(8000.0, 800.0)), &[], 1, false), 0, "{}", a.issues());
+        a.set_route_join(&[6000.0, -2.0, f64::NAN, f64::NAN]);
+        assert_eq!(a.add_route(&ends(at_node(&a, n), free(8000.0, -800.0)), &[], 1, false), 0, "{}", a.issues());
+        let s = singles(&a);
+        assert_eq!(s.len(), 2);
+        let j: Vec<u8> = s.iter().map(|&e| join_at(&a, e, n)).collect();
+        assert!(j.iter().all(|&x| x != 0) && j[0] != j[1], "right hand {right_hand}: joins {j:?}");
+        // both run away from or into the node, one each
+        let away: Vec<bool> = s.iter().map(|&e| (a.w.net.edge_way(e) == 1) == (a.w.net.end_node(e, 0) == n)).collect();
+        assert_ne!(away[0], away[1], "right hand {right_hand}");
+    }
+}
+
+/// Two singles carried on from a double's tracks and merged manually, the second drawn into the first: a line runs
+/// out on one and back on the other.
+#[test]
+fn two_singles_merge_manually() {
+    for right_hand in [true, false] {
+        let (mut a, n) = double_end(right_hand);
+        let north = if right_hand { 2.0 } else { -2.0 };
+        // the first carries on the track trains leave the node by, out to (10000, 0)
+        a.set_route_join(&[6000.0, -north, f64::NAN, f64::NAN]);
+        assert_eq!(a.add_route(&ends(at_node(&a, n), free(10000.0, 0.0)), &[], 1, false), 0, "{}", a.issues());
+        // the second off the other track, round through (7500, 300) and into the first at (9000, 0)
+        a.set_route_join(&[6000.0, north, f64::NAN, f64::NAN]);
+        let into = on_edge(&a, 9000.0, 0.0);
+        assert_eq!(a.add_route(&ends(at_node(&a, n), into), &[7500.0, 300.0 * north.signum(), 0.0, 0.0], 1, false), 0, "{}", a.issues());
+        let w = station(&mut a, 0.0, 0.0, "W");
+        let e = station(&mut a, 10000.0, 0.0, "E");
+        let l = line(&mut a, &[w, e]);
+        let net = &a.w.net;
+        let path = net.line_path(l).to_vec();
+        let back = net.back_path(l).expect("a way back");
+        let out: std::collections::HashSet<u32> = path.iter().map(|&p| crate::track::net::path_edge(p)).collect();
+        let home: std::collections::HashSet<u32> = back.iter().map(|&p| crate::track::net::path_edge(p)).collect();
+        let only_out = out.difference(&home).count();
+        let only_back = home.difference(&out).count();
+        assert!(only_out > 0 && only_back > 0, "right hand {right_hand}: out {path:?}, back {back:?}, ways {:?}", singles(&a).iter().map(|&e| (e, net.edge_way(e))).collect::<Vec<_>>());
+    }
+}
+
+/// One track of a double removed where a line has another way: the line takes it, keeps its way back, and both stay
+/// through a save.
+#[test]
+fn a_line_on_the_removed_track_is_rerouted() {
+    for right_hand in [true, false] {
+        let mut a = api(right_hand);
+        assert_eq!(a.add_route(&ends(free(0.0, 0.0), free(1000.0, 0.0)), &[], 2, false), 0);
+        let j1 = node_near(&a, 1000.0, 0.0);
+        assert_eq!(a.add_route(&ends(at_node(&a, j1), free(5000.0, 0.0)), &[], 2, false), 0);
+        let j2 = node_near(&a, 5000.0, 0.0);
+        assert_eq!(a.add_route(&ends(at_node(&a, j2), free(6000.0, 0.0)), &[], 2, false), 0);
+        assert_eq!(a.add_route(&ends(at_node(&a, j1), at_node(&a, j2)), &[3000.0, 1500.0, 0.0, 0.0], 2, false), 0, "{}", a.issues());
+        let w = station(&mut a, 0.0, 0.0, "W");
+        let e = station(&mut a, 6000.0, 0.0, "E");
+        let l = line(&mut a, &[w, e]);
+        let straight = edge_near(&a, 3000.0, 0.0);
+        let entry = *a.w.net.line_path(l).iter().find(|&&p| crate::track::net::path_edge(p) == straight).expect("the line runs the straight way");
+        assert_eq!(a.delete_track(straight, crate::track::net::path_dir(entry) as u8), 0, "{}", a.issues());
+        let path = a.w.net.line_path(l).to_vec();
+        assert!(!path.iter().any(|&p| crate::track::net::path_edge(p) == straight), "right hand {right_hand}: out the other way: {path:?}");
+        // (back by the partners of the way out, T-3954)
+        let back = a.w.net.back_path(l).expect("a way back");
+        let mut b = api(right_hand);
+        assert!(b.load(&a.save()));
+        assert_eq!(b.w.net.line_path(l), &path[..]);
+        assert_eq!(b.w.net.back_path(l), Some(back));
+        assert_eq!(b.w.net.edge_tracks[straight as usize], 1);
+    }
+}
+
+/// One track of a double removed: the piece is single track running the other track's way, joined to its side at a
+/// node of double track; a line that needs the removed track is refused, naming it.
+#[test]
+fn one_track_of_a_double_removed() {
+    for right_hand in [true, false] {
+        let mut a = api(right_hand);
+        assert_eq!(a.add_route(&ends(free(0.0, 0.0), free(3000.0, 0.0)), &[], 2, false), 0);
+        let m = node_near(&a, 3000.0, 0.0);
+        assert_eq!(a.add_route(&ends(at_node(&a, m), free(6000.0, 0.0)), &[], 2, false), 0);
+        let e = edge_near(&a, 1500.0, 0.0);
+        for dir in [0u8, 1] {
+            let mut b = api(right_hand);
+            assert!(b.load(&a.save()));
+            assert_eq!(b.delete_track(e, dir), 0, "{}", b.issues());
+            let net = &b.w.net;
+            assert_eq!(net.edge_tracks[e as usize], 1);
+            assert_eq!(net.edge_way(e), if dir == 0 { 2 } else { 1 }, "the other track's way");
+            let c = e << 1 | (net.end_node(e, 1) == m) as u32;
+            assert!(net.join_applies(c), "edge {e} ends {} {}, m {m} ports {:?}", net.end_node(e, 0), net.end_node(e, 1), net.node_ports[m as usize].ends());
+            assert_eq!(net.join_away(c), Some((net.edge_way(e) == 1) == (c & 1 == 0)), "joined to the track that runs its way");
+            assert_eq!(b.undo(), 0);
+            assert_eq!(b.w.net.edge_tracks[e as usize], 2, "one undo");
+        }
+        let w = station(&mut a, 0.0, 0.0, "W");
+        let east = station(&mut a, 6000.0, 0.0, "E");
+        let l = line(&mut a, &[w, east]);
+        assert_ne!(a.delete_track(e, 0), 0);
+        assert!(matches!(a.issues[..], [Issue::OneWayNoWay { line }] if line == l), "{}", a.issues());
+        assert_eq!(a.w.net.edge_tracks[e as usize], 2, "nothing changed");
+        assert_eq!(a.delete_track(singles(&a).first().copied().unwrap_or(u32::MAX), 0), 1);
+    }
+}
diff --git a/trainworld/sim/src/track/wasm/trackflip_tests.rs b/trainworld/sim/src/track/wasm/trackflip_tests.rs
new file mode 100644
index 000000000..f751b633a
--- /dev/null
+++ b/trainworld/sim/src/track/wasm/trackflip_tests.rs
@@ -0,0 +1,228 @@
+//! T-4038: one track of an intact double reversed or made two-way (`set_tracks_way`), spread along that track to the
+//! branch points, its lines moved or the edit refused naming one, and undone exactly; the piece then drawn track by
+//! track.
+
+use super::*;
+use crate::track::compile::{WAY_AB, WAY_BA};
+use crate::track::net::{path_dir, path_edge};
+
+fn api(right_hand: bool) -> TrackApi {
+    let mut a = TrackApi::new(-73.985, 40.758, right_hand);
+    a.set_cash(1e9);
+    a
+}
+fn free(x: f64, y: f64) -> [f64; 5] {
+    [0.0, 0.0, x, y, 0.0]
+}
+fn ends(a: [f64; 5], b: [f64; 5]) -> Vec<f64> {
+    a.iter().chain(b.iter()).copied().collect()
+}
+fn node_near(a: &TrackApi, x: f64, y: f64) -> u32 {
+    let n = &a.w.net;
+    let d = |k: u32| (n.node_x[k as usize] - x).hypot(n.node_y[k as usize] - y);
+    (0..n.node_count() as u32).filter(|&k| n.node_ok(k)).min_by(|&p, &q| d(p).total_cmp(&d(q))).unwrap()
+}
+fn at_node(a: &TrackApi, n: u32) -> [f64; 5] {
+    [1.0, n as f64, a.w.net.node_x[n as usize], a.w.net.node_y[n as usize], 0.0]
+}
+fn piece(a: &TrackApi, m: u32, n: u32, tracks: u8) -> u32 {
+    let net = &a.w.net;
+    (0..net.edge_count() as u32).find(|&e| net.edge_ok(e) && net.edge_a[e as usize] == m && net.edge_b[e as usize] == n && net.edge_tracks[e as usize] == tracks).unwrap()
+}
+
+struct Scene {
+    a: TrackApi,
+    w: u32,
+    e: u32,
+    /// the double X - M - Y, two pieces (a plain joint at M), between the junctions X and Y
+    xm: u32,
+    my: u32,
+    bypass: u32,
+}
+
+/// Doubles W (0, 0) - X - M - Y - E (8000, 0), 2 km each, stations at W and E, and single track X - Y bowed 400 m
+/// north, pinned both ways (so no join decides its way): X and Y are junctions, M a plain joint.
+fn scene(right_hand: bool) -> Scene {
+    let mut a = api(right_hand);
+    assert_eq!(a.add_route(&ends(free(0.0, 0.0), free(2000.0, 0.0)), &[], 2, false), 0, "{}", a.issues());
+    for k in 1..4 {
+        let from = node_near(&a, 2000.0 * k as f64, 0.0);
+        assert_eq!(a.add_route(&ends(at_node(&a, from), free(2000.0 * (k + 1) as f64, 0.0)), &[], 2, false), 0, "{}", a.issues());
+    }
+    let [w, x, m, y, e] = [0, 1, 2, 3, 4].map(|k| node_near(&a, 2000.0 * k as f64, 0.0));
+    assert_eq!(a.add_route(&ends(at_node(&a, x), at_node(&a, y)), &[4000.0, 400.0, 0.0, 0.0], 1, false), 0, "{}", a.issues());
+    for n in [w, e] {
+        let (px, py) = (a.w.net.node_x[n as usize], a.w.net.node_y[n as usize]);
+        assert_eq!(a.add_station(1, n, px, py, 200, "S".into()), 0, "{}", a.issues());
+    }
+    let bypass = piece(&a, x, y, 1);
+    assert_eq!(a.set_edge_oneway(bypass, 3), 0, "{}", a.issues());
+    let (xm, my) = (piece(&a, x, m, 2), piece(&a, m, y, 2));
+    Scene { a, w, e, xm, my, bypass }
+}
+
+fn line(a: &mut TrackApi, stops: &[u32]) -> u32 {
+    let l = a.new_line_id();
+    assert_eq!(a.set_line_with_trains(l, stops, 4, 2, 0, 30.0, 180.0, 0, 0, "L".into()), 0, "{}", a.issues());
+    l
+}
+
+/// The slot of piece `e`'s track running `way`.
+fn slot(a: &TrackApi, e: u32, way: u8) -> u8 {
+    a.w.net.slot_ways(e).iter().position(|&w| w == way).unwrap() as u8
+}
+
+fn runs(a: &TrackApi, l: u32) -> bool {
+    !a.w.net.line_broken[l as usize] && a.w.net.check_line(l).is_ok()
+}
+
+/// Whether `path` runs west (b to a) over piece `e`.
+fn west_on(path: &[u32], e: u32) -> bool {
+    path.iter().any(|&p| path_edge(p) == e && path_dir(p) == 1)
+}
+
+/// The westbound track of X - M reversed: it spreads to M - Y (both pieces A A), the line out east keeps its path and
+/// comes back over the bypass, the line out west is rerouted over it, each as planned, and both still run; the
+/// pieces are drawn track by track; one undo puts back the records, paths and bytes.
+#[test]
+fn t4038_one_track_reversed_its_lines_moved_and_undone() {
+    for rh in [true, false] {
+        let Scene { mut a, w, e, xm, my, bypass } = scene(rh);
+        let east = line(&mut a, &[w, e]);
+        let west = line(&mut a, &[e, w]);
+        assert!(runs(&a, east) && runs(&a, west));
+        assert!(a.line_path_tracks(east).is_empty(), "a double by the running side keeps its lane stroke");
+        let before = (a.w.net.edge_recs[xm as usize].clone(), a.w.net.edge_recs[my as usize].clone(), a.save());
+        let paths = (a.w.net.line_path(east).to_vec(), a.w.net.line_path(west).to_vec());
+        assert!(!paths.0.iter().any(|&p| path_edge(p) == bypass) && west_on(&paths.1, xm), "both on the double first");
+        let s = slot(&a, xm, WAY_BA);
+        let mut reach = a.track_way_reach(&[xm], &[s]);
+        reach.sort_unstable();
+        assert_eq!(reach, { let mut v = vec![xm, my]; v.sort_unstable(); v }, "out to the junctions X and Y");
+        let fx = a.track_way_effects(&[xm], &[s], &[WAY_AB]);
+        let named: Vec<(u32, bool)> = fx.chunks(2).map(|c| (c[0] as u32, c[1] == 1.0)).collect();
+        assert!(named.contains(&(east, true)) && named.contains(&(west, true)), "both lines move, neither refuses: {named:?}");
+        let (_, rows) = a.oneway_plan(&[(xm, s, WAY_AB)], true).unwrap();
+        let planned = |l: u32| rows.iter().find(|r| r.0 == l).and_then(|r| r.1.clone());
+        assert_eq!(a.set_tracks_way(&[xm], &[s], &[WAY_AB]), 0, "{}", a.issues());
+        for p in [xm, my] {
+            assert_eq!(a.w.net.slot_ways(p), [WAY_AB, WAY_AB], "both tracks east (rh {rh})");
+            assert!(a.w.net.edge_recs[p as usize].recs().iter().all(|r| r.partner.is_none()), "A A has no pairs");
+        }
+        for l in [east, west] {
+            assert_eq!(Some(a.w.net.line_path(l).to_vec()), planned(l).or(Some(if l == east { paths.0.clone() } else { paths.1.clone() })), "the stored path is the planned one");
+            assert!(runs(&a, l), "line {l} runs (rh {rh})");
+        }
+        assert_eq!(a.w.net.line_path(east), &paths.0[..], "out east as before");
+        let back = a.w.net.back_path(east).unwrap();
+        assert!(!west_on(&back, xm) && back.iter().any(|&p| path_edge(p) == bypass), "back over the bypass: {back:?}");
+        assert!(a.w.net.line_path(west).iter().any(|&p| path_edge(p) == bypass) && !west_on(a.w.net.line_path(west), xm), "out west over the bypass");
+        let tracks = a.line_path_tracks(east);
+        assert_eq!(tracks.len(), paths.0.len(), "the app is told each entry's track");
+        a.undo();
+        assert_eq!((a.w.net.edge_recs[xm as usize].clone(), a.w.net.edge_recs[my as usize].clone(), a.save()), before, "undone exactly (rh {rh})");
+        assert_eq!((a.w.net.line_path(east).to_vec(), a.w.net.line_path(west).to_vec()), paths);
+        assert!(runs(&a, east) && runs(&a, west));
+    }
+}
+
+/// With the bypass pinned one way east, the westbound track reversed leaves the line no way back: refused naming
+/// it, nothing changed.
+#[test]
+fn t4038_no_other_way_is_refused_naming_the_line() {
+    for rh in [true, false] {
+        let Scene { mut a, w, e, xm, bypass, .. } = scene(rh);
+        assert_eq!(a.set_edge_oneway(bypass, 1), 0, "{}", a.issues());
+        let l = line(&mut a, &[w, e]);
+        let before = a.save();
+        let s = slot(&a, xm, WAY_BA);
+        let fx = a.track_way_effects(&[xm], &[s], &[WAY_AB]);
+        assert_eq!(fx, [l as f64, 0.0], "named, with no way");
+        assert_ne!(a.set_tracks_way(&[xm], &[s], &[WAY_AB]), 0);
+        assert!(a.issues().contains(&format!("OneWayNoWay {{ line: {l} }}")), "{}", a.issues());
+        assert_eq!(a.save(), before);
+        assert!(runs(&a, l));
+    }
+}
+
+/// One track made two-way (A and both: no station on X - M - Y, so it may share a way), then given back its default
+/// way: the records come back exactly as laid by the running side, and two undos give back the first bytes.
+#[test]
+fn t4038_one_track_made_two_way_and_back() {
+    for rh in [true, false] {
+        let Scene { mut a, w, e, xm, my, .. } = scene(rh);
+        let l = line(&mut a, &[w, e]);
+        let first = (a.w.net.edge_recs[xm as usize].clone(), a.save());
+        let s = slot(&a, xm, WAY_BA);
+        assert_eq!(a.set_tracks_way(&[xm], &[s], &[3]), 0, "{}", a.issues());
+        for p in [xm, my] {
+            let ways = a.w.net.slot_ways(p);
+            assert_eq!(ways.iter().filter(|&&x| x == (WAY_AB | WAY_BA)).count(), 1, "one track two-way on {p}: {ways:?}");
+            assert!(a.w.net.edge_recs[p as usize].own_ways() && a.w.net.drawn_by_track(p));
+        }
+        let recs = a.w.net.edge_recs[xm as usize].recs().to_vec();
+        assert_eq!(recs[s as usize].partner, Some(recs[s as usize].key), "a two-way track is its own partner");
+        assert!(runs(&a, l));
+        assert_eq!(a.set_tracks_way(&[xm], &[s], &[0]), 0, "{}", a.issues());
+        assert_eq!(a.w.net.edge_recs[xm as usize], first.0, "its default way gives the running side's records back");
+        assert!(!a.w.net.drawn_by_track(xm) && !a.w.net.drawn_by_track(my));
+        assert!(runs(&a, l));
+        a.undo();
+        a.undo();
+        assert_eq!((a.w.net.edge_recs[xm as usize].clone(), a.save()), first, "rh {rh}");
+    }
+}
+
+/// A station on the traced segment refuses it (its platforms serve one track each way until they lie on tracks).
+#[test]
+fn t4038_a_station_on_the_segment_refuses() {
+    let Scene { mut a, w, .. } = scene(true);
+    let x = node_near(&a, 2000.0, 0.0);
+    let wx = piece(&a, w, x, 2);
+    let before = a.save();
+    assert_ne!(a.set_tracks_way(&[wx], &[slot(&a, wx, WAY_BA)], &[WAY_AB]), 0);
+    assert!(a.issues().contains(&format!("StationWays {{ node: {w} }}")), "{}", a.issues());
+    assert_ne!(a.set_tracks_way(&[wx], &[0], &[3]), 0, "two-way shares a way too");
+    assert_eq!(a.save(), before);
+}
+
+/// A A, mirrored (B A) and one track two-way, each saved and loaded: the same records, paths and bytes.
+#[test]
+fn t4038_own_ways_survive_a_save_and_load() {
+    for rh in [true, false] {
+        let Scene { mut a, w, e, xm, my, .. } = scene(rh);
+        let (east, west) = (line(&mut a, &[w, e]), line(&mut a, &[e, w]));
+        let (sw, se) = (slot(&a, xm, WAY_BA), slot(&a, xm, WAY_AB));
+        for set in [vec![(sw, WAY_AB)], vec![(se, WAY_BA)], vec![(se, 3)]] {
+            for (s, way) in set {
+                assert_eq!(a.set_tracks_way(&[xm], &[s], &[way]), 0, "{}", a.issues());
+            }
+            let mut b = api(rh);
+            assert!(b.load(&a.save()));
+            for p in [xm, my] {
+                assert_eq!(b.w.net.edge_recs[p as usize], a.w.net.edge_recs[p as usize], "rh {rh}, {:?}", a.w.net.slot_ways(p));
+            }
+            for l in [east, west] {
+                assert_eq!(b.w.net.line_path(l), a.w.net.line_path(l));
+                assert_eq!(b.w.net.back_path(l), a.w.net.back_path(l));
+                assert!(runs(&b, l));
+            }
+            assert_eq!(b.save(), a.save());
+        }
+    }
+}
+
+/// One track of an A A double removed by its slot: the piece is single track running east with the kept track's
+/// key, whichever of the two goes.
+#[test]
+fn t4038_one_track_of_an_aa_double_removed_by_slot() {
+    for gone in [0u8, 1] {
+        let Scene { mut a, xm, .. } = scene(true);
+        let s = slot(&a, xm, WAY_BA);
+        assert_eq!(a.set_tracks_way(&[xm], &[s], &[WAY_AB]), 0, "{}", a.issues());
+        let kept = a.w.net.edge_recs[xm as usize].recs()[1 - gone as usize].key;
+        assert_eq!(a.delete_tracks(&[xm], &[gone]), 0, "{}", a.issues());
+        let recs = a.w.net.edge_recs[xm as usize].recs().to_vec();
+        assert_eq!((recs.len(), recs[0].key, recs[0].way), (1, kept, 1), "the other track kept, running east");
+    }
+}
diff --git a/trainworld/sim/src/track/wasm/trackpaths_tests.rs b/trainworld/sim/src/track/wasm/trackpaths_tests.rs
new file mode 100644
index 000000000..34ce3b205
--- /dev/null
+++ b/trainworld/sim/src/track/wasm/trackpaths_tests.rs
@@ -0,0 +1,162 @@
+//! T-4033 (track rework stage c): line paths name tracks, so a piece may hold tracks of any ways, several of them one
+//! way, and lines run on the one they name.
+
+use super::*;
+use crate::track::net::{path_dir, path_edge, path_key};
+use crate::track::tracks::TrackRec;
+
+fn api() -> TrackApi {
+    let mut a = TrackApi::new(-73.985, 40.758, true);
+    a.set_cash(1e9);
+    a
+}
+fn free(x: f64, y: f64) -> [f64; 5] {
+    [0.0, 0.0, x, y, 0.0]
+}
+fn ends(a: [f64; 5], b: [f64; 5]) -> Vec<f64> {
+    a.iter().chain(b.iter()).copied().collect()
+}
+fn node_near(a: &TrackApi, x: f64, y: f64) -> u32 {
+    let n = &a.w.net;
+    let d = |k: u32| (n.node_x[k as usize] - x).hypot(n.node_y[k as usize] - y);
+    (0..n.node_count() as u32).filter(|&k| n.node_ok(k)).min_by(|&p, &q| d(p).total_cmp(&d(q))).unwrap()
+}
+fn at_node(a: &TrackApi, n: u32) -> [f64; 5] {
+    [1.0, n as f64, a.w.net.node_x[n as usize], a.w.net.node_y[n as usize], 0.0]
+}
+/// The piece of `tracks` tracks from node `m` east to node `n` (drawn west to east, so its end a is at `m`).
+fn piece(a: &TrackApi, m: u32, n: u32) -> u32 {
+    let net = &a.w.net;
+    (0..net.edge_count() as u32).find(|&e| net.edge_ok(e) && net.edge_a[e as usize] == m && net.edge_b[e as usize] == n).unwrap()
+}
+
+/// Doubles W (0, 0) - X - M - Y - E (8000, 0), 2 km each and drawn one by one, so every node between is a plain
+/// joint, with end stations at W and E. Returns the api and the five nodes.
+fn chain() -> (TrackApi, [u32; 5]) {
+    let mut a = api();
+    assert_eq!(a.add_route(&ends(free(0.0, 0.0), free(2000.0, 0.0)), &[], 2, false), 0, "{}", a.issues());
+    for k in 1..4 {
+        let from = node_near(&a, 2000.0 * k as f64, 0.0);
+        assert_eq!(a.add_route(&ends(at_node(&a, from), free(2000.0 * (k + 1) as f64, 0.0)), &[], 2, false), 0, "{}", a.issues());
+    }
+    let ns = [0, 1, 2, 3, 4].map(|k| node_near(&a, 2000.0 * k as f64, 0.0));
+    for n in [ns[0], ns[4]] {
+        let (x, y) = (a.w.net.node_x[n as usize], a.w.net.node_y[n as usize]);
+        assert_eq!(a.add_station(1, n, x, y, 200, "S".into()), 0, "{}", a.issues());
+    }
+    (a, ns)
+}
+
+/// Piece `e` laid again with tracks running `ways` (`WAY_*`, slots from the left looking a to b), the slots in
+/// `loose` connecting to nothing at either end.
+fn lay(a: &mut TrackApi, e: u32, ways: &[u8], loose: &[usize]) {
+    let mut d = a.w.net.edge_data(e).unwrap();
+    let recs = ways
+        .iter()
+        .enumerate()
+        .map(|(s, &way)| TrackRec { key: s as u8, way, partner: None, join: [if loose.contains(&s) { Join::Loose } else { Join::Auto }; 2] })
+        .collect();
+    d.tracks = Tracks::from_recs(recs);
+    assert_eq!(a.run(Op::Edge { id: e, data: Some(d) }), 0, "{}", a.issues());
+}
+
+fn line(a: &mut TrackApi, stops: &[u32]) -> u32 {
+    let l = a.new_line_id();
+    assert_eq!(a.set_line_with_trains(l, stops, 4, 2, 0, 30.0, 180.0, 0, 0, "L".into()), 0, "{}", a.issues());
+    l
+}
+
+/// A line out on slot 2 of A B B A pieces and back on its partner, slot 3: the forward path names slot 2's key, the
+/// return run is the partner lookup's, and at the plain joint between the two A B B A pieces every move carries a
+/// slot on as the same slot (no crossover appears there). Saved and loaded, the same.
+#[test]
+fn t4033_a_line_on_slot_2_of_abba_out_and_its_partner_back() {
+    let (mut a, [w, x, m, y, e]) = chain();
+    let (xm, my) = (piece(&a, x, m), piece(&a, m, y));
+    let (ab, ba) = (crate::track::compile::WAY_AB, crate::track::compile::WAY_BA);
+    for p in [xm, my] {
+        // slot 1, the other westbound track, connects to nothing, so the line runs on slot 2
+        lay(&mut a, p, &[ab, ba, ba, ab], &[1]);
+    }
+    let recs = a.w.net.edge_recs[xm as usize].recs().to_vec();
+    assert_eq!(recs.iter().map(|r| r.partner).collect::<Vec<_>>(), [Some(1), Some(0), Some(3), Some(2)], "A B B A pairs 0-1 and 2-3");
+    let nt = a.w.net.node_compiled(m);
+    let slot_of = |t: crate::track::compile::TrackId| {
+        let tr = a.w.net.track(t);
+        a.w.net.edge_recs[tr.piece as usize].slot_of(tr.key).unwrap()
+    };
+    assert_eq!(nt.moves.len(), 3, "slots 0, 2 and 3 carry on through M; the loose slot 1 does not");
+    assert!(nt.moves.iter().all(|&(i, j)| slot_of(nt.ends[i as usize].track) == slot_of(nt.ends[j as usize].track)), "no move changes track at a plain joint");
+    let l = line(&mut a, &[e, w]);
+    let on = |path: &[u32], piece: u32| path.iter().filter(|&&p| path_edge(p) == piece).map(|&p| (path_key(p), path_dir(p))).collect::<Vec<_>>();
+    let path = a.w.net.line_path(l).to_vec();
+    assert_eq!((on(&path, xm), on(&path, my)), (vec![(2, 1)], vec![(2, 1)]), "out westbound on slot 2");
+    let back = a.w.net.back_path(l).unwrap();
+    assert_eq!((on(&back, xm), on(&back, my)), (vec![(3, 0)], vec![(3, 0)]), "back eastbound on its partner, slot 3");
+    assert!(a.w.net.line_back[l as usize].is_none(), "the partner lookup gives it: nothing routed is kept");
+    assert!(!a.w.net.line_broken[l as usize] && a.w.net.check_line(l).is_ok(), "the line runs");
+    let b = {
+        let mut b = api();
+        assert!(b.load(&a.save()));
+        b
+    };
+    assert_eq!(b.w.net.line_path(l), &path[..], "a load reads the same tracks");
+    assert_eq!(b.w.net.edge_recs[xm as usize], a.w.net.edge_recs[xm as usize]);
+    assert_eq!(b.save(), a.save());
+}
+
+/// One track of a double flipped (A A between X and Y, a two-way single bypass beside it): a line runs east on the
+/// double and comes back over the bypass, a return it keeps, since an A A double has no pairs.
+#[test]
+fn t4033_one_track_of_a_double_flipped_carries_a_line() {
+    let mut a = api();
+    assert_eq!(a.add_route(&ends(free(0.0, 0.0), free(2000.0, 0.0)), &[], 2, false), 0, "{}", a.issues());
+    let x = node_near(&a, 2000.0, 0.0);
+    assert_eq!(a.add_route(&ends(at_node(&a, x), free(6000.0, 0.0)), &[], 2, false), 0, "{}", a.issues());
+    let y = node_near(&a, 6000.0, 0.0);
+    assert_eq!(a.add_route(&ends(at_node(&a, y), free(8000.0, 0.0)), &[], 2, false), 0, "{}", a.issues());
+    assert_eq!(a.add_route(&ends(at_node(&a, x), at_node(&a, y)), &[4000.0, 400.0, 0.0, 0.0], 1, false), 0, "{}", a.issues());
+    let (w, e) = (node_near(&a, 0.0, 0.0), node_near(&a, 8000.0, 0.0));
+    for n in [w, e] {
+        let (px, py) = (a.w.net.node_x[n as usize], a.w.net.node_y[n as usize]);
+        assert_eq!(a.add_station(1, n, px, py, 200, "S".into()), 0, "{}", a.issues());
+    }
+    let xy = (0..a.w.net.edge_count() as u32).find(|&p| a.w.net.edge_ok(p) && a.w.net.edge_tracks[p as usize] == 2 && a.w.net.edge_a[p as usize] == x && a.w.net.edge_b[p as usize] == y).unwrap();
+    let ab = crate::track::compile::WAY_AB;
+    lay(&mut a, xy, &[ab, ab], &[]);
+    assert!(a.w.net.edge_recs[xy as usize].recs().iter().all(|r| r.partner.is_none()), "A A: no pairs");
+    assert!(a.w.net.piece_tracks(xy).all(|t| a.w.net.track(t).way == ab), "both tracks run east");
+    let l = line(&mut a, &[w, e]);
+    let path = a.w.net.line_path(l).to_vec();
+    assert!(path.iter().any(|&p| path_edge(p) == xy && path_dir(p) == 0), "east on the double: {path:?}");
+    let back = a.w.net.back_path(l).unwrap();
+    assert!(!back.iter().any(|&p| path_edge(p) == xy), "never west on it");
+    assert!(back.iter().any(|&p| a.w.net.edge_tracks[path_edge(p) as usize] == 1), "back over the bypass");
+    assert!(a.w.net.line_back[l as usize].is_some(), "a routed return, kept");
+    assert!(!a.w.net.line_broken[l as usize] && a.w.net.check_line(l).is_ok(), "the line runs");
+    // its other track carries a line too
+    let k = path.iter().find(|&&p| path_edge(p) == xy).map(|&p| path_key(p)).unwrap();
+    assert!(a.w.net.track_of(crate::track::net::entry(xy, 1 - k, 0)).is_some(), "the other track runs east as well");
+}
+
+/// A station is refused where a piece runs two tracks one way (its platforms serve one track each way until they
+/// lie on tracks, T-4035), and a double laid again as single track keeps its line (the entries take the track
+/// that runs their way, `rekey_ops`).
+#[test]
+fn t4033_stations_on_shared_ways_wait_and_relaid_tracks_keep_their_lines() {
+    let (mut a, [w, x, m, _, e]) = chain();
+    let xm = piece(&a, x, m);
+    let ab = crate::track::compile::WAY_AB;
+    let ba = crate::track::compile::WAY_BA;
+    let mut d = a.w.net.edge_data(piece(&a, w, x)).unwrap();
+    d.tracks = Tracks::from_recs(vec![TrackRec { key: 0, way: ab, partner: None, join: [Join::Auto; 2] }, TrackRec { key: 1, way: ba, partner: None, join: [Join::Auto; 2] }, TrackRec { key: 2, way: ab, partner: None, join: [Join::Auto; 2] }]);
+    assert_ne!(a.run(Op::Edge { id: piece(&a, w, x), data: Some(d) }), 0, "two tracks east into the station at W");
+    let l = line(&mut a, &[w, e]);
+    let mut d = a.w.net.edge_data(xm).unwrap();
+    d.tracks = Tracks::new(1);
+    assert_eq!(a.run(Op::Edge { id: xm, data: Some(d) }), 0, "{}", a.issues());
+    assert!(a.w.net.line_path(l).iter().all(|&p| a.w.net.track_of(p).is_some()), "every entry names a track that runs its way");
+    assert!(!a.w.net.line_broken[l as usize] && a.w.net.check_line(l).is_ok());
+    a.undo();
+    assert!(a.w.net.line_path(l).iter().all(|&p| a.w.net.track_of(p).is_some()) && a.w.net.check_line(l).is_ok(), "and back");
+}
diff --git a/trainworld/sim/src/track/wasm/trackplat_tests.rs b/trainworld/sim/src/track/wasm/trackplat_tests.rs
new file mode 100644
index 000000000..c9d267b00
--- /dev/null
+++ b/trainworld/sim/src/track/wasm/trackplat_tests.rs
@@ -0,0 +1,188 @@
+//! T-4035 (track rework stage e): platforms name their tracks, so a station stands on a piece with two tracks one way,
+//! and a track with no platform runs past it; at an anchor (a station off the track) and at a station node alike.
+
+use super::*;
+use crate::track::compile::{TrackId, WAY_AB, WAY_BA};
+use crate::track::capacity::ResKind;
+use crate::track::net::{entry, path_key, PlatformAt, StationData};
+use crate::track::tracks::TrackRec;
+
+fn api() -> TrackApi {
+    let mut a = TrackApi::new(-73.985, 40.758, true);
+    a.set_cash(1e9);
+    a
+}
+fn free(x: f64, y: f64) -> [f64; 5] {
+    [0.0, 0.0, x, y, 0.0]
+}
+fn ends(a: [f64; 5], b: [f64; 5]) -> Vec<f64> {
+    a.iter().chain(b.iter()).copied().collect()
+}
+fn node_near(a: &TrackApi, x: f64, y: f64) -> u32 {
+    let n = &a.w.net;
+    let d = |k: u32| (n.node_x[k as usize] - x).hypot(n.node_y[k as usize] - y);
+    (0..n.node_count() as u32).filter(|&k| n.node_ok(k)).min_by(|&p, &q| d(p).total_cmp(&d(q))).unwrap()
+}
+fn at_node(a: &TrackApi, n: u32) -> [f64; 5] {
+    [1.0, n as f64, a.w.net.node_x[n as usize], a.w.net.node_y[n as usize], 0.0]
+}
+fn piece(a: &TrackApi, m: u32, n: u32) -> u32 {
+    let net = &a.w.net;
+    (0..net.edge_count() as u32).find(|&e| net.edge_ok(e) && net.edge_a[e as usize] == m && net.edge_b[e as usize] == n).unwrap()
+}
+
+/// Doubles W (0, 0) - X - M - Y - E (8000, 0), 2 km each, with end stations at W and E; X to M and M to Y laid
+/// again as three tracks (from the left looking east: two-way, west, east; the west and east ones paired), so a way
+/// has two tracks and M is a plain joint between them.
+fn triple() -> (TrackApi, [u32; 5], [u32; 2]) {
+    let mut a = api();
+    assert_eq!(a.add_route(&ends(free(0.0, 0.0), free(2000.0, 0.0)), &[], 2, false), 0, "{}", a.issues());
+    for k in 1..4 {
+        let from = node_near(&a, 2000.0 * k as f64, 0.0);
+        assert_eq!(a.add_route(&ends(at_node(&a, from), free(2000.0 * (k + 1) as f64, 0.0)), &[], 2, false), 0, "{}", a.issues());
+    }
+    let ns = [0, 1, 2, 3, 4].map(|k| node_near(&a, 2000.0 * k as f64, 0.0));
+    for n in [ns[0], ns[4]] {
+        let (x, y) = (a.w.net.node_x[n as usize], a.w.net.node_y[n as usize]);
+        assert_eq!(a.add_station(1, n, x, y, 200, "S".into()), 0, "{}", a.issues());
+    }
+    let ps = [piece(&a, ns[1], ns[2]), piece(&a, ns[2], ns[3])];
+    for p in ps {
+        let mut d = a.w.net.edge_data(p).unwrap();
+        d.tracks = Tracks::from_recs((0..3).map(|s| TrackRec { key: s as u8, way: [WAY_AB | WAY_BA, WAY_BA, WAY_AB][s], partner: None, join: [Join::Auto; 2] }).collect());
+        assert_eq!(a.run(Op::Edge { id: p, data: Some(d) }), 0, "{}", a.issues());
+    }
+    assert!(a.w.net.edge_recs[ps[0] as usize].shares_a_way(true), "the two-way track runs with each of the others");
+    (a, ns, ps)
+}
+
+/// The track of key `key` on piece `e`.
+fn track(a: &TrackApi, e: u32, key: u8) -> TrackId {
+    a.w.net.piece_tracks(e).find(|&t| a.w.net.track(t).key == key).unwrap()
+}
+
+/// A line of `stops` on `path` as set by the player (no route asked for), from line `like`'s data; its issues.
+fn set_line(a: &mut TrackApi, like: u32, stops: &[u32], path: impl FnOnce(&TrackApi) -> Vec<u32>) -> (u32, u32) {
+    let path = path(a);
+    let id = a.new_line_id();
+    let mut d = a.w.net.line_data(like).unwrap();
+    d.stops = stops.to_vec();
+    d.path = path;
+    (id, a.run(Op::Line { id, data: Some(d) }))
+}
+
+/// W to E east: the doubles' eastbound tracks, `key` on the two triples.
+fn east(a: &TrackApi, ns: &[u32; 5], ps: [u32; 2], key: u8) -> Vec<u32> {
+    let net = &a.w.net;
+    vec![net.entry_for(piece(a, ns[0], ns[1]), 0), entry(ps[0], key, 0), entry(ps[1], key, 0), net.entry_for(piece(a, ns[3], ns[4]), 0)]
+}
+
+/// The platform resources at node `n` line `line` uses (its lines are blueprint until built: `build`), and per run
+/// passing `n` whether its track there has a stop point.
+fn platforms_at(a: &TrackApi, n: u32, line: u32) -> (usize, Vec<bool>) {
+    let cap = &a.w.svc.cap;
+    let res = (0..cap.res.len()).filter(|&r| cap.res[r].kind == ResKind::Platform && cap.res[r].node == n && cap.users_of(r).iter().any(|u| u.line == line)).count();
+    let net = &a.w.net;
+    let pts = a.w.svc.lines[line as usize].runs.iter().filter_map(|run| {
+        let k = run.nodes.iter().position(|&x| x == n)?;
+        let x = run.segs[k - 1];
+        Some(net.stop_point(n, net.d_arrive_side(x).unwrap_or(0), net.d_track(x.edge())).is_some())
+    }).collect();
+    (res, pts)
+}
+
+/// Everything built, so lines run and capacity counts them.
+fn build(a: &mut TrackApi) {
+    let ops: Vec<Op> = (0..a.w.net.edge_count() as u32).filter(|&e| a.w.net.edge_ok(e) && !a.w.net.edge_built[e as usize]).map(|e| {
+        let mut d = a.w.net.edge_data(e).unwrap();
+        d.built = true;
+        Op::Edge { id: e, data: Some(d) }
+    }).chain((0..a.w.net.node_count() as u32).filter_map(|n| {
+        let d = a.w.net.station_data(n).filter(|d| !d.built)?;
+        Some(Op::Station { node: n, data: Some(StationData { built: true, ..d }) })
+    })).collect();
+    if !ops.is_empty() {
+        assert_eq!(a.run(Op::Batch(ops)), 0, "{}", a.issues());
+    }
+}
+
+/// At a station node: platforms by slot on the west and east tracks of three, where a way has two tracks; by the
+/// node's axis it stays refused. A line on the two-way track runs past with no platform; one listing the station
+/// from it is refused; one on the east track stops and comes back on its partner; a path changing track inside the
+/// station is refused (no move does that at a plain joint).
+#[test]
+fn t4035_station_by_slot_on_three_tracks() {
+    let (mut a, ns, ps) = triple();
+    let m = ns[2];
+    let (x, y) = (a.w.net.node_x[m as usize], a.w.net.node_y[m as usize]);
+    assert_ne!(a.add_station(1, m, x, y, 200, "M".into()), 0, "by the axis: two tracks one way, refused");
+    let slots = [1u8, 2].map(|k| a.w.net.axis_slot(m, track(&a, ps[0], k)).unwrap());
+    let st = StationData { platform: 200, name: "M".into(), named: false, built: true, off: false, upgrades: 0, berth: None, day: 0, one: 0, fare: 0, own: String::new(), road: None, at: slots.map(|s| Some(PlatformAt::Slot(s))) };
+    assert_eq!(a.run(Op::Station { node: m, data: Some(st) }), 0, "by slot: {}", a.issues());
+    build(&mut a);
+    assert_eq!(a.w.net.station_tracks(m), 2, "priced on its two platforms' tracks");
+    let like = {
+        let id = a.new_line_id();
+        assert_eq!(a.set_line_with_trains(id, &[ns[0], ns[4]], 4, 2, 0, 30.0, 180.0, 0, 0, "L".into()), 0, "{}", a.issues());
+        id
+    };
+    let (past, n) = set_line(&mut a, like, &[ns[0], ns[4]], |a: &TrackApi| east(a, &ns, ps, 0));
+    assert_eq!(n, 0, "{}", a.issues());
+    assert!(a.w.svc.lines[past as usize].ok);
+    assert_eq!(platforms_at(&a, m, past), (0, vec![false, false]), "the two-way track has no platform at M");
+    let (_, n) = set_line(&mut a, like, &[ns[0], m, ns[4]], |a: &TrackApi| east(a, &ns, ps, 0));
+    assert_ne!(n, 0, "a stop at M from the two-way track: neither run can stop");
+    let (stop, n) = set_line(&mut a, like, &[ns[0], m, ns[4]], |a: &TrackApi| east(a, &ns, ps, 2));
+    assert_eq!(n, 0, "{}", a.issues());
+    let ls = &a.w.svc.lines[stop as usize];
+    assert!(ls.ok && ls.runs.iter().all(|r| r.stop_s.len() == 3 && !r.passes(1)), "both runs stop at M");
+    assert_eq!(platforms_at(&a, m, stop), (2, vec![true, true]), "on its own platform each way");
+    let back = a.w.net.back_path(stop).unwrap();
+    assert!(back.iter().any(|&p| path_edge(p) == ps[0] && path_key(p) == 1), "back on the east track's partner");
+    let mut jump = east(&a, &ns, ps, 2);
+    jump[2] = entry(ps[1], 0, 0);
+    let (_, n) = set_line(&mut a, like, &[ns[0], m, ns[4]], |_: &TrackApi| jump);
+    assert_ne!(n, 0, "changing track inside the station: no move");
+    // saved and loaded, the same
+    let mut b = api();
+    assert!(b.load(&a.save()));
+    assert_eq!(b.w.net.station_data(m), a.w.net.station_data(m));
+    assert_eq!(b.save(), a.save());
+}
+
+/// At an anchor on X to M (no ports, its platforms on the west and east tracks): the same, the compile cutting every
+/// track there; the stop's platform stands at the anchor.
+#[test]
+fn t4035_anchor_on_three_tracks() {
+    let (mut a, ns, ps) = triple();
+    let e = ps[0];
+    let mid = a.w.net.edge_len[e as usize] / 2.0;
+    let (px, py, _) = crate::track::geom::pos_at(a.w.net.edge_pieces(e), mid);
+    let s = a.w.net.alloc_node();
+    assert_eq!(a.run(Op::Node { id: s, data: Some(crate::track::net::NodeData { x: px, y: py, level: 0, flying: false }) }), 0);
+    let at = [1u8, 2].map(|k| Some(PlatformAt::On { piece: e, key: k, mid }));
+    let st = StationData { platform: 200, name: "S".into(), named: false, built: true, off: false, upgrades: 0, berth: None, day: 0, one: 0, fare: 0, own: String::new(), road: None, at };
+    assert_eq!(a.run(Op::Station { node: s, data: Some(st) }), 0, "{}", a.issues());
+    assert_eq!(a.w.net.anchors_on(e).collect::<Vec<_>>(), vec![s]);
+    build(&mut a);
+    let like = {
+        let id = a.new_line_id();
+        assert_eq!(a.set_line_with_trains(id, &[ns[0], ns[4]], 4, 2, 0, 30.0, 180.0, 0, 0, "L".into()), 0, "{}", a.issues());
+        id
+    };
+    let (past, n) = set_line(&mut a, like, &[ns[0], ns[4]], |a: &TrackApi| east(a, &ns, ps, 0));
+    assert_eq!(n, 0, "{}", a.issues());
+    assert!(a.w.svc.lines[past as usize].runs[0].nodes.contains(&s), "it runs through the cut");
+    assert_eq!(platforms_at(&a, s, past), (0, vec![false, false]), "and past: the two-way track has no platform");
+    let (_, n) = set_line(&mut a, like, &[ns[0], s, ns[4]], |a: &TrackApi| east(a, &ns, ps, 0));
+    assert_ne!(n, 0, "a stop at the anchor from the two-way track is refused");
+    let (stop, n) = set_line(&mut a, like, &[ns[0], s, ns[4]], |a: &TrackApi| east(a, &ns, ps, 2));
+    assert_eq!(n, 0, "{}", a.issues());
+    let ls = &a.w.svc.lines[stop as usize];
+    assert!(ls.ok && ls.runs.iter().all(|r| r.stop_s.len() == 3 && !r.passes(1)), "both runs stop at the anchor");
+    assert_eq!(platforms_at(&a, s, stop), (2, vec![true, true]));
+    let mut b = api();
+    assert!(b.load(&a.save()));
+    assert_eq!(b.w.net.station_data(s), a.w.net.station_data(s));
+    assert_eq!(b.save(), a.save());
+}
diff --git a/trainworld/sim/src/track/wasm/trackrec_tests.rs b/trainworld/sim/src/track/wasm/trackrec_tests.rs
new file mode 100644
index 000000000..5d812f933
--- /dev/null
+++ b/trainworld/sim/src/track/wasm/trackrec_tests.rs
@@ -0,0 +1,161 @@
+//! T-4031 (track rework stage a): a piece's tracks as records, and the one new thing they hold, a track end that
+//! connects to nothing across its node (`Join::Loose`).
+
+use super::*;
+use crate::track::compile::span_slot;
+
+fn api() -> TrackApi {
+    let mut a = TrackApi::new(-73.985, 40.758, true);
+    a.set_cash(1e9);
+    a
+}
+fn free(x: f64, y: f64) -> [f64; 5] {
+    [0.0, 0.0, x, y, 0.0]
+}
+fn ends(a: [f64; 5], b: [f64; 5]) -> Vec<f64> {
+    a.iter().chain(b.iter()).copied().collect()
+}
+fn node_near(a: &TrackApi, x: f64, y: f64) -> u32 {
+    let n = &a.w.net;
+    let d = |k: u32| (n.node_x[k as usize] - x).hypot(n.node_y[k as usize] - y);
+    (0..n.node_count() as u32).filter(|&k| n.node_ok(k)).min_by(|&p, &q| d(p).total_cmp(&d(q))).unwrap()
+}
+fn at_node(a: &TrackApi, n: u32) -> [f64; 5] {
+    [1.0, n as f64, a.w.net.node_x[n as usize], a.w.net.node_y[n as usize], 0.0]
+}
+/// The piece ending at node `n` and running toward it from the west.
+fn piece_into(a: &TrackApi, n: u32) -> u32 {
+    let net = &a.w.net;
+    (0..net.edge_count() as u32).find(|&e| net.edge_ok(e) && net.end_node(e, 1) == n && net.node_x[net.edge_a[e as usize] as usize] < net.node_x[n as usize]).unwrap()
+}
+fn loaded(bytes: &[u8]) -> TrackApi {
+    let mut b = api();
+    assert!(b.load(bytes));
+    b
+}
+/// Moves through node `n` (`NodeTracks::moves`).
+fn moves(net: &crate::track::net::Network, n: u32) -> usize {
+    net.node_compiled(n).moves.len()
+}
+
+/// A double from A (0, 0) to B (3000, 0) and on to C (6000, 0), drawn as two strokes, so B is a plain node; and the
+/// piece A to B, its end b at B.
+fn abc() -> (TrackApi, [u32; 3], u32) {
+    let mut a = api();
+    assert_eq!(a.add_route(&ends(free(0.0, 0.0), free(3000.0, 0.0)), &[], 2, false), 0, "{}", a.issues());
+    let b = node_near(&a, 3000.0, 0.0);
+    assert_eq!(a.add_route(&ends(at_node(&a, b), free(6000.0, 0.0)), &[], 2, false), 0, "{}", a.issues());
+    let (na, nc) = (node_near(&a, 0.0, 0.0), node_near(&a, 6000.0, 0.0));
+    let e = piece_into(&a, b);
+    (a, [na, b, nc], e)
+}
+
+/// Piece `e` with the track that runs a to b loose at its end b (right-hand running: the right one, slot 1).
+fn loosen(a: &mut TrackApi, e: u32) -> EdgeData {
+    let mut d = a.w.net.edge_data(e).unwrap();
+    let slot = span_slot(2, true, 0).unwrap() as usize;
+    d.tracks.recs_mut()[slot].join[1] = Join::Loose;
+    assert_eq!(a.run(Op::Edge { id: e, data: Some(d.clone()) }), 0, "{}", a.issues());
+    d
+}
+
+#[test]
+fn t4031_a_loose_track_end_connects_nothing_across_its_node_and_keeps_through_save_and_undo() {
+    let (mut a, [na, nb, nc], e) = abc();
+    let before = moves(&a.w.net, nb);
+    assert_eq!(before, 2, "a plain node between two doubles: each track carries on");
+    assert!(a.w.net.find_path(na, nc, None).is_some() && a.w.net.find_path(nc, na, None).is_some());
+    let d = loosen(&mut a, e);
+    assert_eq!(moves(&a.w.net, nb), 1, "the loose track's move through B is gone, the other track's stays");
+    assert!(a.w.net.find_path(na, nc, None).is_none(), "no way east: the eastbound track stops at B");
+    assert!(a.w.net.find_path(nc, na, None).is_some(), "the westbound track still runs through");
+    assert!(a.w.net.piece_tracks(e).any(|t| a.w.net.track(t).loose == [false, true]));
+    // a save holds it (TWT7 body level 4) and a load compiles it the same
+    let b = loaded(&a.save());
+    let eb = piece_into(&b, node_near(&b, 3000.0, 0.0));
+    assert_eq!(b.w.net.edge_data(eb).unwrap().tracks, d.tracks);
+    assert_eq!(moves(&b.w.net, node_near(&b, 3000.0, 0.0)), 1);
+    assert_eq!(b.save(), a.save(), "and writes the same bytes again");
+    // undo puts the join back, redo takes it again
+    assert_eq!(a.undo(), 0, "{}", a.issues());
+    assert_eq!(moves(&a.w.net, nb), before);
+    assert!(a.w.net.edge_data(e).unwrap().tracks.recs().iter().all(|t| t.join == [Join::Auto; 2]));
+    assert_eq!(a.redo(), 0, "{}", a.issues());
+    assert_eq!(a.w.net.edge_data(e).unwrap().tracks, d.tracks);
+}
+
+#[test]
+fn t4031_a_split_keeps_the_loose_end_on_its_half_and_a_join_of_the_pieces_keeps_the_joint() {
+    let (mut a, [_, nb, _], e) = abc();
+    // joining pieces across a plain joint (a station placed or removed near it) takes B away, unless a track ends
+    // loose there
+    assert!(a.unjoin_near(e, 1500.0, 2000.0).is_some(), "the two doubles join across B");
+    loosen(&mut a, e);
+    assert!(a.unjoin_near(e, 1500.0, 2000.0).is_none(), "B stays while the eastbound track ends loose there");
+    // a point added mid-piece splits it at a plain node: the half at B keeps the loose end, the new node has none
+    let (x, y) = (1500.0, 0.0);
+    let (px, py, _) = crate::track::geom::pos_at(a.w.net.edge_pieces(e), a.w.net.project(e, x, y).0);
+    assert_eq!(a.add_point(e, px, py), 0, "{}", a.issues());
+    let mid = node_near(&a, 1500.0, 0.0);
+    let east = piece_into(&a, nb);
+    let west = piece_into(&a, mid);
+    assert!(a.w.net.edge_data(east).unwrap().tracks.loose_at(1));
+    assert!(!a.w.net.edge_data(east).unwrap().tracks.loose_at(0) && !a.w.net.edge_data(west).unwrap().tracks.loose_at(1));
+    assert_eq!(moves(&a.w.net, mid), 2);
+    // B keeps its one through move after the split
+    assert_eq!(moves(&a.w.net, nb), 1);
+}
+
+#[test]
+fn t4031_a_double_keeps_its_keys_when_one_track_is_removed_and_gets_both_back_on_undo() {
+    let (mut a, _, e) = abc();
+    let keys = |a: &TrackApi| a.w.net.edge_data(e).unwrap().tracks.recs().iter().map(|t| t.key).collect::<Vec<_>>();
+    assert_eq!(keys(&a), [0, 1]);
+    // remove the track running b to a (slot 0 with right-hand running): the eastbound track, key 1, is left
+    assert_eq!(a.delete_track(e, 1), 0, "{}", a.issues());
+    assert_eq!(keys(&a), [1]);
+    assert_eq!(a.w.net.oneway_of(e), 1, "the kept track runs a to b, set as the player's");
+    let t = a.w.net.piece_tracks(e).next().unwrap();
+    assert_eq!((a.w.net.track(t).key, a.w.net.track(t).partner), (1, None));
+    assert_eq!(a.undo(), 0, "{}", a.issues());
+    assert_eq!(keys(&a), [0, 1]);
+    let ts: Vec<_> = a.w.net.piece_tracks(e).map(|t| a.w.net.track(t)).collect();
+    assert!(ts.iter().all(|t| t.partner.is_some_and(|p| a.w.net.track(p).key != t.key)), "partners from the records");
+}
+
+/// T-4031: a station at B and a line A-B-C, then the eastbound track loose at B: what the edit does to the line
+/// (recorded in notes/T-4031.md for T-4024, which makes loose ends with a tool).
+#[test]
+fn t4031_a_loose_end_at_a_station_a_line_runs_through() {
+    let (mut a, [na, nb, nc], e) = abc();
+    for n in [na, nb, nc] {
+        let (x, y) = (a.w.net.node_x[n as usize], a.w.net.node_y[n as usize]);
+        assert_eq!(a.add_station(1, n, x, y, 200, format!("S{n}")), 0, "{}", a.issues());
+    }
+    let (na, nb, nc) = (node_near(&a, 0.0, 0.0), node_near(&a, 3000.0, 0.0), node_near(&a, 6000.0, 0.0));
+    let l = a.new_line_id();
+    assert_eq!(a.set_line_with_trains(l, &[na, nb, nc], 4, 2, 0, 30.0, 180.0, 0, 0, "L".into()), 0, "{}", a.issues());
+    assert!(!a.w.net.line_broken[l as usize]);
+    let e = piece_into(&a, nb);
+    let mut d = a.w.net.edge_data(e).unwrap();
+    d.tracks.recs_mut()[span_slot(2, true, 0).unwrap() as usize].join[1] = Join::Loose;
+    let r = a.run(Op::Edge { id: e, data: Some(d) });
+    let broken = a.w.net.line_broken[l as usize];
+    eprintln!("loose at a station a line runs through: run {r} ({}), line broken {broken}, path {:?}", a.issues(), a.w.net.line_path(l));
+    // the line cannot run east through B on that track: either the edit is refused or the line is left broken,
+    // never left running across a move the node does not hold
+    assert!(r != 0 || broken || a.w.net.find_path(na, nc, None).is_some());
+}
+
+#[test]
+fn t4031_what_the_model_cannot_hold_yet_is_refused() {
+    let (mut a, _, e) = abc();
+    let d = a.w.net.edge_data(e).unwrap();
+    let mut left = d.clone();
+    left.tracks.recs_mut()[0].join[0] = Join::Left;
+    assert_ne!(a.run(Op::Edge { id: e, data: Some(left) }), 0, "left and right are single track's joins");
+    assert_eq!(a.w.net.edge_data(e).unwrap(), d);
+    let mut way = d.clone();
+    way.tracks.recs_mut()[0].way = 1;
+    assert_eq!(a.run(Op::Edge { id: e, data: Some(way) }), 0, "T-4033: a double's track may have a way of its own");
+}
