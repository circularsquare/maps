@@ -0,0 +1,234 @@
+//! Stop points (T-3959, track rework stage 4a1; notes/T-3444-design/01-model.md "Stop point"): where a train stops on
+//! one track at one station, derived from the station's platforms (`net::Platform`), never placed. A platform lies at
+//! its station's node, the stop point's derived stop node: at a node with ports, centred on it; at an anchor (T-4035,
+//! a station off the track) on its piece's tracks, the compile cutting them there. A train arriving there stops at
+//! the platform beside the track it runs on: where the platforms name their tracks (`PlatformAt`), the one on its
+//! track; else on double track at a through node the platform on its side of the node's axis, on single track or at a
+//! track end or junction any platform the station has. Capacity's platform tracks, the turn places and which stops a
+//! run passes on another track (T-3332) all read it. Derived on each ask from the platform records rather than kept:
+//! they change with an edit before the network is derived again.
+
+use super::capacity::active_node_tracks;
+use super::compile::TrackId;
+use super::derived::DEntry;
+use super::net::{path_dir, path_edge, Network};
+
+/// `Network::stop_nodes`.
+#[derive(Clone, Debug, Default, PartialEq)]
+pub struct StopNodes {
+    pub nodes: Vec<u32>,
+    pub at: Vec<usize>,
+    /// Per node after the first, the piece entry arriving there: `arr[j]` also leaves node `j`.
+    pub arr: Vec<u32>,
+    pub off: Vec<f64>,
+    /// Per node, the path entries wholly before it, and whether it lies inside the entry after them (an anchor).
+    pub pk: Vec<usize>,
+    pub inner: Vec<bool>,
+}
+
+impl StopNodes {
+    /// The path from node `j` on starts at this entry.
+    pub fn path_from(&self, j: usize) -> usize {
+        self.pk[j]
+    }
+    /// The path up to node `j` ends before this entry.
+    pub fn path_to(&self, j: usize) -> usize {
+        self.pk[j] + self.inner[j] as usize
+    }
+}
+
+/// A stop point: the platform a train stops at, and the key of its track at the stop node.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct StopPoint {
+    /// The platform's id (`Network::station_platforms`).
+    pub platform: u32,
+    /// Its track at the node as capacity keys platform tracks: 0 where the node has one constructed track (a single
+    /// track's one platform track, both ways); else where the platforms name their tracks the track's slot
+    /// (`axis_slot`), else the side of the node trains arrive from.
+    pub key: u8,
+}
+
+impl Network {
+    /// The stop point a train arriving at node `n` from its side `side_in` on track `t` stops at; None where no
+    /// platform there serves its track (the other track of a one-track station, T-3332; a track with no platform at
+    /// a station whose platforms name their tracks) or the node has no station.
+    pub fn stop_point(&self, n: u32, side_in: u8, t: TrackId) -> Option<StopPoint> {
+        if self.platform_len(n) == 0 {
+            return None;
+        }
+        let one = active_node_tracks(self, n) == 1;
+        if self.by_track(n) {
+            let platform = self.platform_on(n, t)?;
+            let key = if one { 0 } else { self.axis_slot(n, t)? };
+            return Some(StopPoint { platform, key });
+        }
+        let [along, against] = self.station_platforms(n);
+        let beside = self.node_tracks(n) >= 2 && self.node_ports[n as usize].n == 2;
+        let platform = if !beside {
+            if along.is_some() { 2 * n } else { 2 * n + 1 }
+        } else if (side_in == 0) == self.axis_along_heading(n) {
+            along.map(|_| 2 * n)?
+        } else {
+            against.map(|_| 2 * n + 1)?
+        };
+        let key = if one { 0 } else { side_in };
+        Some(StopPoint { platform, key })
+    }
+
+    /// T-4035: a piece path's nodes (`path_nodes`) with the anchors its pieces are cut at put in, in running order:
+    /// the nodes, each piece node's place among them (`at`, `path.len() + 1`), and per node after the first the piece
+    /// entry arriving there (`arr`, for `match_run`'s path). So a line stops at an anchor its path runs through.
+    pub fn stop_nodes(&self, path: &[u32]) -> StopNodes {
+        let mut sn = StopNodes::default();
+        let Some(&p0) = path.first() else { return sn };
+        sn.nodes.push(self.path_nodes(p0).0);
+        sn.at.push(0);
+        sn.off.push(0.0);
+        sn.pk.push(0);
+        sn.inner.push(false);
+        let mut s = 0.0;
+        for (k, &p) in path.iter().enumerate() {
+            let e = path_edge(p);
+            let len = self.edge_len[e as usize];
+            let mut inner: Vec<u32> = self.anchors_on(e).collect();
+            if path_dir(p) == 1 {
+                inner.reverse();
+            }
+            for n in inner {
+                let mid = self.anchor_of(n).map_or(0.0, |a| a.1);
+                sn.nodes.push(n);
+                sn.arr.push(p);
+                sn.off.push(s + if path_dir(p) == 0 { mid } else { len - mid });
+                sn.pk.push(k);
+                sn.inner.push(true);
+            }
+            s += len;
+            sn.nodes.push(self.path_nodes(p).1);
+            sn.arr.push(p);
+            sn.off.push(s);
+            sn.pk.push(k + 1);
+            sn.inner.push(false);
+            sn.at.push(sn.nodes.len() - 1);
+        }
+        sn
+    }
+
+    /// T-4036: the nodes a run over `path` from stop `first` to stop `last` stops among (`match_run`'s): where no stop
+    /// of `stops` is an anchor the piece path's nodes as they always were (`at` one to one, `arr[k]` = `path[k]`);
+    /// else `stop_nodes`, without the nodes before `first` and after `last` where they are anchors on the path's
+    /// first and last pieces (a terminus inside a piece: the path holds the whole piece, the run starts or ends
+    /// there). `at` gives each piece node's place (0 for one left out before the start, the last for one after
+    /// the end); `off` each node's distance along the path from the first, m.
+    pub fn stop_nodes_for(&self, path: &[u32], stops: &[u32]) -> StopNodes {
+        self.stop_nodes_ends(path, stops.first().copied(), stops.last().copied(), self.stops_at_anchors(stops))
+    }
+
+    /// `stop_nodes_for` with the run's ends `first` and `last` and whether to put the anchors in (`anchors`: else the
+    /// piece nodes alone).
+    pub fn stop_nodes_ends(&self, path: &[u32], first: Option<u32>, last: Option<u32>, anchors: bool) -> StopNodes {
+        if !anchors {
+            let mut sn = StopNodes::default();
+            let Some(&p0) = path.first() else { return sn };
+            sn.nodes.push(self.path_nodes(p0).0);
+            sn.at.push(0);
+            sn.off.push(0.0);
+            sn.pk.push(0);
+            sn.inner.push(false);
+            for &p in path {
+                sn.nodes.push(self.path_nodes(p).1);
+                sn.arr.push(p);
+                sn.off.push(sn.off[sn.off.len() - 1] + self.edge_len[path_edge(p) as usize]);
+                sn.pk.push(sn.nodes.len() - 1);
+                sn.inner.push(false);
+                sn.at.push(sn.nodes.len() - 1);
+            }
+            return sn;
+        }
+        let mut sn = self.stop_nodes(path);
+        let (Some(first), Some(last)) = (first, last) else { return sn };
+        if sn.at.len() < 2 {
+            return sn;
+        }
+        // the last piece's anchors, from its end back, then the first's
+        let (a, b) = (sn.at[sn.at.len() - 2], sn.at[sn.at.len() - 1]);
+        if let Some(j) = (a + 1..b).rev().find(|&j| sn.nodes[j] == last && self.anchor_of(last).is_some()) {
+            sn.nodes.truncate(j + 1);
+            sn.arr.truncate(j);
+            sn.off.truncate(j + 1);
+            sn.pk.truncate(j + 1);
+            sn.inner.truncate(j + 1);
+            for x in sn.at.iter_mut() {
+                *x = (*x).min(j);
+            }
+        }
+        let end = sn.at[1].min(sn.nodes.len() - 1);
+        if let Some(i) = (1..end).find(|&i| sn.nodes[i] == first && self.anchor_of(first).is_some()) {
+            sn.nodes.drain(..i);
+            sn.arr.drain(..i);
+            sn.pk.drain(..i);
+            sn.inner.drain(..i);
+            let o = sn.off[i];
+            sn.off.drain(..i);
+            for x in sn.off.iter_mut() {
+                *x -= o;
+            }
+            for x in sn.at.iter_mut() {
+                *x = x.saturating_sub(i);
+            }
+        }
+        sn
+    }
+
+    /// `stop_reversals` of `path` as places in its stop nodes `sn` (`stop_nodes_for`).
+    pub fn stop_turns(&self, sn: &StopNodes, path: &[u32]) -> Vec<usize> {
+        self.stop_reversals(path).into_iter().map(|k| sn.at[k]).collect()
+    }
+
+    /// `path_reversals` of `path` as places in its stop nodes `sn`.
+    pub fn path_turns(&self, sn: &StopNodes, path: &[u32]) -> Vec<usize> {
+        self.path_reversals(path).into_iter().map(|k| sn.at[k]).collect()
+    }
+
+    /// A stop of `stops` is an anchor (T-4035): stops are then matched on `stop_nodes`.
+    pub fn stops_at_anchors(&self, stops: &[u32]) -> bool {
+        !self.dedges_empty() && stops.iter().any(|&s| self.anchor_of(s).is_some())
+    }
+
+    /// T-4035: `run_passes` on a run's derived entries (`segs`, `stop_idx` into its nodes, anchors among them): per
+    /// stop whether its trains pass it on a track with no platform there.
+    pub fn d_run_passes(&self, segs: &[DEntry], nodes: &[u32], stop_idx: &[u32], circle: bool) -> Vec<bool> {
+        stop_idx.iter().map(|&k| {
+            let k = k as usize;
+            let n = nodes[k];
+            if self.one_side(n).is_none() && !self.by_track(n) {
+                return false;
+            }
+            let (side, x) = if k > 0 {
+                (self.d_arrive_side(segs[k - 1]), segs[k - 1])
+            } else if circle {
+                (segs.last().and_then(|&x| self.d_arrive_side(x)), *segs.last().unwrap())
+            } else {
+                let p = self.d_pentry(segs[0]);
+                (self.port_side(path_edge(p), path_dir(p)), segs[0])
+            };
+            // (at a cut no side: an anchor's platforms name their tracks)
+            let side = if self.d_inner_to(x) || (k == 0 && self.anchor_of(n).is_some()) { Some(0) } else { side };
+            side.and_then(|s| self.stop_point(n, s, self.d_track(x.edge()))).is_none()
+        }).collect()
+    }
+
+    /// The tracks node `n`'s platforms serve, constructed: 0 with no station, 1 at a one-track station, one per
+    /// platform where they name their tracks, else the node's constructed tracks (a station on single track has one,
+    /// its passing loop drawn, not yet track).
+    pub fn platform_tracks(&self, n: u32) -> u8 {
+        if self.platform_len(n) == 0 {
+            0
+        } else if self.by_track(n) {
+            self.station_tracks(n).min(active_node_tracks(self, n))
+        } else if self.one_track(n) {
+            1
+        } else {
+            active_node_tracks(self, n)
+        }
+    }
+}
