diff --git a/trainworld/sim/src/track/wasm/stopchip.rs b/trainworld/sim/src/track/wasm/stopchip.rs
new file mode 100644
index 000000000..9a7db6a29
--- /dev/null
+++ b/trainworld/sim/src/track/wasm/stopchip.rs
@@ -0,0 +1,44 @@
+//! The stop list's track chip (T-3962, notes/T-3444-design/04-stops.md "The track chip in the stop list"): which
+//! station each run of a line stops at where the two differ or a run could stop at another, and the edit that picks one.
+
+use super::*;
+
+#[wasm_bindgen]
+impl TrackApi {
+    /// Rail line `id`'s stops the chip shows (`Network::stop_ways`), each as: stop index, run 0's heading through it
+    /// (radians, world frame), the station run 0 and run 1 stop at (-1: it passes), then per run a count and the
+    /// stations it could stop at. Empty for none, and for a bus or ferry line.
+    pub fn line_stop_picks(&self, id: u32) -> Vec<f64> {
+        let n = &self.w.net;
+        if !n.line_ok(id) || n.is_bus(id) || n.line_ferry.get(id as usize).is_some_and(|f| f.is_some()) {
+            return vec![];
+        }
+        let mut out = vec![];
+        for w in n.stop_ways(id) {
+            let st = |m: u32| if m == u32::MAX { -1.0 } else { m as f64 };
+            out.extend([w.index as f64, w.heading, st(w.at[0]), st(w.at[1])]);
+            for c in &w.choices {
+                out.push(c.len() as f64);
+                out.extend(c.iter().map(|&m| m as f64));
+            }
+        }
+        out
+    }
+
+    /// Line `id`'s stop at station `stop`, for its run heading `heading` (radians, world frame), to stop at station
+    /// `at`: its own platform, or one beside serving that way. One undoable edit; 0 done, 1 so already, otherwise
+    /// refused.
+    pub fn set_stop_pick(&mut self, id: u32, stop: u32, heading: f64, at: u32) -> u32 {
+        let Some(mut d) = self.w.net.line_data(id) else { return self.refuse(Issue::NoSuchLine { line: id }) };
+        if d.bus.is_some() || d.ferry.is_some() || !d.stops.contains(&stop) {
+            return self.refuse(Issue::LinePath { line: id });
+        }
+        let Some(picks) = self.w.net.picks_with(id, stop, heading, at) else { return self.refuse(Issue::LinePath { line: id }) };
+        let sorted = |p: &[(u32, u32)]| { let mut v = p.to_vec(); v.sort(); v };
+        if sorted(&picks) == sorted(&d.picks) {
+            return 1;
+        }
+        d.picks = picks;
+        self.run(Op::Line { id, data: Some(d) })
+    }
+}
