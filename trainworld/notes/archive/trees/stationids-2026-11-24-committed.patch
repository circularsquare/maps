+/// TWT7's body up to its lines (T-3953, notes/T-3444-design/07-saves.md): the frame, then nodes without stations,
+/// stations naming their node, the line sets, and one bundle per piece with its tracks. The fields the rework's later
+/// stages use are written as absent: a node's joins, line sets, a track's purpose and offset profile.
+fn body(w: &mut W, net: &Network, nodes: &[u32], edges: &[u32], node_id: &[u32]) {
+    w.0.extend_from_slice(MAGIC_TWT7);
+    w.0.extend_from_slice(&net.origin_lon.to_le_bytes());
+    w.0.extend_from_slice(&net.origin_lat.to_le_bytes());
+    w.u(BODY_LEVEL as u64);
+    w.u(net.frame_kind as u64);
+    w.u(net.right_hand as u64);
+    // nodes: position, level, flags (bit 0 flying; bit 1, joins of its own, not yet written)
+    w.u(nodes.len() as u64);
+    let (mut px, mut py) = (0.0, 0.0);
+    for &n in nodes {
+        let i = n as usize;
+        w.mm(net.node_x[i] - px);
+        w.mm(net.node_y[i] - py);
+        (px, py) = (net.node_x[i], net.node_y[i]);
+        w.i(net.node_level[i] as i64);
+        w.u(net.node_flying[i] as u64);
+    }
+    // stations, in node order: the node as a delta from the last, flags (bit 0 constructed, 1 switched off, 2 a
+    // name the player typed), upgrades, name
+    let stations: Vec<u32> = nodes.iter().enumerate().filter(|(_, &n)| net.platform_len(n) > 0).map(|(i, _)| i as u32).collect();
+    w.u(stations.len() as u64);
+    let mut prev = 0u32;
+    for &i in &stations {
+        let n = nodes[i as usize];
+        w.u((i - prev) as u64);
+        prev = i;
+        w.u(net.station_built(n) as u64 | ((net.station_off(n) && !net.station_built(n)) as u64) << 1 | (net.station_named(n) as u64) << 2);
+        w.u(net.station_upgrades(n) as u64);
+        w.s(net.station_name(n));
+    }
+    // T-3959 (body level 3): the stations' platforms, in station order: the station (its place among those above) as
+    // a delta from the last platform's, flags (bit 0 beside the track against the node's axis, else along it; bits 1-3
+    // 1 its track (T-4035, `PlatformAt`), 2-3 reserved for later stages, each a field after the flags: 1 its place as
+    // the bundle + 1 (0 across its station's node), the track's slot (across the node, looking along its axis) and
+    // its middle's chainage on the bundle in mm (0 across the node), 2 a width in cm, 3 its faces), its length in m.
+    // Without bit 1 a platform lies across its station's node beside the track along or against its axis.
+    let platforms: Vec<(u32, bool, u16, Option<PlatformAt>)> = stations
+        .iter()
+        .enumerate()
+        .flat_map(|(k, &i)| net.station_platforms(nodes[i as usize]).into_iter().zip([false, true]).filter_map(move |(p, against)| p.map(|p| (k as u32, against, p.len, p.at))))
+        .collect();
+    let bundle_of = |e: u32| edges.iter().position(|&x| x == e).map_or(0, |i| i as u64 + 1);
+    w.u(platforms.len() as u64);
+    let mut prev = 0u32;
+    for (k, against, len, at) in platforms {
+        w.u((k - prev) as u64);
+        prev = k;
+        w.u(against as u64 | (at.is_some() as u64) << 1);
+        match at {
+            None => {}
+            Some(PlatformAt::Slot(s)) => {
+                w.u(0);
+                w.u(s as u64);
+                w.u(0);
+            }
+            Some(PlatformAt::On { piece, key, mid }) => {
+                w.u(bundle_of(piece));
+                w.u(net.edge_recs[piece as usize].slot_of(key).unwrap_or(0) as u64);
+                w.u((mid * 1000.0).round().max(0.0) as u64);
+            }
+        }
+        w.u(len as u64);
+    }
+    // line sets (a track "Only for" some lines): none yet
+    w.u(0);
+    // bundles, one per piece: its nodes as deltas, flags (bit 0 constructed, 1 switched off, 2 drawn-through
+    // points, 3 a crossover's diagonal, 4 grade-separated, 5-7 `TrackKind`, 8 its tracks' joins follow; below body
+    // level 4, 8-11 single track's joins), then its tracks from the left, each its way in bits 0-1, purpose 2-3 (0
+    // any line), an offset profile in bit 4 (none), and its partner's slot + 1 above (0 none), then with bit 8 its
+    // joins; then PIs and drawn-through points as TWT6's
+    w.u(edges.len() as u64);
+    let mut prev_a = 0i64;
+    for &e in edges {
+        let d = net.edge_data(e).unwrap();
+        let a = node_id[d.a as usize] as i64;
+        w.i(a - prev_a);
+        w.i(node_id[d.b as usize] as i64 - a);
+        prev_a = a;
+        let recs = d.tracks.recs();
+        let joined = recs.iter().any(|t| t.join != [Join::Auto; 2]);
+        w.u(d.built as u64 | ((d.off && !d.built) as u64) << 1 | (!d.thru.is_empty() as u64) << 2 | (d.crossover as u64) << 3 | (d.sep as u64) << 4 | (d.kind as u64) << 5 | (joined as u64) << 8);
+        let ways = file_tracks(&d.tracks, net.right_hand);
+        w.u(recs.len() as u64);
+        for (t, (way, partner)) in recs.iter().zip(ways) {
+            w.u(way as u64 | partner.map_or(0, |p| p as u64 + 1) << 5);
+            if joined {
+                w.u(t.join[0].code() as u64 | (t.join[1].code() as u64) << 2);
+            }
+        }
+        pis_out(w, net, &d);
+    }
+}
