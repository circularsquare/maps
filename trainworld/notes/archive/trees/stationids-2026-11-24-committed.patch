+/// 4a2's picks at anchors: a click on the one-track station E takes W beside it for the way E does not serve, a
+/// two-way stop in one click, each run at its own platform, as at the split stations.
+#[test]
+fn t4036_picks_at_anchors_as_split() {
+    let (split, cut, [p, q, e, w]) = one_track_pair();
+    let mut out = vec![];
+    for world in [split, cut] {
+        let mut api = api_of(world);
+        let id = api.world_mut().net.alloc_line();
+        assert_eq!(api.set_line_with_trains(id, &[p, q], 4, 2, 1, 30.0, 180.0, 0, 0, "L".into()), 0, "{}", api.issue_text());
+        assert_eq!(api.add_stop(id, e), 0, "{}", api.issue_text());
+        let net = &api.world_mut().net;
+        assert_eq!(net.line_stops(id), &[p, e, q]);
+        assert_eq!(net.line_picks(id), &[(e, w)], "the click picked W for the other way");
+        api.world_mut().reload();
+        let ls = &api.world_mut().svc.lines[id as usize];
+        assert!(ls.ok && ls.runs.iter().all(|r| !r.pass.contains(&true)), "nobody passes");
+        let at: Vec<u32> = ls.runs.iter().map(|r| r.nodes[r.stop_idx[1] as usize]).collect();
+        assert!(at.contains(&e) && at.contains(&w), "each run at its own platform: {at:?}");
+        out.push(api.into_world());
+    }
+    let cut = out.pop().unwrap();
+    let split = out.pop().unwrap();
+    agree("one-track pair runs", &run_figures(&split), &run_figures(&cut), 1e-12);
+    agree("one-track pair capacity", &cap_figures(&split), &cap_figures(&cut), 1e-12);
+}
