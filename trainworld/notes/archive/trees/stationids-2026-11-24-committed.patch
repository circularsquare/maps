+/// 4a2's one-track pair (perdir_tests' `t3348_one_track_pair_on_double_stops_both_ways`) as twins: P - Q double, 4 km,
+/// with E at 1500 m serving one track and W at 1650 m the other, split stations or anchors. Returns the twins and
+/// [P, Q, E, W].
+fn one_track_pair() -> (TrackWorld, TrackWorld, [u32; 4]) {
+    let make = || {
+        let mut w = world();
+        let p = node(&mut w, 0.0, 0.0, 0);
+        let q = node(&mut w, 4000.0, 0.0, 0);
+        edge(&mut w, p, q, &[], 0).unwrap();
+        for n in [p, q] {
+            station(&mut w, n, 200);
+        }
+        super::super::super::tests::terminals_at_dead_ends(&mut w);
+        (w, p, q)
+    };
+    let (mut split, p, q) = make();
+    let mut nds = vec![];
+    let mut ms = vec![];
+    let mut cut_piece = 0;
+    for (k, s) in [(0, 1500.0), (1, 150.0)] {
+        let e = if k == 0 { 0 } else { cut_piece };
+        let (nd, _, _) = split.net.split_plan(e, s).unwrap();
+        let (m, new_edge) = (split.net.alloc_node(), split.net.alloc_edge());
+        split.apply(Op::Split { edge: e, s, node: m, new_edge }).unwrap();
+        cut_piece = new_edge;
+        let mut d = split.net.station_data(p).unwrap();
+        d.upgrades = 0;
+        d.one = 1 + k as u8;
+        d.platform = 100;
+        d.name = format!("S{m}");
+        split.apply(Op::Station { node: m, data: Some(d) }).unwrap();
+        nds.push(nd);
+        ms.push(m);
+    }
+    split.reload();
+    // the track each split station's platform serves, by its key (the halves keep the piece's records)
+    let key_of = |m: u32| -> u8 {
+        let net = &split.net;
+        for c in net.node_ports[m as usize].ends().to_vec() {
+            for t in net.piece_tracks(c >> 1) {
+                for dir in 0..2 {
+                    let x = net.track_entry(t, dir);
+                    if net.track_of(x) == Some(t) && net.path_nodes(x).1 == m && net.arrive_side(x).and_then(|side| net.stop_point(m, side, t)).is_some() {
+                        return net.track(t).key;
+                    }
+                }
+            }
+        }
+        panic!("no platform track at {m}")
+    };
+    let keys = [key_of(ms[0]), key_of(ms[1])];
+    assert_ne!(keys[0], keys[1]);
+    let (mut cut, _, _) = make();
+    for k in 0..2 {
+        assert_eq!(cut.net.alloc_node(), ms[k]);
+        cut.apply(Op::Node { id: ms[k], data: Some(nds[k].clone()) }).unwrap();
+        let at = cut.net.project(0, nds[k].x, nds[k].y).0;
+        anchor(&mut cut, ms[k], 0, at, &keys[k..k + 1], 100).unwrap();
+    }
+    cut.reload();
+    (split, cut, [p, q, ms[0], ms[1]])
+}
