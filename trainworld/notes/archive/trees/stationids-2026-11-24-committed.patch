+//! T-4036 (track rework stage f): routing to stop points. A line routed to an anchor (a station off the track, where
+//! the compile cuts its piece's tracks) by the game's own entry points (a new line, a stop click, a reroute after an
+//! edit) gets the stops, path and figures of the same line at the same station splitting the piece at a node.
+
+use super::super::super::capacity::ResKind;
+use super::super::super::net::{app_entry, app_path, path_edge};
+use super::super::super::wasm::TrackApi;
+use super::super::super::world::Op;
+use super::*;
+
+/// A world as the app's API, money no object.
+fn api_of(w: TrackWorld) -> TrackApi {
+    TrackApi::of_world(w)
+}
+
+/// The fixture's nodes by where they are: B0, A, C, D.
+fn at(w: &TrackWorld, x: f64, y: f64) -> u32 {
+    let n = &w.net;
+    (0..n.node_count() as u32).filter(|&k| n.node_ok(k) && n.node_ports[k as usize].n > 0).min_by(|&p, &q| {
+        let d = |k: u32| (n.node_x[k as usize] - x).hypot(n.node_y[k as usize] - y);
+        d(p).total_cmp(&d(q))
+    }).unwrap()
+}
+
+/// Line `l`'s path in the anchor twin's piece ids: the split twin's second half (`second`) is the whole piece `e`, and
+/// pieces made after the split take one id less; the halves' two entries are one.
+fn mapped(w: &TrackWorld, l: u32, e: u32, second: Option<u32>) -> Vec<u32> {
+    let mut out: Vec<u32> = vec![];
+    for &p in w.net.line_path(l) {
+        let (piece, dir) = (path_edge(p), app_entry(p) & 1);
+        let piece = match second {
+            Some(s) if piece == s => e,
+            Some(s) if piece > s => piece - 1,
+            _ => piece,
+        };
+        let x = piece << 1 | dir;
+        if out.last() != Some(&x) {
+            out.push(x);
+        }
+    }
+    out
+}
+
+/// The twins agree: every line's stops, its path in piece terms, its runs' figures and every capacity resource.
+fn same(what: &str, split: &TrackWorld, cut: &TrackWorld, e: u32, m: u32, rel: f64) {
+    // the split's second half: the piece from its station node
+    let s = (0..split.net.edge_count() as u32).find(|&k| split.net.edge_ok(k) && split.net.edge_a[k as usize] == m);
+    assert!(s.is_some(), "{what}");
+    assert_eq!(split.net.line_count(), cut.net.line_count(), "{what}");
+    for l in 0..split.net.line_count() as u32 {
+        assert_eq!(split.net.line_stops(l), cut.net.line_stops(l), "{what}: line {l}'s stops");
+        assert_eq!(mapped(split, l, e, s), mapped(cut, l, e, None), "{what}: line {l}'s path");
+        assert_eq!(split.net.line_broken[l as usize], cut.net.line_broken[l as usize], "{what}: line {l}");
+    }
+    agree(&format!("runs, {what}"), &run_figures(split), &run_figures(cut), rel);
+    agree(&format!("capacity, {what}"), &cap_figures(split), &cap_figures(cut), rel);
+}
+
+/// The resources of kind `k` standing at node `m`.
+fn at_node(w: &TrackWorld, k: ResKind, m: u32) -> usize {
+    w.svc.cap.res.iter().filter(|r| r.kind == k && r.node == m).count()
+}
