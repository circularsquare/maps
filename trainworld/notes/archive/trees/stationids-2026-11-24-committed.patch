+//! T-4032: a track cut inside its piece (a derived node with no ports) runs as the same piece split at a node: run
+//! times, stops, line figures and every capacity resource agree; an edit of the cut piece and its undo keep every
+//! derived id and figure; extra ids never meet a track id.
+
+use super::super::capacity::Resource;
+use super::super::params::SLOTS;
+use super::super::tests::{edge, line, node, station, world};
+use super::super::world::{Op, TrackWorld};
+use super::*;
+
+/// B0 - A - C - D, A to C with a piece speed limit, curved over its middle (`curved`) or straight, single track
+/// (`single`) or double; a line X1 - X2 crossing A to C flat past the middle; line 1 B0 to D passing A, line 2 B0 to D
+/// stopping at A and C (the slower, followed on the shared track), line 3 X1 to X2. Returns the world, the A to C
+/// piece and its middle.
+fn fixture(single: bool, curved: bool) -> (TrackWorld, u32, f64) {
+    let mut w = world();
+    let b0 = node(&mut w, -3000.0, 0.0, 0);
+    let a = node(&mut w, 0.0, 0.0, 0);
+    let c = node(&mut w, 6000.0, 0.0, 0);
+    let d = node(&mut w, 9000.0, 0.0, 0);
+    let x1 = node(&mut w, 4600.0, -2500.0, 0);
+    let x2 = node(&mut w, 4600.0, 2500.0, 0);
+    edge(&mut w, b0, a, &[], 0).unwrap();
+    let ac = edge(&mut w, a, c, if curved { &[(2000.0, 0.0), (3000.0, 1000.0), (4000.0, 0.0)] } else { &[] }, 0).unwrap();
+    edge(&mut w, c, d, &[], 0).unwrap();
+    edge(&mut w, x1, x2, &[], 0).unwrap();
+    let mut data = w.net.edge_data(ac).unwrap();
+    data.limit = 150;
+    if single {
+        data.tracks = super::super::tracks::Tracks::new(1);
+    }
+    w.apply(Op::Edge { id: ac, data: Some(data) }).unwrap();
+    for n in [b0, a, c, d, x1, x2] {
+        station(&mut w, n, 200);
+    }
+    line(&mut w, &[b0, d], [12.0, 8.0, 4.0]);
+    line(&mut w, &[b0, a, c, d], [8.0, 6.0, 4.0]);
+    line(&mut w, &[x1, x2], [10.0, 6.0, 4.0]);
+    let s = w.net.edge_len[ac as usize] / 2.0;
+    (w, ac, s)
+}
+
+/// T-4035: an anchor at node `m` (no ports): a station whose platforms, `len` m, lie on piece `e`'s tracks of `keys`
+/// (at most two) with their middle at chainage `mid`.
+pub(crate) fn anchor(w: &mut TrackWorld, m: u32, e: u32, mid: f64, keys: &[u8], len: u16) -> Result<(), String> {
+    use crate::track::net::{PlatformAt, StationData};
+    let mut at = [None; 2];
+    for (k, &key) in keys.iter().enumerate() {
+        at[k] = Some(PlatformAt::On { piece: e, key, mid });
+    }
+    let one = if keys.len() == 1 { 1 } else { 0 };
+    let data = StationData { platform: len, name: format!("S{m}"), named: false, built: true, off: false, upgrades: 0, berth: None, day: 0, one, fare: 0, own: String::new(), road: None, at };
+    w.apply(Op::Station { node: m, data: Some(data) }).map(|_| ()).map_err(|e| format!("{e:?}"))
+}
+
+/// The twins: the piece split at a node (`Op::Split`) with a station there, and the piece whole with an anchor station
+/// there (a node of its own with no ports) whose platforms are on every track, the compile cutting them at it.
+fn twins(single: bool, curved: bool) -> (TrackWorld, TrackWorld, u32, u32) {
+    let (mut split, e, s) = fixture(single, curved);
+    let (nd, _, _) = split.net.split_plan(e, s).unwrap();
+    let (node_id, new_edge) = (split.net.alloc_node(), split.net.alloc_edge());
+    split.apply(Op::Split { edge: e, s, node: node_id, new_edge }).unwrap();
+    // on single track one platform, a stop where trains cannot pass, as an anchor's one track has
+    // (in one edit: lines are timetabled against each other from the phases they had)
+    let one = if single { 1 } else { 0 };
+    let data = crate::track::net::StationData { platform: 200, name: format!("S{node_id}"), named: false, built: true, off: false, upgrades: 0, berth: None, day: 0, one, fare: 0, own: String::new(), road: None, at: [None; 2] };
+    split.apply(Op::Station { node: node_id, data: Some(data) }).unwrap();
+    split.reload();
+    let (mut cut, e2, s2) = fixture(single, curved);
+    assert_eq!((e2, s2), (e, s));
+    let m = cut.net.alloc_node();
+    assert_eq!(m, node_id);
+    cut.apply(Op::Node { id: m, data: Some(nd.clone()) }).unwrap();
+    // the platforms' middle where the split put its node (a split snaps to a piece end within 2 m)
+    let at = cut.net.project(e, nd.x, nd.y).0;
+    let keys: Vec<u8> = cut.net.edge_recs[e as usize].recs().iter().map(|r| r.key).collect();
+    anchor(&mut cut, m, e, at, &keys, 200).unwrap();
+    cut.reload();
+    (split, cut, e, m)
+}
+
+/// A figure's label and its numbers.
+type Fig = (String, Vec<f64>);
+
+/// Every line's run times and figures.
+fn run_figures(w: &TrackWorld) -> Vec<Fig> {
+    let mut out = vec![];
+    for (l, ls) in w.svc.lines.iter().enumerate() {
+        out.push((format!("line {l} ok {} trains {:?}", ls.ok, ls.trains), ls.round_trip.iter().chain(&ls.delay).copied().collect()));
+        for (k, run) in ls.runs.iter().enumerate() {
+            let mut v = vec![run.len, run.free.duration];
+            v.extend(&run.stop_s);
+            v.extend(run.limits.iter().flatten());
+            out.push((format!("  run {k} stops {} limits {}", run.stop_s.len(), run.limits.len()), v));
+            for lev in 0..SLOTS {
+                let p = &run.prof[lev];
+                let v = [p.duration].iter().chain(&p.arr).chain(&p.dep).chain(&run.stop_holds[lev]).copied().collect();
+                out.push((format!("    {lev} stops {} {}", p.arr.len(), run.stop_holds[lev].len()), v));
+            }
+        }
+    }
+    out
+}
+
+/// Every capacity resource, by what it is and where (to 10 cm), without the ids of pieces a split renumbers, sorted.
+fn cap_figures(w: &TrackWorld) -> Vec<Fig> {
+    let mut out: Vec<Fig> = w
+        .svc
+        .cap
+        .canonical()
+        .into_iter()
+        .map(|(res, us, rho, delay): (Resource, _, _, _)| {
+            let who: Vec<_> = us.iter().map(|u| (u.line, u.run, u.owner, u.stop)).collect();
+            let label = format!("{:?} node {} at {:.1},{:.1} users {who:?}", res.kind, res.node, res.x, res.y);
+            (label, [res.x, res.y].iter().chain(&rho).chain(&delay).copied().chain(us.iter().flat_map(|u| [u.occ, u.at])).collect())
+        })
+        .collect();
+    out.sort_by(|a, b| a.0.cmp(&b.0));
+    out
+}
+
+/// The two lists of figures agree: the same labels, every number within `rel` of its size (at least 1).
+fn agree(what: &str, a: &[Fig], b: &[Fig], rel: f64) {
+    assert_eq!(a.len(), b.len(), "{what}: {a:?}\n{b:?}");
+    for (x, y) in a.iter().zip(b) {
+        assert_eq!(x.0, y.0, "{what}");
+        assert_eq!(x.1.len(), y.1.len(), "{what}: {}", x.0);
+        assert!(x.1.iter().zip(&y.1).all(|(p, q)| (p - q).abs() <= rel * p.abs().max(1.0)), "{what}: {}\n{:?}\n{:?}", x.0, x.1, y.1);
+    }
+}
