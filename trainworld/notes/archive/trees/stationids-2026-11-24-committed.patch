@@ -0,0 +1,122 @@
+//! The stations demand's snapshot is made of (T-3962, notes/T-3444-design/06-demand.md section 2): one row per stop
+//! node of a constructed station, with its complex from the one rule (`Network::complexes`).
+
+use super::*;
+use crate::track::building;
+use crate::track::complexes::Complexes;
+
+/// Numbers per row of `demand_stations`.
+pub const DEMAND_ROW: usize = 7;
+/// A row's flag: the stop node's platform touches a station building (a change there is quicker, T-2220).
+pub const ROW_IN_BUILDING: u32 = 1;
+
+impl Network {
+    /// The stop nodes demand's snapshot rows are, in id order, and their complexes. While stations are nodes
+    /// (T-3959) a stop node is its station's node and its id the station's; its point is the node.
+    pub fn demand_rows(&self) -> (Complexes, Vec<u32>) {
+        let cx = self.complexes(|m| self.station_built(m));
+        let mut flags = vec![0u32; cx.stations.len()];
+        for b in self.buildings.iter().flatten() {
+            for m in building::members(self, &b.corners) {
+                if let Ok(j) = cx.stations.binary_search(&m) {
+                    flags[j] |= ROW_IN_BUILDING;
+                }
+            }
+        }
+        (cx, flags)
+    }
+}
+
+#[wasm_bindgen]
+impl TrackApi {
+    /// Demand's station rows, `DEMAND_ROW` numbers each: id, x, y, level, platform length (m), complex (numbered by
+    /// its first row), flags (`ROW_IN_BUILDING`).
+    pub fn demand_stations(&self) -> Vec<f64> {
+        let n = &self.w.net;
+        let (cx, flags) = n.demand_rows();
+        let mut out = Vec::with_capacity(DEMAND_ROW * cx.stations.len());
+        for (j, &s) in cx.stations.iter().enumerate() {
+            let i = s as usize;
+            out.extend([s as f64, n.node_x[i], n.node_y[i], n.node_level[i] as f64, n.platform_len(s) as f64, cx.of[j] as f64, flags[j] as f64]);
+        }
+        out
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn route(a: &mut TrackApi, y: f64) {
+        let ends = [0.0, 0.0, 0.0, y, 0.0, 0.0, 0.0, 2000.0, y, 0.0];
+        assert_eq!(a.add_route(&ends, &[], 2, false), 0, "{}", a.issues());
+    }
+    fn station(a: &mut TrackApi, x: f64, y: f64) -> u32 {
+        let n = &a.w.net;
+        let e = (0..n.edge_count() as u32).filter(|&e| n.edge_ok(e)).min_by(|&p, &q| n.project(p, x, y).1.total_cmp(&n.project(q, x, y).1)).unwrap();
+        assert_eq!(a.add_station(2, e, x, y, 200, "s".into()), 0, "{}", a.issues());
+        let n = &a.w.net;
+        (0..n.node_count() as u32).filter(|&k| n.is_station(k)).min_by(|&p, &q| {
+            let d = |k: u32| (n.node_x[k as usize] - x).hypot(n.node_y[k as usize] - y);
+            d(p).total_cmp(&d(q))
+        }).unwrap()
+    }
+
+    /// T-3962: the partition demand reads and `complex_of` agree, by distance, by a link and by a building; a
+    /// blueprint station joins nothing in demand's.
+    #[test]
+    fn t3962_partition_by_distance_link_and_building() {
+        let mut a = TrackApi::new(-73.985, 40.758, true);
+        a.set_cash(1e9);
+        for y in [0.0, 400.0, 800.0, 1600.0] {
+            route(&mut a, y);
+        }
+        let s1 = station(&mut a, 500.0, 0.0);
+        let s2 = station(&mut a, 730.0, 0.0);
+        let s3 = station(&mut a, 500.0, 400.0);
+        let s4 = station(&mut a, 500.0, 800.0);
+        let s5 = station(&mut a, 500.0, 1600.0);
+        assert_eq!(a.construct_all(), 0, "{}", a.issues());
+        let s6 = station(&mut a, 950.0, 0.0);
+        assert_eq!(a.link_stations(s1, s3), 0, "{}", a.issues());
+        assert_eq!(a.add_building(&[350.0, 780.0, 650.0, 780.0, 650.0, 1620.0, 350.0, 1620.0], String::new()), 0, "{}", a.issues());
+        let net = &a.w.net;
+        let all = net.complexes(|_| true);
+        let of = |cx: &Complexes, s: u32| cx.of[cx.stations.binary_search(&s).unwrap()];
+        assert_eq!(all.of, vec![0, 0, 0, 1, 1, 0], "s1 s2 s3 s6 one, s4 s5 one: {:?}", all.stations);
+        for &s in &all.stations {
+            let mut want: Vec<u32> = all.stations.iter().copied().filter(|&m| of(&all, m) == of(&all, s)).collect();
+            let mut got = net.complex_of(s);
+            assert_eq!(got[0], s);
+            (want.sort(), got.sort());
+            assert_eq!(got, want, "complex_of({s})");
+        }
+        let built = net.complexes(|m| net.station_built(m));
+        assert!(!built.stations.contains(&s6));
+        assert_eq!(built.of, vec![0, 0, 0, 1, 1]);
+        let (rows, flags) = net.demand_rows();
+        assert_eq!(rows.stations, vec![s1, s2, s3, s4, s5]);
+        assert_eq!(flags, vec![0, 0, 0, 1, 1], "s4 and s5 touch the building");
+        let flat = a.demand_stations();
+        assert_eq!(flat.len(), 5 * DEMAND_ROW);
+        assert_eq!(flat[0], s1 as f64);
+    }
+}
+
+/// T-3962: how long demand's rows take on a real network: `TW_NET=<network bytes> cargo test t3962_rows_time -- --ignored`.
+#[cfg(test)]
+#[test]
+#[ignore]
+fn t3962_rows_time() {
+    let bytes = std::fs::read(std::env::var("TW_NET").unwrap()).unwrap();
+    let mut a = TrackApi::new(0.0, 0.0, true);
+    assert!(a.load(&bytes));
+    let t = std::time::Instant::now();
+    let rows = a.demand_stations();
+    let first = t.elapsed().as_secs_f64() * 1e3;
+    let t = std::time::Instant::now();
+    for _ in 0..10 {
+        assert_eq!(a.demand_stations(), rows);
+    }
+    eprintln!("{} rows, {first:.1} ms first, {:.2} ms each after", rows.len() / DEMAND_ROW, t.elapsed().as_secs_f64() * 1e2);
+}
