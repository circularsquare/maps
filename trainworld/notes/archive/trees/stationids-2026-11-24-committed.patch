+/// A piece a line ending at the station runs over is deleted where track goes round: the line is routed again.
+#[test]
+fn t4036_rerouted_to_anchor_as_split() {
+    for (single, curved) in COMBOS {
+        let what = format!("single {single} curved {curved}");
+        let (split, cut, e, m) = twins(single, curved);
+        let mut out = vec![];
+        for w in [split, cut] {
+            let (c, d) = (at(&w, 6000.0, 0.0), at(&w, 9000.0, 0.0));
+            let mut api = api_of(w);
+            let id = api.world_mut().net.alloc_line();
+            assert_eq!(api.set_line_with_trains(id, &[d, m], 4, 2, 1, 30.0, 180.0, 0, 0, format!("T{id}")), 0, "{what}: {}", api.issue_text());
+            let w = api.world_mut();
+            let cd = (0..w.net.edge_count() as u32).find(|&k| w.net.edge_ok(k) && w.net.edge_a[k as usize] == c && w.net.edge_b[k as usize] == d).unwrap();
+            // C to D split at P and Q (stations take no junction), and a way round P to Q by E
+            let split_at = |w: &mut TrackWorld, e: u32, s: f64| {
+                let (node, new_edge) = (w.net.alloc_node(), w.net.alloc_edge());
+                w.apply(Op::Split { edge: e, s, node, new_edge }).unwrap();
+                (node, new_edge)
+            };
+            let (p, pd) = split_at(w, cd, 500.0);
+            let (q, _) = split_at(w, pd, 2000.0);
+            edge(w, p, q, &[(6900.0, 0.0), (7500.0, 600.0), (8100.0, 0.0)], 0).unwrap();
+            let before = w.net.line_path(id).to_vec();
+            assert!(before.iter().any(|&e| path_edge(e) == pd), "{what}");
+            // (the deletion's own reroute leaves these lines broken, on both twins alike, so they are routed again by
+            // their stops, as the stop list does: the reroute tested is that one)
+            assert_eq!(api.delete_edge(pd), 0, "{what}: {}", api.issue_text());
+            let broken: Vec<u32> = (0..api.world_mut().net.line_count() as u32).filter(|&l| api.world_mut().net.line_broken[l as usize]).collect();
+            assert!(broken.contains(&id), "{what}");
+            for l in broken {
+                let stops = api.world_mut().net.line_stops(l).to_vec();
+                assert_eq!(api.set_stops(l, &stops), 0, "{what}: line {l}: {}", api.issue_text());
+                assert!(!api.world_mut().net.line_broken[l as usize], "{what}: line {l} rerouted");
+            }
+            let w = api.world_mut();
+            assert!(w.net.line_path(id).iter().all(|&e| path_edge(e) != pd) && w.net.line_path(id).len() == before.len(), "{what}: {:?}", app_path(w.net.line_path(id)));
+            w.reload();
+            out.push(api.into_world());
+        }
+        let cut = out.pop().unwrap();
+        let split = out.pop().unwrap();
+        same(&what, &split, &cut, e, m, if curved { 2e-5 } else { 1e-12 });
+    }
+}
