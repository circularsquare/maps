+/// T-3961: her split (perdir_tests' `t3348_split_legs_stop_each_way_on_its_own_leg`: a double splits into two one-way
+/// singles about 150 m apart and rejoins) with its leg stations split into the legs, or as anchors on them (as the
+/// converter makes them from an old save). Returns the API, the ends P and Q, and the legs' stations N and S.
+fn split_legs(right_hand: bool, anchors: bool) -> (TrackApi, u32, u32, u32, u32) {
+    use super::super::super::net::{NodeData, PlatformAt};
+    let mut a = TrackApi::new(-73.985, 40.758, right_hand);
+    a.set_cash(1e9);
+    let free = |x: f64, y: f64| [0.0, 0.0, x, y, 0.0];
+    let ends = |p: [f64; 5], q: [f64; 5]| -> Vec<f64> { p.iter().chain(q.iter()).copied().collect() };
+    let near = |a: &TrackApi, x: f64, y: f64| {
+        let n = &a.world().net;
+        let d = |k: u32| (n.node_x[k as usize] - x).hypot(n.node_y[k as usize] - y);
+        (0..n.node_count() as u32).filter(|&k| n.node_ok(k) && n.node_ports[k as usize].n > 0).min_by(|&p, &q| d(p).total_cmp(&d(q))).unwrap()
+    };
+    let at_node = |a: &TrackApi, n: u32| [1.0, n as f64, a.world().net.node_x[n as usize], a.world().net.node_y[n as usize], 0.0];
+    assert_eq!(a.add_route(&ends(free(0.0, 0.0), free(2000.0, 0.0)), &[], 2, false), 0, "{}", a.issue_text());
+    assert_eq!(a.add_route(&ends(free(4000.0, 0.0), free(6000.0, 0.0)), &[], 2, false), 0, "{}", a.issue_text());
+    let (j0, j1) = (near(&a, 2000.0, 0.0), near(&a, 4000.0, 0.0));
+    for y in [75.0, -75.0] {
+        assert_eq!(a.add_route(&ends(at_node(&a, j0), at_node(&a, j1)), &[3000.0, y, 0.0, 0.0], 1, false), 0, "{}", a.issue_text());
+    }
+    // the legs run opposite ways, both set (a way only inferred stops at a station, `derive_ways`)
+    let net = &a.world().net;
+    let legs: Vec<u32> = (0..net.edge_count() as u32).filter(|&e| net.edge_ok(e) && net.edge_tracks[e as usize] == 1).collect();
+    let east = |net: &crate::track::net::Network, e: u32, w: u8| (net.node_x[net.edge_a[e as usize] as usize] < net.node_x[net.edge_b[e as usize] as usize]) == (w == 1);
+    let k = (0..2).find(|&k| net.edge_way(legs[k]) == 0).unwrap_or(0);
+    let o = legs[1 - k];
+    let ow = net.edge_way(o);
+    let want_east = !east(net, o, ow);
+    let w = if east(net, legs[k], 1) == want_east { 1 } else { 2 };
+    assert_eq!(a.set_edge_oneway(legs[k], w), 0, "{}", a.issue_text());
+    assert_eq!(a.set_edge_oneway(o, ow), 0, "{}", a.issue_text());
+    let (p, q) = (near(&a, 0.0, 0.0), near(&a, 6000.0, 0.0));
+    for n in [p, q] {
+        let (x, y) = (a.world().net.node_x[n as usize], a.world().net.node_y[n as usize]);
+        assert_eq!(a.add_station(1, n, x, y, 200, "T".into()), 0, "{}", a.issue_text());
+    }
+    let mut st = vec![];
+    for y in [75.0, -75.0] {
+        let net = &a.world().net;
+        let e = (0..net.edge_count() as u32).filter(|&e| net.edge_ok(e) && net.edge_tracks[e as usize] == 1).min_by(|&p, &q| net.project(p, 3000.0, y).1.total_cmp(&net.project(q, 3000.0, y).1)).unwrap();
+        let s = net.project(e, 3000.0, y).0;
+        let (x, yy, _) = crate::track::geom::pos_at(net.edge_pieces(e), s);
+        if !anchors {
+            assert_eq!(a.add_station(2, e, x, yy, 120, "S".into()), 0, "{}", a.issue_text());
+            st.push(near(&a, x, yy));
+            continue;
+        }
+        let key = net.edge_recs[e as usize].recs()[0].key;
+        let level = net.node_level[net.edge_a[e as usize] as usize];
+        let mut d = net.station_data(p).unwrap();
+        let m = a.new_node_id();
+        (d.platform, d.name, d.one, d.upgrades, d.at) = (120, "S".into(), 1, 0, [Some(PlatformAt::On { piece: e, key, mid: s }), None]);
+        let op = Op::Batch(vec![Op::Node { id: m, data: Some(NodeData { x, y: yy, level, flying: false }) }, Op::Station { node: m, data: Some(d) }]);
+        assert_eq!(a.run_op(op), 0, "{}", a.issue_text());
+        st.push(m);
+    }
+    (a, p, q, st[0], st[1])
+}
