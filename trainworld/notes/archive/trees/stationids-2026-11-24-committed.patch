+/// The loop tools and related lines at an anchor: a line ending at the station is turned round the loop past it
+/// (`turn_end`: `turn_last`, `every_pass`), and the lines related to a line stopping there see the other line's stop
+/// there, as at the split station.
+#[test]
+fn t4036_loop_tools_and_related_at_anchor_as_split() {
+    let (split, cut, m) = twins_of(barbell, 1, 2000.0);
+    let mut out = vec![];
+    let mut related = vec![];
+    for w in [split, cut] {
+        let (a0, b) = (at(&w, -4000.0, 0.0), at(&w, -2000.0, 0.0));
+        let mut api = api_of(w);
+        let id = api.world_mut().net.alloc_line();
+        assert_eq!(api.set_line_with_trains(id, &[a0, b, m], 4, 2, 1, 30.0, 180.0, 0, 0, "L".into()), 0, "{}", api.issue_text());
+        // the end turned round the loop past it: out over the stem, round, and back to A0
+        assert_eq!(api.turn_end(id, m), 0, "{}", api.issue_text());
+        let stops = api.world_mut().net.line_stops(id).to_vec();
+        assert_eq!(stops.first(), stops.last());
+        assert!(stops.len() >= 5 && stops.contains(&m), "{stops:?}");
+        let other = api.world_mut().net.alloc_line();
+        assert_eq!(api.set_line_with_trains(other, &[b, m], 4, 2, 1, 30.0, 180.0, 0, 0, "O".into()), 0, "{}", api.issue_text());
+        api.world_mut().reload();
+        let n = api.world_mut().net.node_count();
+        let cx: Vec<u32> = (0..n as u32).map(|k| if api.world_mut().net.is_station(k) { k } else { u32::MAX }).collect();
+        related.push(api.line_related(id, &cx));
+        out.push(api.into_world());
+    }
+    let cut = out.pop().unwrap();
+    let split = out.pop().unwrap();
+    same("barbell", &split, &cut, 1, m, 1e-9);
+    // the other line's stop at the station is marked on both (its stop index, not -1, in each meeting)
+    assert!(!related[1].is_empty());
+    assert_eq!(related[0].len(), related[1].len(), "{:?}\n{:?}", related[0], related[1]);
+    assert!(related[0].iter().zip(&related[1]).all(|(a, b)| (a.is_nan() && b.is_nan()) || (a - b).abs() <= 1e-6 * a.abs().max(1.0)), "{:?}\n{:?}", related[0], related[1]);
+}
