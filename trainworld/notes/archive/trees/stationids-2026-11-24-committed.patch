diff --git a/trainworld/app/src/ui/inspector/PlatformPicture.tsx b/trainworld/app/src/ui/inspector/PlatformPicture.tsx
new file mode 100644
index 000000000..cdd19059d
--- /dev/null
+++ b/trainworld/app/src/ui/inspector/PlatformPicture.tsx
@@ -0,0 +1,144 @@
+// T-3964 (track rework stage 4e, notes/T-3444-design/03-tools.md "The station panel's platform picture"): the station
+// across its tracks, turned to run left to right with north up (west up on north-south track). Trains heading right
+// (east, or north) are red, the other way blue, both ways grey; each track's stopping lines at its right end. A
+// platform is a grey block, a place one could go a dashed box: a click adds or removes one. On quad the pair beside
+// shows too, with its twin station or the dashed boxes that place one.
+
+import { t } from "../../i18n";
+import { compass } from "../../game/oneTrack";
+import { money } from "../../game/format";
+import { platformRefusal, shownLine } from "../../game/issues";
+import { removeThing } from "../../game/remove";
+import { selection } from "../../game/ui";
+import type { LineInput, StationInput } from "../../game/types";
+import { edit, say, world } from "../../game/world";
+import type { EditOp } from "../../workers/protocol";
+import { useClockQuery } from "../useClockQuery";
+import { Chip } from "../widgets";
+
+interface Row { piece: number; key: number; way: 1 | 2 | 3; platform: number; x: number; y: number; lines: number[] }
+/** `station` -1: none yet (the pair beside); `kind` 0 a station by its node's axis, 3 by track (shown only), 1 or 2
+ * where a station would go (on node `id`, on piece `id`); `price` US$M a constructed station pays for its second
+ * platform */
+interface Group { station: number; kind: number; id: number; price: number; rows: Row[] }
+export interface Picture { right: number; groups: Group[] }
+
+function parse(d: Float64Array): Picture | null {
+  if (d.length < 2) return null;
+  const groups: Group[] = [];
+  let k = 2;
+  for (let g = 0; g < d[1]; g++) {
+    const group: Group = { station: d[k], kind: d[k + 1], id: d[k + 2], price: d[k + 3], rows: [] };
+    const n = d[k + 4];
+    k += 5;
+    for (let r = 0; r < n; r++) {
+      const nl = d[k + 7];
+      group.rows.push({ piece: d[k], key: d[k + 1], way: d[k + 2] as 1 | 2 | 3, platform: d[k + 3], x: d[k + 4], y: d[k + 5], lines: Array.from(d.subarray(k + 8, k + 8 + nl)) });
+      k += 8 + nl;
+    }
+    groups.push(group);
+  }
+  return { right: d[0], groups };
+}
+
+/** The picture of station `node`, asked again after each edit. */
+export function usePicture(node: number | null): Picture | null {
+  return useClockQuery(node === null ? null : { what: "stationPicture", node }, [node, world.value?.version], parse);
+}
+
+/** The stations a picture shows: the station and its twin on the pair beside. */
+export const pictureStations = (p: Picture) => p.groups.filter((g) => g.station >= 0).map((g) => String(g.station));
+
+/** Bullets a track shows before the "+". */
+const CHIPS = 4;
+
+/** One place for a platform: beside track `row` of `group`, a block (`on`) or a dashed box. */
+interface Slot { group: Group; row: Row; on: boolean }
+
+/** A platform change sent quietly, so a refusal can name the line that needs the platform. */
+async function change(op: EditOp): Promise<void> {
+  const a = await edit(op, true);
+  if (!a.ok && a.issues.length) say(platformRefusal(a.issues), true);
+}
+
+export function PlatformPicture({ s, p }: { s: StationInput; p: Picture }) {
+  const w = world.value;
+  if (!w) return null;
+  const headingOf = (way: 1 | 2) => p.right + (way === 2 ? Math.PI : 0);
+  const trackTip = (r: Row) => t("trackInspector.oneTrack", { bound: r.way === 3 ? "both" : compass(headingOf(r.way)) });
+  // a station on single track with its passing loop: two rows on its one track
+  const looped = (g: Group) => g.rows.length === 2 && g.rows[0].piece === g.rows[1].piece && g.rows[0].key === g.rows[1].key;
+  const platforms = (g: Group) => g.rows.filter((r) => r.platform >= 0).length;
+
+  const add = (sl: Slot) => {
+    const g = sl.group;
+    if (g.station >= 0) return void change({ op: "stationTracks", node: g.station, one: false });
+    // the pair beside: a station there with this one platform, named as this one
+    const one = { x: sl.row.x, y: sl.row.y };
+    void change({ op: "addStation", at: g.kind === 1 ? { kind: "node", node: g.id, one } : { kind: "edge", edge: g.id, x: sl.row.x, y: sl.row.y, one }, platform: s.length, name: "" });
+  };
+  const remove = (sl: Slot) => {
+    const g = sl.group;
+    if (platforms(g) > 1) {
+      if (looped(g)) return void change({ op: "stationTracks", node: g.station, one: true });
+      const keep = g.rows.find((r) => r !== sl.row && r.platform >= 0 && r.way !== 3);
+      return void change(keep ? { op: "stationWay", node: g.station, heading: headingOf(keep.way as 1 | 2) } : { op: "stationTracks", node: g.station, one: true });
+    }
