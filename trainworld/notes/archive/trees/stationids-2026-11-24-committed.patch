+/// A train's place across an edit is held in piece terms: a train running b to a on single track keeps it when the
+/// piece is doubled, though its entry is then on the piece's other track (T-206's trains in flight).
+#[test]
+fn t4032_place_kept_when_single_is_doubled() {
+    use super::super::service::{ground_at, offset_at};
+    let mut w = world();
+    let ns: Vec<u32> = (0..3).map(|i| node(&mut w, i as f64 * 3000.0, 0.0, 0)).collect();
+    let es: Vec<u32> = (0..2).map(|i| edge(&mut w, ns[i], ns[i + 1], &[], 0).unwrap()).collect();
+    for &e in &es {
+        let mut d = w.net.edge_data(e).unwrap();
+        d.tracks = super::super::tracks::Tracks::new(1);
+        w.apply(Op::Edge { id: e, data: Some(d) }).unwrap();
+    }
+    for &n in &ns {
+        station(&mut w, n, 200);
+    }
+    let l = line(&mut w, &ns, [6.0, 4.0, 2.0]);
+    let back = &w.svc.lines[l as usize].runs[1];
+    let s = back.len * 0.75;
+    let at = ground_at(&w.net, back, s).unwrap();
+    let old = back.segs.clone();
+    let mut d = w.net.edge_data(es[0]).unwrap();
+    d.tracks = super::super::tracks::Tracks::new(2);
+    w.apply(Op::Edge { id: es[0], data: Some(d) }).unwrap();
+    let back = &w.svc.lines[l as usize].runs[1];
+    assert_ne!(back.segs, old, "the return run is on the doubled piece's other track now");
+    assert_eq!(offset_at(&w.net, back, at), Some(s));
+}
