+    /// 6 assignment, 7 searches again, 8 needs, 9 whole pass; counts: 10 full searches, 11 bounded,
+    /// 12 pops, 13 longer pairs far, 14 longer pairs near, 15 terms
+    pub(super) static T2621: std::cell::Cell<[f64; 24]> = const { std::cell::Cell::new([0.; 24]) };
+}
+pub(super) fn tadd(i: usize, t: std::time::Instant) {
+    let d = t.elapsed().as_secs_f64() * 1e3;
+    T2621.with(|c| {
+        let mut v = c.get();
+        v[i] += d;
+        c.set(v);
+    });
+}
+pub(super) fn cadd(i: usize, n: f64) {
+    T2621.with(|c| {
+        let mut v = c.get();
+        v[i] += n;
+        c.set(v);
+    });
+}
