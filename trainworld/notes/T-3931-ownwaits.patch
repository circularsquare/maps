+/// Line `l`'s `end_wait` for its variants now (`own_ends`), over the reference weekday: each timed
+/// train ready at the end of its run (`LineSvc::trip_len_var` without `end_wait`) after the
+/// departure the slot's train takes there misses it by some headways, and the most any train of a
+/// run and slot misses by is its `end_wait`. Only where that departure is in the same stretch of
+/// the day: at a stretch's end the fleet changes anyway, and trains leave service there.
+fn end_waits(net: &Network, svc: &Service, l: usize) -> [[f64; 2]; SLOTS] {
+    let mut out = [[0.0; 2]; SLOTS];
+    let ls = &svc.lines[l];
+    if !ls.running || ls.is_loop() || ls.one_way || ls.timed.is_none() || l >= net.line_count() {
+        return out;
+    }
+    let Some(lat) = svc.lattice(net, l).map(|x| weekday(&x)) else { return out };
+    if ls.timed != Some(lat.timing_key()) {
+        return out;
+    }
+    let stand = ls.close_stand(net, l as u32).min(TURN_MIN_S);
+    let day = |d: f64| ((d + lat.shift) / DAY).floor() as i64;
+    for r in 0..2 {
+        // the other run's departures, where this run's trains take their next (game time)
+        let mut next: Vec<Dep> = vec![];
+        lattice_deps_local(&lat, 1 - r, DAY_REF as f64 * DAY - 3.0 * 3600.0, (DAY_REF + 2) as f64 * DAY, &mut next);
+        next.iter_mut().for_each(|x| x.0 -= lat.shift);
+        for lev in net.slots().filter(|&lev| net.auto_at(l, lev).is_some_and(|a| a > 0) && !ls.runs[r].pattern[lev].is_empty()) {
+            let mean = ls.trip_len(net, l as u32, r, lev);
+            for (d, hw, place) in day_deps(&lat, r, lev) {
+                let v = ls.runs[r].var_at(lev, place);
+                let ready = d + mean.max(ls.prof_of(r, lev, v).duration + stand);
+                let i = next.partition_point(|x| x.0 < d + mean - HANDOVER_TOL_S);
+                let Some(&(nd, nlev, _, nplace)) = next.get(i) else { continue };
+                if nlev as usize != lev || nplace == NO_PLACE || nplace >> 16 != place >> 16 || day(nd) != day(d) {
+                    continue;
+                }
+                if ready - nd > END_TOL_S {
+                    out[lev][r] = out[lev][r].max(((ready - nd - END_TOL_S) / hw).ceil() * hw);
+                }
+            }
+        }
+    }
+    out
+}
