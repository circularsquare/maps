+    tried = set()
+    while True:
+        find = _union(out_secs.keys())
+        deg = Counter()
+        for a, b in out_secs:
+            deg[a] += 1
+            deg[b] += 1
+        if len({find(n) for n in deg}) < 2:
+            break
+        ends = sorted(n for n in deg if deg[n] == 1 and pos_node(n) is not None)
+        cand = []
+        for i, a in enumerate(ends):
