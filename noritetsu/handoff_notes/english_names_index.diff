+/* ENGLISH NAMES FILLED AFTER THE BUILD (names_en.json, tools/english_names.py): OSM name:en
+   a station merge dropped, Wikidata English labels, "<station>線" from the station's English,
+   pinyin for Chinese and Revised Romanization for Korean. Only where the shipped file has no
+   English, keyed by the shipped ids (before LINE_FOLD), and before the search keys are made
+   so search finds them. `enFill` marks a filled name: English mode shows it like any other,
+   local mode still shows the local name first (stName, lineName), with this as the second. */
+function fillEnglish(lines, stations, ne) {
+  if (!ne) return;
+  for (const [id, e] of Object.entries(ne.st || {})) {
+    const st = stations[id];
+    if (st && !st.e) { st.e = e; st.enFill = 1; }
+  }
+  const ln = ne.ln || {};
+  for (const line of lines)
+    if (!line.name_en && ln[line.id]) { line.name_en = ln[line.id]; line.enFill = 1; }
 }
 
